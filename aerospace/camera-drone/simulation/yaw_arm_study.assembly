// The gimbal's yaw arm as yaw_arm_landing.fea sees it: the arm at its defaults (3.5 mm drop) and
// a stand-in for what it carries, the roll motor on the arm's seat and a block out to the
// payload's centre of mass. Exported to geometry/yaw_arm_study.step.
import { gimbal_yaw_arm } from "../mechanical/gimbal/gimbal_yaw_arm.part"
import { gimbal_payload } from "./gimbal_payload.part"

assembly yaw_arm_study {
    instance yaw_arm : gimbal_yaw_arm
    instance payload : gimbal_payload
}
