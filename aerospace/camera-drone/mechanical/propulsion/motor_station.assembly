// The motor station at an arm's tip: the pod's cowl, the motor's bell, the folding propeller's
// hub and its two blades on their pivots (`blade_a`, `blade_b` turn them about the pivots:
// 0 and 180 deg in flight, folded back along the arm when stowed). Its origin is the motor axis
// at the arm pad's top face.
import { motor_pod } from "./motor_pod.part"
import { motor } from "./motor.part"
import { prop_hub } from "./prop_hub.part"
import { prop_blade } from "./prop_blade.part"

assembly motor_station {
    input blade_a : angle = 0 deg
    input blade_b : angle = 180 deg
    input arm_roll : angle = 0 deg

    instance pod : motor_pod = {
        inputs = { arm_roll = input.arm_roll }
    }
    instance motor : motor
    instance hub : prop_hub
    instance blade_a : prop_blade = {
        placement = offset(
            translation = [0 mm, 9 mm, 18.6 mm],
            rotation = axis_angle(axis = [0, 0, 1], angle = input.blade_a + 90 deg),
        )
    }
    instance blade_b : prop_blade = {
        placement = offset(
            translation = [0 mm, -9 mm, 18.6 mm],
            rotation = axis_angle(axis = [0, 0, 1], angle = input.blade_b + 90 deg),
        )
    }
}
