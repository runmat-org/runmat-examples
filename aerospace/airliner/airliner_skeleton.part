// The airliner's skeleton: its main sizes and the frames its assemblies attach to.
part airliner_skeleton {
    input span : length = 34000 mm
    input root_chord : length = 6400 mm
    input tip_chord : length = 1550 mm
    input fuselage_radius : length = 1980 mm
    input frame_pitch : length = 500 mm
    input rib_pitch : length = 650 mm

    feature fuselage = frame.at(origin = point(0 mm, 0 mm, 0 mm), z = origin.z, x = origin.x)
    feature wing_root = frame.at(origin = point(12600 mm, 0 mm, -1250 mm), z = origin.z, x = origin.x)
    feature tail = frame.at(origin = point(29200 mm, 0 mm, 0 mm), z = origin.z, x = origin.x)
    feature main_gear_starboard = frame.at(origin = point(18300 mm, 3000 mm, -1150 mm), z = origin.z, x = origin.x)
    feature main_gear_port = frame.at(origin = point(18300 mm, -3000 mm, -1150 mm), z = origin.z, x = origin.x)
    feature nose_gear = frame.at(origin = point(4600 mm, 0 mm, -1700 mm), z = origin.z, x = origin.x)

    export fuselage = datum(datum = feature(feature = fuselage))
    export wing_root = datum(datum = feature(feature = wing_root))
    export tail = datum(datum = feature(feature = tail))
    export main_gear_starboard = datum(datum = feature(feature = main_gear_starboard))
    export main_gear_port = datum(datum = feature(feature = main_gear_port))
    export nose_gear = datum(datum = feature(feature = nose_gear))
    export span = value(input = span)
    export root_chord = value(input = root_chord)
    export tip_chord = value(input = tip_chord)
    export fuselage_radius = value(input = fuselage_radius)
    export frame_pitch = value(input = frame_pitch)
    export rib_pitch = value(input = rib_pitch)
}
