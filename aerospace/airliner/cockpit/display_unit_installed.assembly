runmat 0.7
std 1

// One display unit as installed: the screen and case, and the controller board on the case's
// bosses (as cockpit.assembly places it), for the display unit's assembly drawing.
assembly display_unit_installed {
    use part display_unit as display_unit
    use circuit du_controller from "../electrical/display_unit" as controller {
        placement = { placement = offset, offset = { translation = [-100 mm, 0 mm, 0 mm], rotation = { rotation = axis_angle, axis = [1, 1, 1], angle = 120 deg } } }
    }
}
