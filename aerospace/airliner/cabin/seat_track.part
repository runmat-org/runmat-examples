// A seat track along one barrel section, flush with the floor panels.
part seat_track {
    sketch s on origin.yz {
        l1 = line(start = [-14 mm, 0 mm], end = [14 mm, 0 mm])
        l2 = line(start = [14 mm, 0 mm], end = [14 mm, 16 mm])
        l3 = line(start = [14 mm, 16 mm], end = [-14 mm, 16 mm])
        l4 = line(start = [-14 mm, 16 mm], end = [-14 mm, 0 mm])
    }
    feature track = extrude(profile = sketch.s, distance = 8000 mm)

    output seat_track = { body = feature.track.body, part_number = "FUS-TR-420", material = "aluminum_7075", color = "#8C9299" }
}
