runmat 0.7
std 1

// A business seat's cushion and back, 500 mm wide, in leather.
part seat_cushion_business {
    sketch s on origin.zx {
        c1 = spline(points = [[409.451 mm, -222.005 mm], [418.133 mm, -242.912 mm], [437.657 mm, -254.367 mm]])
        c2 = line(start = c1.end, end = [477.343 mm, -260.633 mm])
        c3 = spline(points = [c2.end, [497.089 mm, -255.299 mm], [506.286 mm, -237.03 mm]])
        c4 = line(start = c3.end, end = [523.714 mm, 142.03 mm])
        c5 = spline(points = [c4.end, [532.899 mm, 162.998 mm], [552.614 mm, 174.63 mm]])
        c6 = line(start = c5.end, end = [1122.386 mm, 270.17 mm])
        c7 = spline(points = [c6.end, [1144.372 mm, 281.38 mm], [1158.854 mm, 301.363 mm]])
        c8 = line(start = c7.end, end = [1171.146 mm, 338.237 mm])
        c9 = spline(points = [c8.end, [1170.354 mm, 361.491 mm], [1156.703 mm, 380.332 mm]])
        c10 = line(start = c9.end, end = [1143.297 mm, 389.268 mm])
        c11 = spline(points = [c10.end, [1118.696 mm, 398.803 mm], [1092.357 mm, 400.343 mm]])
        c12 = line(start = c11.end, end = [497.643 mm, 304.457 mm])
        c13 = spline(points = [c12.end, [471 mm, 297.17 mm], [445.689 mm, 286.108 mm]])
        c14 = line(start = c13.end, end = [424.311 mm, 273.892 mm])
        c15 = spline(points = [c14.end, [407.458 mm, 255.769 mm], [400.549 mm, 232.005 mm]])
        c16 = line(start = c15.end, end = c1.start)
    }
    feature body = extrude(profile = sketch.s, distance = 500 mm, symmetric)

    output seat_cushion_business = { body = feature.body.body, part_number = "CAB-ST-220", material = "leather", color = "#5A2E3B" }
}
