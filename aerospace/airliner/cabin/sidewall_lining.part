// The sidewall lining over one frame bay: 45.3° of the cabin wall with the window's reveal.
part sidewall_lining {
    sketch s on origin.xy {
        l1 = line(start = [-248 mm, 1800 mm], end = [248 mm, 1800 mm])
        l2 = line(start = [248 mm, 1800 mm], end = [248 mm, 1808 mm])
        l3 = line(start = [248 mm, 1808 mm], end = [-248 mm, 1808 mm])
        l4 = line(start = [-248 mm, 1808 mm], end = [-248 mm, 1800 mm])
    }
    feature panel = revolve(profile = sketch.s, axis = origin.x, angle = 45.277215 deg)
    sketch r on origin.zx {
        c1 = spline(points = [[624.409 mm, -135 mm], [575.409 mm, -114 mm], [554.409 mm, -65 mm]])
        c2 = line(start = c1.end, end = [554.409 mm, 65 mm])
        c3 = spline(points = [c2.end, [575.409 mm, 114 mm], [624.409 mm, 135 mm]])
        c4 = line(start = c3.end, end = [761.294 mm, 135 mm])
        c5 = spline(points = [c4.end, [810.294 mm, 114 mm], [831.294 mm, 65 mm]])
        c6 = line(start = c5.end, end = [831.294 mm, -65 mm])
        c7 = spline(points = [c6.end, [810.294 mm, -114 mm], [761.294 mm, -135 mm]])
        c8 = line(start = c7.end, end = c1.start)
    }
    feature reveal = extrude(profile = sketch.r, distance = 1980 mm, mode = cut)

    output sidewall_lining = { body = feature.panel.body, part_number = "CAB-LN-500", material = "polycarbonate", color = "#ECEDEF" }
}
