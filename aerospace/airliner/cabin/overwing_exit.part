// A door, 510 mm wide and 920 mm tall: its outer skin, 6 mm proud of the fuselage; to starboard, or to port in the opposite hand.

import { aluminum_2024 } from "../materials.module"

part overwing_exit {
    input side : real = 1

    sketch s on origin.xy {
        l1 = line(start = [0 mm, 1986 mm], end = [510 mm, 1986 mm])
        l2 = line(start = [510 mm, 1986 mm], end = [510 mm, 1989 mm])
        l3 = line(start = [510 mm, 1989 mm], end = [0 mm, 1989 mm])
        l4 = line(start = [0 mm, 1989 mm], end = [0 mm, 1986 mm])
    }
    feature skin = revolve(profile = sketch.s, axis = origin.x, angle = 360 deg)
    feature side = plane.offset(base = origin.zx, distance = (input.side - 1) * 1090 mm)
    sketch o on plane.side {
        c1 = spline(points = [[120 mm, 0 mm], [36 mm, 36 mm], [0 mm, 120 mm]])
        c2 = line(start = c1.end, end = [0 mm, 390 mm])
        c3 = spline(points = [c2.end, [36 mm, 474 mm], [120 mm, 510 mm]])
        c4 = line(start = c3.end, end = [800 mm, 510 mm])
        c5 = spline(points = [c4.end, [884 mm, 474 mm], [920 mm, 390 mm]])
        c6 = line(start = c5.end, end = [920 mm, 120 mm])
        c7 = spline(points = [c6.end, [884 mm, 36 mm], [800 mm, 0 mm]])
        c8 = line(start = c7.end, end = c1.start)
    }
    feature cut = extrude(profile = sketch.o, distance = 2180 mm, mode = intersect)

    output overwing_exit = {
        body = feature.skin.body
        part_number = "FUS-DR-710"
        material = aluminum_2024
        color = "#EEF0F2"
    }
}
