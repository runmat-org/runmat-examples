runmat 0.7
std 1

// The empennage: fin and rudder, the starboard stabilizer and elevator and their mirror images to
// port, on the tail frame.
assembly empennage {
    use part fin as fin
    use part rudder as rudder
    use part stabilizer as stabilizer_starboard
    use part elevator as elevator_starboard

    mirror stabilizer_port = {
        seeds = [stabilizer_starboard],
        plane = { plane = explicit, point = [0 mm, 0 mm, 0 mm], normal = [0, 1, 0] },
        hand = opposite(source = { definition = { kind = part, name = stabilizer } }, configuration = { select = inputs, values = { side = -1 } }, point = [0 mm, 0 mm, 0 mm], normal = [0, 1, 0])
    }
    mirror elevator_port = {
        seeds = [elevator_starboard],
        plane = { plane = explicit, point = [0 mm, 0 mm, 0 mm], normal = [0, 1, 0] },
        hand = opposite(source = { definition = { kind = part, name = elevator } }, configuration = { select = inputs, values = { side = -1 } }, point = [0 mm, 0 mm, 0 mm], normal = [0, 1, 0])
    }
}
