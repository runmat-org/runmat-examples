import { du_controller } from "./du_controller.circuit"

layout du_controller {
    circuit = du_controller
    stackup rigid {
        finish = ENIG
        layer "F.Mask" = { kind = mask, thickness = 0.02 mm, material = solder_mask }
        layer "F.Cu" = { kind = copper, thickness = 0.03479 mm, weight = 1, material = copper }
        layer "dielectric 1" = { kind = prepreg, thickness = 0.48521 mm, material = { name = "FR-4 prepreg", dk = 4.1, df = 0.02, conductivity = 0, k_inplane = 0.8, k_through = 0.3, density = 1850, cp = 1100, cte_ppm = 14 } }
        layer "In1.Cu" = { kind = copper, thickness = 0.017395 mm, weight = 0.5, material = copper }
        layer "dielectric 2" = { kind = core, thickness = 0.48521 mm, material = fr4 }
        layer "In2.Cu" = { kind = copper, thickness = 0.017395 mm, weight = 0.5, material = copper }
        layer "dielectric 3" = { kind = prepreg, thickness = 0.48521 mm, material = { name = "FR-4 prepreg", dk = 4.1, df = 0.02, conductivity = 0, k_inplane = 0.8, k_through = 0.3, density = 1850, cp = 1100, cte_ppm = 14 } }
