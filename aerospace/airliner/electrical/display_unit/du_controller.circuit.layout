        layer "B.Mask" = { kind = mask, thickness = 0.02 mm, material = solder_mask }
    }
    outline = [[-60, -50], [60, -50], [60, 50], [-60, 50]] mm
    limits = { clearance = 0.1 mm, track = 0.1 mm, via_diameter = 0.45 mm, drill = 0.2 mm, annular = 0.1 mm, hole_to_hole = 0.25 mm, copper_to_edge = 0.4 mm, silk_to_pad = 0.1 mm, microvia_drill = 0.1 mm }
