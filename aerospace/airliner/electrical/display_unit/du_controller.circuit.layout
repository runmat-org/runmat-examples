use circuit du_controller

layout du_controller {
    stackup rigid {
        finish = ENIG
        layer "F.Mask" = { kind = mask, thickness = 0.02, material = solder_mask }
        layer "F.Cu" = { kind = copper, thickness = 0.03479, weight = 1, material = copper }
        layer "dielectric 1" = { kind = prepreg, thickness = 0.48521, material = { name = "FR-4 prepreg", dk = 4.1, df = 0.02, conductivity = 0, k_inplane = 0.8, k_through = 0.3, density = 1850, cp = 1100, cte_ppm = 14 } }
        layer "In1.Cu" = { kind = copper, thickness = 0.017395, weight = 0.5, material = copper }
        layer "dielectric 2" = { kind = core, thickness = 0.48521, material = fr4 }
        layer "In2.Cu" = { kind = copper, thickness = 0.017395, weight = 0.5, material = copper }
        layer "dielectric 3" = { kind = prepreg, thickness = 0.48521, material = { name = "FR-4 prepreg", dk = 4.1, df = 0.02, conductivity = 0, k_inplane = 0.8, k_through = 0.3, density = 1850, cp = 1100, cte_ppm = 14 } }
        layer "B.Cu" = { kind = copper, thickness = 0.03479, weight = 1, material = copper }
        layer "B.Mask" = { kind = mask, thickness = 0.02, material = solder_mask }
    }
    outline = [[-60, -50], [60, -50], [60, 50], [-60, 50]]
    limits = { clearance = 0.1, track = 0.1, via_diameter = 0.45, drill = 0.2, annular = 0.1, hole_to_hole = 0.25, copper_to_edge = 0.4, silk_to_pad = 0.1, microvia_drill = 0.1 }
    net_class digital = { track_width = 0.1 mm, clearance = 0.1 mm }
    net_class power = { track_width = 0.5 mm, clearance = 0.15 mm }
    net_class supply = { track_width = 0.3 mm, clearance = 0.1 mm }
    net V28 : power
    net GND : supply
    net "/pwr/BST5"
    net "/pwr/SW5" : power
    net "+5V" : supply
    net "+3V3" : supply
    net V28_SENSE
    net "/bl/VLED" : power
    net "/bl/VCC_BL"
    net "/bl/COMP"
    net "/mcu/OSC_IN"
    net "/mcu/OSC_OUT"
    net "/mcu/VCAP"
    net "/mcu/NRST"
    net "/mcu/DIM_ADC"
    net "/pwr/V28_FUSED"
    net "/bl/SWL" : power
    net "/mcu/LED_K"
    net V28_IN : power
    net DIM_IN
    net DISC_ON
    net SPI_SCK
    net SPI_MOSI
    net PANEL_CS
    net PANEL_EN
    net "/bl/LED1"
    net "/bl/LED2"
    net "/bl/LED3"
    net "/bl/LED4"
    net "/bl/LED5"
    net "/bl/LED6"
    net "/pwr/FB5"
    net "/pwr/EN5"
    net "/bl/ISET"
    net "/bl/FSET"
    net "/bl/OVP"
    net BL_FAULT
    net "/mcu/BOOT0"
    net "/mcu/DISC_MCU"
    net "/mcu/LED_STATUS"
    net BL_EN
    net BL_PWM
    footprint C1 = { package = C_1206_3216Metric_IPCN, at = [-34, 22], rotation = 90, value = "10 µF ±10%", pads = { "1" = V28, "2" = GND }, properties = { "param:capacitance" = "10 µF ±10%", "param:voltage_rating" = "50 V" } }
    footprint C2 = { package = C_1206_3216Metric_IPCN, at = [-31, 22], rotation = 90, value = "10 µF ±10%", pads = { "1" = V28, "2" = GND }, properties = { "param:capacitance" = "10 µF ±10%", "param:voltage_rating" = "50 V" } }
    footprint C3 = { package = C_0402_1005Metric_IPCN, at = [-24, 26.5], value = "100 nF ±10%", pads = { "1" = "/pwr/BST5", "2" = "/pwr/SW5" }, properties = { "param:capacitance" = "100 nF ±10%", "param:voltage_rating" = "16 V" } }
    footprint C4 = { package = C_0805_2012Metric_IPCN, at = [-11, 22], rotation = 90, value = "22 µF ±20%", pads = { "1" = "+5V", "2" = GND }, properties = { "param:capacitance" = "22 µF ±20%", "param:voltage_rating" = "10 V" } }
    footprint C5 = { package = C_0805_2012Metric_IPCN, at = [-8, 22], rotation = 90, value = "22 µF ±20%", pads = { "1" = "+5V", "2" = GND }, properties = { "param:capacitance" = "22 µF ±20%", "param:voltage_rating" = "10 V" } }
