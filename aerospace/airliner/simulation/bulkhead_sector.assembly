// A 10 degree sector of the aft pressure bulkhead, for bulkhead_dome.fea: the part's own
// profile turned through 10 degrees instead of a full turn. The dome's load and supports repeat
// round the axis, so the sector's two cut faces are planes of symmetry. Exported to
// geometry/bulkhead_sector.step.
import { aft_pressure_bulkhead } from "../fuselage/aft_pressure_bulkhead.part"

assembly bulkhead_sector {
    instance bulkhead : aft_pressure_bulkhead = {
        inputs = { sweep = 10 deg }
    }
}
