// The cockpit display unit's assembly drawing at 1:2 on A3, third-angle projection: the side
// elevation, section A-A across the case showing the controller board on its bosses, an
// isometric, balloons on the items and the parts list.
import { display_unit_installed } from "../cockpit/display_unit_installed.assembly"

drawing display_unit {
    format a3 = {
        size = iso(name = A3)
        title_block = [
            { label = Title, source = literal(text = "Display unit, installed") },
            { label = "Part number", source = literal(text = "FD-DU-340-A") },
            { label = Drawn, source = literal(text = "RunMat Design") },
            { label = Scale, source = scale() },
            { label = Sheet, source = sheet_number() },
            { label = Rev, source = revision() },
            { label = Date, source = literal(text = "2026-11-10") },
        ]
    }

    sheet s1 {
        format = a3
        scale = 1/2
        projection = third_angle

        view front = standard(
            orientation = front,
            model = display_unit_installed,
            at = [75, 180] mm,
            display = visible_lines,
        )
        view a_a = section(
            from = front,
            plane = origin.xy,
            label = A,
            model = display_unit_installed,
            at = [190, 180] mm,
            display = visible_lines,
        )
        view iso = standard(
            orientation = isometric,
            model = display_unit_installed,
            at = [330, 215] mm,
            scale = 1/3,
            display = visible_lines,
        )

        table parts = bom(view = iso, at = [228, 110] mm)
        table notes = notes(
            rows = [
                "DIMENSIONS IN MILLIMETERS. GENERAL TOLERANCES ISO 2768-mK UNLESS STATED.",
                "BOARD ON THE CASE'S FOUR BOSSES WITH M3 SCREWS, COMPONENTS TOWARD THE SCREEN.",
                "CASE: 6061-T6, CHROMATE CONVERSION COAT, BACK UNPAINTED FOR COOLING.",
                "SEE ELECTRICAL/DISPLAY_UNIT FOR THE BOARD'S SCHEMATIC AND LAYOUT.",
            ],
            at = [0, 0] mm,
        )
    }

    annotation b1 = balloon(occurrence = [{ name = display_unit }], table = parts, view = iso)
    annotation b2 = balloon(occurrence = [{ name = controller }], table = parts, view = a_a)
}
