runmat 0.7
std 1

// The cockpit display unit's assembly drawing at 1:2 on A3, third-angle projection: the side
// elevation, section A-A across the case showing the controller board on its bosses, an
// isometric, balloons on the items and the parts list.
drawing display_unit {
    format a3 = {
        size = { size = iso, name = A3 },
        title_block = [
            { label = "Title", source = { source = literal, text = "Display unit, installed" } },
            { label = "Part number", source = { source = literal, text = "FD-DU-340-A" } },
            { label = "Drawn", source = { source = literal, text = "RunMat Design" } },
            { label = "Scale", source = { source = scale } },
            { label = "Sheet", source = { source = sheet_number } },
            { label = "Rev", source = { source = revision } },
            { label = "Date", source = { source = literal, text = "2026-11-10" } }
        ]
    }

    sheet "1" = { format = a3, scale = [1, 2], projection = third_angle }

    view front = standard(orientation = front, sheet = "1", model = { assembly = display_unit_installed, from = "../cockpit" }, at = [75, 180], display = visible_lines)
    view a_a = section(
        from = front,
        plane = origin.xy,
        label = A,
        sheet = "1",
        model = { assembly = display_unit_installed, from = "../cockpit" },
        at = [190, 180],
        display = visible_lines
    )
    view iso = standard(orientation = isometric, sheet = "1", model = { assembly = display_unit_installed, from = "../cockpit" }, at = [330, 215], scale = [1, 3], display = visible_lines)

    annotation b1 = balloon(occurrence = [{ name = display_unit }], table = parts, view = iso)
    annotation b2 = balloon(occurrence = [{ name = controller }], table = parts, view = a_a)

    table parts = bom(view = iso, sheet = "1", at = [228, 110])
    table notes = notes(
        rows = [
            "DIMENSIONS IN MILLIMETERS. GENERAL TOLERANCES ISO 2768-mK UNLESS STATED.",
            "BOARD ON THE CASE'S FOUR BOSSES WITH M3 SCREWS, COMPONENTS TOWARD THE SCREEN.",
            "CASE: 6061-T6, CHROMATE CONVERSION COAT, BACK UNPAINTED FOR COOLING.",
            "SEE ELECTRICAL/DISPLAY_UNIT FOR THE BOARD'S SCHEMATIC AND LAYOUT."
        ],
        sheet = "1",
        at = [0, 0]
    )
}
