// The main gear strut's detail drawing at 1:15 on A3, third-angle projection: the elevation with
// the length and the bore's depth, the plan (the trunnion end) with the outside diameter,
// section A-A across the tube with the bore's diameter, and an isometric. The outside (datum A) and the
// bore carry their sizes and the bore's position to A from the part's PMI.
import { gear_strut } from "../landing_gear/gear_strut.part"

drawing gear_strut {
    format a3 = {
        size = iso(name = A3)
        title_block = [
            { label = Title, source = literal(text = "Main gear strut") },
            { label = "Part number", source = property(name = part_number) },
            { label = Material, source = property(name = material) },
            { label = Drawn, source = literal(text = "RunMat Design") },
            { label = Scale, source = scale() },
            { label = Sheet, source = sheet_number() },
            { label = Rev, source = revision() },
            { label = Date, source = literal(text = "2026-11-10") },
        ]
    }

    sheet s1 {
        format = a3
        scale = 1/15
        projection = third_angle

        view front = standard(orientation = front, model = gear_strut, at = [70, 140] mm, display = hidden_lines)
        view top = projected(
            from = front,
            direction = up,
            model = gear_strut,
            at = [70, 255] mm,
            display = visible_lines,
        )
        view a_a = section(
            from = front,
            plane = feature.strut.face.side(s.c),
            label = A,
            model = gear_strut,
            at = [175, 140] mm,
            display = visible_lines,
        )
        view iso = standard(
            orientation = isometric,
            model = gear_strut,
            at = [330, 190] mm,
            scale = 1/20,
            display = visible_lines,
        )
    }

    annotation length = dimension(
        style = linear,
        references = [feature.strut.face.start, feature.strut.face.end],
        view = front,
    )
    annotation bore_depth = dimension(
        style = linear,
        references = [feature.strut.face.start, feature.cylinder_bore.face.end],
        view = front,
    )
    annotation outside = dimension(style = diameter, references = [feature.strut.face.side(s.c)], pmi = outside, view = top)
    annotation bore = dimension(
        style = diameter,
        references = [feature.cylinder_bore.face.side(b.c)],
        pmi = bore_size,
        view = a_a,
    )
    annotation datum_a = datum_symbol(label = A, view = front)
    annotation bore_position = gdt(tolerance = bore_coaxial, view = a_a)
    annotation notes = note(
        text = "NOTES:\n1. MATERIAL: {material}, VACUUM REMELTED, HEAT TREAT TO 1930-2070 MPA.\n2. SHOT PEEN ALL OVER; CHROME PLATE THE OUTSIDE AND THE BORE, 0.1 MM, GROUND TO SIZE.\n3. MAGNETIC PARTICLE INSPECT AFTER GRINDING.\n4. DIMENSIONS IN MM. UNTOLERANCED: ISO 2768-m.\n5. PART MARK {part_number} AT THE TRUNNION END.",
        view = iso,
        at = [130, 105] mm,
    )
}
