runmat 0.7
std 1

// A main landing gear leg: oleo strut, axle and two wheels.
assembly main_gear {
    use part gear_strut as strut {
        configuration = { select = inputs, values = { length = 2500 mm, radius = 115 mm } }
        placement = { placement = offset, offset = { translation = [0 mm, 0 mm, -2500 mm] } }
    }
    use part axle as axle {
        configuration = { select = inputs, values = { length = 1180 mm } }
        placement = { placement = offset, offset = { translation = [0 mm, 0 mm, -2500 mm] } }
    }
    use part tyre as inboard_tyre {
        configuration = { select = inputs, values = { rim = 440 mm, tube = 170 mm } }
        placement = { placement = offset, offset = { translation = [0 mm, -420 mm, -2500 mm] } }
    }
    use part hub as inboard_hub {
        configuration = { select = inputs, values = { radius = 440 mm } }
        placement = { placement = offset, offset = { translation = [0 mm, -420 mm, -2500 mm] } }
    }
    use part tyre as outboard_tyre {
        configuration = { select = inputs, values = { rim = 440 mm, tube = 170 mm } }
        placement = { placement = offset, offset = { translation = [0 mm, 420 mm, -2500 mm] } }
    }
    use part hub as outboard_hub {
        configuration = { select = inputs, values = { radius = 440 mm } }
        placement = { placement = offset, offset = { translation = [0 mm, 420 mm, -2500 mm] } }
    }
}
