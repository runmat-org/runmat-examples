// The fuselage: the nose and its cockpit glazing, three barrel sections, the tail cone and the
// wing-to-body fairing, along x.
import { nose } from "./nose.part"
import { nose_lining } from "../cockpit/nose_lining.part"
import { cockpit_window_front } from "./cockpit_window_front.part"
import { cockpit_window_side } from "./cockpit_window_side.part"
import { cockpit_window_aft } from "./cockpit_window_aft.part"
import { fuselage_section } from "./fuselage_section.assembly"
import { cockpit } from "../cockpit/cockpit.assembly"
import { cabin } from "../cabin/cabin.assembly"
import { hold } from "../cargo/hold.assembly"
import { tail_cone } from "./tail_cone.part"
import { aft_pressure_bulkhead } from "./aft_pressure_bulkhead.part"
import { fairing } from "./fairing.part"

assembly fuselage {
    instance nose : nose
    instance nose_lining : nose_lining
    instance window_front : cockpit_window_front
    instance window_side : cockpit_window_side
    instance window_aft : cockpit_window_aft
    mirror window_front_port = {
        seeds = [window_front]
        plane = explicit(point = [0 mm, 0 mm, 0 mm], normal = [0, 1, 0])
        hand = opposite(
            source = { definition = { kind = part, name = cockpit_window_front } },
            configuration = { select = named, name = port },
            point = [0 mm, 0 mm, 0 mm],
            normal = [0, 1, 0],
        )
    }
    mirror window_side_port = {
        seeds = [window_side]
        plane = explicit(point = [0 mm, 0 mm, 0 mm], normal = [0, 1, 0])
        hand = opposite(
            source = { definition = { kind = part, name = cockpit_window_side } },
            configuration = { select = named, name = port },
            point = [0 mm, 0 mm, 0 mm],
            normal = [0, 1, 0],
        )
    }
    mirror window_aft_port = {
        seeds = [window_aft]
        plane = explicit(point = [0 mm, 0 mm, 0 mm], normal = [0, 1, 0])
        hand = opposite(
            source = { definition = { kind = part, name = cockpit_window_aft } },
            configuration = { select = named, name = port },
            point = [0 mm, 0 mm, 0 mm],
            normal = [0, 1, 0],
        )
    }
    instance forward : fuselage_section = {
        placement = offset(translation = [5200 mm, 0 mm, 0 mm])
        overrides = {
            "window_starboard_fwd@windows_fwd[7]" = { suppressed = true }
            "window_port_fwd@windows_fwd[7]" = { suppressed = true }
            "window_starboard_fwd@windows_fwd[6]" = { suppressed = true }
            "window_port_fwd@windows_fwd[6]" = { suppressed = true }
            "bin_starboard_fwd@bins_fwd[1]" = { suppressed = true }
            "bin_port_fwd@bins_fwd[1]" = { suppressed = true }
        }
    }
    instance center : fuselage_section = {
        placement = offset(translation = [13200 mm, 0 mm, 0 mm])
    }
    instance aft : fuselage_section = {
        placement = offset(translation = [21200 mm, 0 mm, 0 mm])
        overrides = {
            "window_starboard@windows[6]" = { suppressed = true }
            "window_port@windows[6]" = { suppressed = true }
            "window_starboard@windows[7]" = { suppressed = true }
            "window_port@windows[7]" = { suppressed = true }
            "bin_starboard@bins[2]" = { suppressed = true }
            "bin_port@bins[2]" = { suppressed = true }
        }
    }
    instance cockpit : cockpit
    instance cabin : cabin
    instance hold : hold
    instance tail_cone : tail_cone = {
        placement = offset(translation = [29200 mm, 0 mm, 0 mm])
    }
    instance aft_pressure_bulkhead : aft_pressure_bulkhead = {
        placement = offset(translation = [29900 mm, 0 mm, 0 mm])
    }
    instance fairing : fairing = {
        placement = offset(translation = [11400 mm, 0 mm, -1250 mm])
    }
}
