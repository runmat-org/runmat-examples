// The fuselage: the nose and its cockpit glazing, three barrel sections, the tail cone and the
// wing-to-body fairing, along x.
assembly fuselage {
    use part nose as nose
    use part nose_lining from "../cockpit" as nose_lining
    use part cockpit_window_front as window_front
    use part cockpit_window_side as window_side
    use part cockpit_window_aft as window_aft
    mirror window_front_port = {
        seeds = [window_front]
        plane = { plane = explicit, point = [0 mm, 0 mm, 0 mm], normal = [0, 1, 0] }
        hand = opposite(source = { definition = { kind = part, name = cockpit_window_front } }, configuration = { select = named, name = port }, point = [0 mm, 0 mm, 0 mm], normal = [0, 1, 0])
    }
    mirror window_side_port = {
        seeds = [window_side]
        plane = { plane = explicit, point = [0 mm, 0 mm, 0 mm], normal = [0, 1, 0] }
        hand = opposite(source = { definition = { kind = part, name = cockpit_window_side } }, configuration = { select = named, name = port }, point = [0 mm, 0 mm, 0 mm], normal = [0, 1, 0])
    }
    mirror window_aft_port = {
        seeds = [window_aft]
        plane = { plane = explicit, point = [0 mm, 0 mm, 0 mm], normal = [0, 1, 0] }
        hand = opposite(source = { definition = { kind = part, name = cockpit_window_aft } }, configuration = { select = named, name = port }, point = [0 mm, 0 mm, 0 mm], normal = [0, 1, 0])
    }
    use assembly fuselage_section as forward {
        placement = offset(translation = [5200 mm, 0 mm, 0 mm])
        override "window_starboard_fwd@windows_fwd[7]" {
            suppressed = true
        }
        override "window_port_fwd@windows_fwd[7]" {
            suppressed = true
        }
        override "window_starboard_fwd@windows_fwd[6]" {
            suppressed = true
        }
        override "window_port_fwd@windows_fwd[6]" {
            suppressed = true
        }
        override "bin_starboard_fwd@bins_fwd[1]" {
            suppressed = true
        }
        override "bin_port_fwd@bins_fwd[1]" {
            suppressed = true
        }
    }
    use assembly fuselage_section as center {
        placement = offset(translation = [13200 mm, 0 mm, 0 mm])
    }
    use assembly fuselage_section as aft {
        placement = offset(translation = [21200 mm, 0 mm, 0 mm])
        override "window_starboard@windows[6]" {
            suppressed = true
        }
        override "window_port@windows[6]" {
            suppressed = true
        }
        override "window_starboard@windows[7]" {
            suppressed = true
        }
        override "window_port@windows[7]" {
            suppressed = true
        }
        override "bin_starboard@bins[2]" {
            suppressed = true
        }
        override "bin_port@bins[2]" {
            suppressed = true
        }
    }
    use assembly cockpit from "../cockpit" as cockpit
    use assembly cabin from "../cabin" as cabin
    use assembly hold from "../cargo" as hold
    use part tail_cone as tail_cone {
        placement = offset(translation = [29200 mm, 0 mm, 0 mm])
    }
    use part aft_pressure_bulkhead as aft_pressure_bulkhead {
        placement = offset(translation = [29900 mm, 0 mm, 0 mm])
    }
    use part fairing as fairing {
        placement = offset(translation = [11400 mm, 0 mm, -1250 mm])
    }
}
