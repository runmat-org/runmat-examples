// The fan disk behind the inlet.

import { titanium } from "../materials.module"

part fan {
    sketch s on origin.yz {
        c = circle(center = [0 mm, 0 mm], radius = 840 mm)
    }
    feature disk = extrude(profile = sketch.s, distance = 140 mm)

    output fan = {
        body = feature.disk.body
        part_number = "NAC-FN-910"
        material = titanium
        color = "#363C44"
    }
}
