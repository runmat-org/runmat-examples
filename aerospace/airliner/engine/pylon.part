runmat 0.7
std 1

// The pylon from the cowl's crown up into the wing box, 360 mm wide.
part pylon {
    sketch s on origin.zx {
        l1 = line(start = [1040 mm, 700 mm], end = [860 mm, 3300 mm])
        l2 = line(start = [860 mm, 3300 mm], end = [1480 mm, 5000 mm])
        l3 = line(start = [1480 mm, 5000 mm], end = [1720 mm, 3200 mm])
        l4 = line(start = [1720 mm, 3200 mm], end = [1040 mm, 700 mm])
    }
    feature pylon = extrude(profile = sketch.s, distance = 360 mm, symmetric)

    output pylon = { body = feature.pylon.body, part_number = "NAC-PY-930", material = "titanium", color = "#C7CCD3" }
}
