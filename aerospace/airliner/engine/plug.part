// The exhaust plug.
part plug {
    sketch s on origin.xy {
        c1 = spline(points = [[4300 mm, 420 mm], [4650 mm, 300 mm], [4950 mm, 120 mm], [5050 mm, 0 mm]])
        c2_1 = line(start = c1.end, end = [4300 mm, 0 mm])
        c2 = line(start = c2_1.end, end = c1.start)
    }
    feature body = revolve(profile = sketch.s, axis = origin.x, angle = 360 deg)

    output plug = { body = feature.body.body, part_number = "NAC-PL-950", material = "titanium", color = "#8A9097" }
}
