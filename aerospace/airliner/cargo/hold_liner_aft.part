// A cargo hold's sidewall liner, one side, inside the frames from the cargo floor to the floor beams.
part hold_liner_aft {
    sketch s on origin.xy {
        l1 = line(start = [0 mm, 1800 mm], end = [7900 mm, 1800 mm])
        l2 = line(start = [7900 mm, 1800 mm], end = [7900 mm, 1808 mm])
        l3 = line(start = [7900 mm, 1808 mm], end = [0 mm, 1808 mm])
        l4 = line(start = [0 mm, 1808 mm], end = [0 mm, 1800 mm])
    }
    feature panel = revolve(profile = sketch.s, axis = origin.x, angle = 51.404331 deg)

    output hold_liner_aft = {
        body = feature.panel.body
        part_number = "FUS-CL-811"
        material = composite
        color = "#C9CDD2"
    }
}
