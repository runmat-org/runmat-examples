// A generic twin-engine narrow-body airliner, 38 m long with a 35 m span.
import { airliner_skeleton } from "./airliner_skeleton.part"
import { fuselage } from "./fuselage/fuselage.assembly"
import { wing } from "./wing/wing.assembly"
import { empennage } from "./empennage/empennage.assembly"
import { main_gear } from "./landing_gear/main_gear.assembly"
import { nose_gear } from "./landing_gear/nose_gear.assembly"

assembly airliner {
    input span : length = 34000 mm
    input frame_pitch : length = 500 mm
    input rib_pitch : length = 650 mm

    instance skeleton : airliner_skeleton
    instance fuselage : fuselage = {
        placement = attach(
            own = { anchor = origin },
            to = { frame = interface, part = airliner_skeleton, name = fuselage },
        )
    }
    instance wing : wing = {
        placement = attach(
            own = { anchor = origin },
            to = { frame = interface, part = airliner_skeleton, name = wing_root },
        )
    }
    instance empennage : empennage = {
        placement = attach(
            own = { anchor = origin },
            to = { frame = interface, part = airliner_skeleton, name = tail },
        )
    }
    instance main_gear_starboard : main_gear = {
        placement = attach(
            own = { anchor = origin },
            to = { frame = interface, part = airliner_skeleton, name = main_gear_starboard },
        )
    }
    instance main_gear_port : main_gear = {
        placement = attach(
            own = { anchor = origin },
            to = { frame = interface, part = airliner_skeleton, name = main_gear_port },
        )
    }
    instance nose_gear : nose_gear = {
        placement = attach(
            own = { anchor = origin },
            to = { frame = interface, part = airliner_skeleton, name = nose_gear },
        )
    }

    camera hero = { from = [-0.68, -0.62, 0.42], default = true }
}
