// The fixed leading edge inboard of the engine.

import { aluminum_2024 } from "../materials.module"

part wing_leading_edge {
    input side : real = 1

    feature st0 = plane.offset(base = origin.zx, distance = input.side * 1400 mm)
    sketch s0 on plane.st0 {
        c1 = spline(points = [[585.957 mm, 1589.797 mm], [552.399 mm, 1425.194 mm], [514.634 mm, 1275.729 mm], [473.28 mm, 1142.367 mm], [428.987 mm, 1025.942 mm], [382.409 mm, 927.16 mm], [334.175 mm, 846.592 mm], [284.859 mm, 784.679 mm], [234.953 mm, 741.731 mm], [184.846 mm, 717.931 mm], [134.805 mm, 713.335 mm], [86.657 mm, 727.711 mm], [42.173 mm, 760.705 mm], [1.452 mm, 812.016 mm], [-35.395 mm, 881.231 mm], [-68.253 mm, 967.829 mm], [-97.013 mm, 1071.196 mm], [-121.595 mm, 1190.623 mm], [-141.952 mm, 1325.325 mm], [-158.091 mm, 1474.442 mm], [-170.083 mm, 1637.049 mm]])
        c2 = line(start = c1.end, end = c1.start)
    }
    feature st1 = plane.offset(base = origin.zx, distance = input.side * 5000 mm)
    sketch s1 on plane.st1 {
        c1 = spline(points = [[836.649 mm, 3275.243 mm], [809.963 mm, 3138.862 mm], [779.998 mm, 3014.988 mm], [747.251 mm, 2904.419 mm], [712.245 mm, 2807.847 mm], [675.506 mm, 2725.859 mm], [637.536 mm, 2658.932 mm], [598.796 mm, 2607.435 mm], [559.677 mm, 2571.631 mm], [520.489 mm, 2551.676 mm], [481.445 mm, 2547.625 mm], [443.97 mm, 2559.298 mm], [409.444 mm, 2586.417 mm], [377.937 mm, 2628.739 mm], [349.532 mm, 2685.926 mm], [324.307 mm, 2757.553 mm], [302.335 mm, 2843.113 mm], [283.667 mm, 2942.025 mm], [268.323 mm, 3053.638 mm], [256.282 mm, 3177.241 mm], [247.471 mm, 3312.066 mm]])
        c2 = line(start = c1.end, end = c1.start)
    }
    feature piece = loft(profiles = [sketch.s0, sketch.s1])

    output wing_leading_edge = {
        body = feature.piece.body
        part_number = "WNG-LE-610"
        material = aluminum_2024
        color = "#A8AFB8"
    }
}
