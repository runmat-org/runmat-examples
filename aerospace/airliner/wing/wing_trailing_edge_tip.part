// The fixed trailing edge outboard of the aileron.

import { aluminum_2024 } from "../materials.module"

part wing_trailing_edge_tip {
    input side : real = 1

    feature st0 = plane.offset(base = origin.zx, distance = input.side * 15700 mm)
    sketch s0 on plane.st0 {
        c1 = spline(points = [[1614.939 mm, 9250.101 mm], [1598.353 mm, 9391.044 mm], [1580.88 mm, 9521.03 mm], [1563.569 mm, 9636.852 mm], [1547.475 mm, 9735.676 mm], [1533.625 mm, 9815.106 mm], [1522.952 mm, 9873.23 mm], [1516.216 mm, 9908.665 mm], [1513.912 mm, 9920.57 mm]])
        c2 = line(start = c1.end, end = [1509.563 mm, 9920.28 mm])
        c3 = spline(points = [c2.end, [1508.851 mm, 9908.179 mm], [1506.752 mm, 9872.195 mm], [1503.362 mm, 9813.274 mm], [1498.811 mm, 9732.956 mm], [1493.241 mm, 9633.324 mm], [1486.798 mm, 9516.942 mm], [1479.649 mm, 9386.779 mm], [1472.032 mm, 9246.131 mm]])
        c4 = line(start = c3.end, end = c1.start)
    }
    feature st1 = plane.offset(base = origin.zx, distance = input.side * 17000 mm)
    sketch s1 on plane.st1 {
        c1 = spline(points = [[1718.556 mm, 9670.981 mm], [1705.449 mm, 9784.707 mm], [1691.631 mm, 9889.598 mm], [1677.934 mm, 9983.064 mm], [1665.195 mm, 10062.816 mm], [1654.229 mm, 10126.92 mm], [1645.778 mm, 10173.831 mm], [1640.442 mm, 10202.43 mm], [1638.618 mm, 10212.039 mm]])
        c2 = line(start = c1.end, end = [1635.208 mm, 10211.811 mm])
        c3 = spline(points = [c2.end, [1634.668 mm, 10202.049 mm], [1633.075 mm, 10173.019 mm], [1630.5 mm, 10125.484 mm], [1627.038 mm, 10060.683 mm], [1622.791 mm, 9980.298 mm], [1617.863 mm, 9886.393 mm], [1612.376 mm, 9781.364 mm], [1606.506 mm, 9667.869 mm]])
        c4 = line(start = c3.end, end = c1.start)
    }
    feature piece = loft(profiles = [sketch.s0, sketch.s1])

    output wing_trailing_edge_tip = {
        body = feature.piece.body
        part_number = "WNG-TE-660"
        material = aluminum_2024
        color = "#A8AFB8"
    }
}
