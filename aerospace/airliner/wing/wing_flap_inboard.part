// The inboard flap, aft of the rear spar.
part wing_flap_inboard {
    input side : real = 1

    feature st0 = plane.offset(base = origin.zx, distance = input.side * 1400 mm)
    sketch s0 on plane.st0 {
        c1 = spline(points = [[526.696 mm, 4621.848 mm], [463.113 mm, 5062.278 mm], [396.555 mm, 5468.252 mm], [330.923 mm, 5829.794 mm], [270.112 mm, 6138.116 mm], [217.897 mm, 6385.81 mm], [177.718 mm, 6566.997 mm], [152.376 mm, 6677.422 mm], [143.713 mm, 6714.517 mm]])
        c2 = line(start = c1.end, end = [125.896 mm, 6713.329 mm])
        c3 = spline(points = [c2.end, [122.207 mm, 6675.432 mm], [111.353 mm, 6562.756 mm], [93.921 mm, 6378.307 mm], [70.756 mm, 6126.971 mm], [42.822 mm, 5815.342 mm], [11.14 mm, 5451.507 mm], [-23.168 mm, 5044.81 mm], [-58.734 mm, 4605.586 mm]])
        c4 = line(start = c3.end, end = c1.start)
    }
    feature st1 = plane.offset(base = origin.zx, distance = input.side * 6400 mm)
    sketch s1 on plane.st1 {
        c1 = spline(points = [[896.455 mm, 6239.82 mm], [851.125 mm, 6575.512 mm], [803.581 mm, 6885 mm], [756.63 mm, 7160.668 mm], [713.083 mm, 7395.799 mm], [675.666 mm, 7584.727 mm], [646.862 mm, 7722.945 mm], [628.689 mm, 7807.191 mm], [622.477 mm, 7835.493 mm]])
        c2 = line(start = c1.end, end = [610.023 mm, 7834.663 mm])
        c3 = spline(points = [c2.end, [607.601 mm, 7805.8 mm], [600.473 mm, 7719.98 mm], [589.008 mm, 7579.482 mm], [573.735 mm, 7388.01 mm], [555.249 mm, 7150.566 mm], [534.179 mm, 6873.295 mm], [511.218 mm, 6563.302 mm], [487.244 mm, 6228.453 mm]])
        c4 = line(start = c3.end, end = c1.start)
    }
    feature piece = loft(profiles = [sketch.s0, sketch.s1])

    output wing_flap_inboard = { body = feature.piece.body, part_number = "WNG-FL-630", material = "aluminum_2024", color = "#B1B7BF" }
}
