// Both wings: slat and leading edge, box skins over the front and rear spars and 24 ribs at the
// rib pitch, flaps and aileron, the winglet, flush rivet rows along the spar caps, and the engine
// on its pylon, to starboard; the port wing is their mirror image. The origin is the leading edge
// at the aircraft's centreline.
import { wing_leading_edge } from "./wing_leading_edge.part"
import { wing_slat } from "./wing_slat.part"
import { wing_box_skin_upper } from "./wing_box_skin_upper.part"
import { wing_box_skin_lower } from "./wing_box_skin_lower.part"
import { wing_flap_inboard } from "./wing_flap_inboard.part"
import { wing_flap_outboard } from "./wing_flap_outboard.part"
import { wing_aileron } from "./wing_aileron.part"
import { wing_trailing_edge_tip } from "./wing_trailing_edge_tip.part"
import { wing_front_spar } from "./wing_front_spar.part"
import { wing_rear_spar } from "./wing_rear_spar.part"
import { wing_winglet } from "./wing_winglet.part"
import { rib } from "./rib.part"
import { rivet } from "../+hardware/rivet.part"
import { nacelle } from "../engine/nacelle.assembly"

assembly wing {
    input rib_pitch : length = 650 mm
    input root_station : length = 1400 mm
    input semispan : length = 17000 mm
    input root_chord : length = 6400 mm
    input tip_chord : length = 1550 mm
    input root_thickness : real = 0.145
    input tip_thickness : real = 0.105

    instance leading_edge : wing_leading_edge
