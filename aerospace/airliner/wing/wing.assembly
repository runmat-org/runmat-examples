    instance flap_inboard : wing_flap_inboard
    instance flap_outboard : wing_flap_outboard
    instance aileron : wing_aileron
    instance trailing_edge_tip : wing_trailing_edge_tip
    instance front_spar : wing_front_spar
    instance rear_spar : wing_rear_spar
    instance winglet : wing_winglet
