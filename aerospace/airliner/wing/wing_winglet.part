// The winglet: a swept, canted blade lofted up from inside the wing tip.
part wing_winglet {
    input side : real = 1

    feature st0 = plane.offset(base = origin.xy, distance = 1636.913 mm)
    sketch s0 on plane.st0 {
        c1 = spline(points = [[10031.925 mm, input.side * 16911.313 mm], [10010.629 mm, input.side * 16913.777 mm], [9948.191 mm, input.side * 16920.715 mm], [9848.867 mm, input.side * 16930.945 mm], [9719.425 mm, input.side * 16942.92 mm], [9568.687 mm, input.side * 16954.945 mm], [9406.925 mm, input.side * 16965.146 mm], [9245.163 mm, input.side * 16971.446 mm], [9094.425 mm, input.side * 16971.888 mm], [8964.983 mm, input.side * 16965.295 mm], [8865.659 mm, input.side * 16951.818 mm], [8803.221 mm, input.side * 16932.816 mm], [8781.925 mm, input.side * 16910 mm], [8803.221 mm, input.side * 16887.184 mm], [8865.659 mm, input.side * 16868.182 mm], [8964.983 mm, input.side * 16854.705 mm], [9094.425 mm, input.side * 16848.112 mm], [9245.163 mm, input.side * 16848.554 mm], [9406.925 mm, input.side * 16854.854 mm], [9568.687 mm, input.side * 16865.055 mm], [9719.425 mm, input.side * 16877.08 mm], [9848.867 mm, input.side * 16889.055 mm], [9948.191 mm, input.side * 16899.285 mm], [10010.629 mm, input.side * 16906.223 mm], [10031.925 mm, input.side * 16908.688 mm]])
        c2 = line(start = c1.end, end = c1.start)
    }
    feature st1 = plane.offset(base = origin.xy, distance = 3936.913 mm)
    sketch s1 on plane.st1 {
        c1 = spline(points = [[11133.925 mm, input.side * 17393.441 mm], [11126.769 mm, input.side * 17394.269 mm], [11105.79 mm, input.side * 17396.6 mm], [11072.417 mm, input.side * 17400.038 mm], [11028.925 mm, input.side * 17404.061 mm], [10978.277 mm, input.side * 17408.101 mm], [10923.925 mm, input.side * 17411.529 mm], [10869.573 mm, input.side * 17413.646 mm], [10818.925 mm, input.side * 17413.794 mm], [10775.433 mm, input.side * 17411.579 mm], [10742.06 mm, input.side * 17407.051 mm], [10721.081 mm, input.side * 17400.666 mm], [10713.925 mm, input.side * 17393 mm], [10721.081 mm, input.side * 17385.334 mm], [10742.06 mm, input.side * 17378.949 mm], [10775.433 mm, input.side * 17374.421 mm], [10818.925 mm, input.side * 17372.206 mm], [10869.573 mm, input.side * 17372.354 mm], [10923.925 mm, input.side * 17374.471 mm], [10978.277 mm, input.side * 17377.899 mm], [11028.925 mm, input.side * 17381.939 mm], [11072.417 mm, input.side * 17385.962 mm], [11105.79 mm, input.side * 17389.4 mm], [11126.769 mm, input.side * 17391.731 mm], [11133.925 mm, input.side * 17392.559 mm]])
        c2 = line(start = c1.end, end = c1.start)
    }
    feature blade = loft(profiles = [sketch.s0, sketch.s1])

    output wing_winglet = { body = feature.blade.body, part_number = "WNG-WL-700", material = "composite", color = "#E4E7EB" }
}
