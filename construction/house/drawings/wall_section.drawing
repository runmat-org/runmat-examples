// The exterior wall's section detail at full size on ANSI C: section A-A, a horizontal cut through
// wall_section.part seen from above, the half stud bay the wall_thermal study solves, with each
// layer called out from outside to inside and the layer thicknesses dimensioned. The face of the
// stucco above it carries the cutting line. The layers and thicknesses are the thermal
// study's (DESIGN-NOTES, "Envelope").
drawing wall_section {
    format c = {
        size = { size = ansi, name = C }
        standard = asme
        units = ft_in
        title_block = [
            { label = "Title", source = { source = literal, text = "Exterior wall section" } },
            { label = "Project", source = { source = literal, text = "Two-story house, 40 x 30 ft" } },
            { label = "Drawing", source = { source = literal, text = "A-501" } },
            { label = "Scale", source = { source = scale } },
            { label = "Sheet", source = { source = sheet_number } },
            { label = "Rev", source = { source = revision } },
        ]
    }

    sheet "1" = { format = c, scale = [1, 1], projection = third_angle }

    view face = standard(orientation = front, sheet = "1", model = { part = wall_section, from = "../simulation/wall_section.part" }, at = [200, 385], display = visible_lines)
    view a_a = section(
        from = face,
        plane = origin.xy,
        offset = 2.5 mm,
        keep_other_side = true,
        label = A,
        title = "EXTERIOR WALL SECTION A-A",
        sheet = "1",
        model = { part = wall_section, from = "../simulation/wall_section.part" },
        at = [200, 220],
        display = visible_lines,
    )

    annotation layers = dimension(style = chain, references = [feature.stucco_finish.face.side(stucco_finish_s.e0), feature.stucco_scratch.face.side(stucco_scratch_s.e2), feature.osb.face.side(osb_s.e2), feature.stud.face.side(stud_s.e2), feature.gypsum.face.side(gypsum_s.e2)], view = a_a)
    annotation overall = dimension(style = linear, references = [feature.stucco_finish.face.side(stucco_finish_s.e0), feature.gypsum.face.side(gypsum_s.e2)], view = a_a)
    annotation bay = dimension(style = linear, references = [feature.stud.face.side(stud_s.e3), feature.batt.face.side(batt_s.e1)], view = a_a)

    annotation finish = note(text = "STUCCO FINISH COAT, 1/8\"", leader = feature.stucco_finish.face.end, view = a_a, at = [325, 125])
    annotation brown = note(text = "STUCCO BROWN COAT, 3/8\"", leader = feature.stucco_brown.face.end, view = a_a, at = [325, 134])
    annotation scratch = note(text = "STUCCO SCRATCH COAT ON SELF-FURRING METAL LATH, 3/8\"", leader = feature.stucco_scratch.face.end, view = a_a, at = [325, 143])
    annotation paper = note(text = "2 LAYERS GRADE D BUILDING PAPER (WRB)", leader = feature.wrb_outer.face.end, view = a_a, at = [325, 152])
    annotation osb = note(text = "7/16\" OSB SHEATHING (SHEAR WALL)", leader = feature.osb.face.end, view = a_a, at = [325, 161])
    annotation stud = note(text = "2X6 STUD AT 16\" O.C.", leader = feature.stud.face.end, view = a_a, at = [325, 228])
    annotation batt = note(text = "R-21 FIBERGLASS BATT", leader = feature.batt.face.end, view = a_a, at = [325, 245])
    annotation gypsum = note(text = "1/2\" GYPSUM BOARD ON VAPOR RETARDER", leader = feature.gypsum.face.end, view = a_a, at = [325, 312])

    table notes = notes(
        rows = [
            "OUTSIDE AT THE BOTTOM OF THE VIEW, ROOM AT THE TOP. HALF A STUD BAY: STUD CENTER TO BAY CENTER.",
            "LAYERS AND THICKNESSES MATCH THE WALL_THERMAL STUDY (SIMULATION/WALL_THERMAL.FEA).",
            "METAL LATH AND VAPOR RETARDER ARE THINNER THAN THE DRAWN LINES; NOT MODELED.",
            "DIMENSIONS IN FEET AND INCHES.",
        ],
        sheet = "1",
        at = [0, 0],
    )
}
