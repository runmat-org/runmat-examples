// The house's exterior elevations at 1/4 in = 1 ft on ANSI D: the south (front) elevation and the
// east elevation projected beside it, third-angle. The levels, the overall sizes and the roof
// pitch are marked beside the views; their values are the skeleton's (house_skeleton.part).
import { house } from "../house.assembly"

drawing elevations {
    format d = {
        size = { size = ansi, name = D }
        standard = asme
        units = ft_in
        title_block = [
            { label = "Title", source = { source = literal, text = "Exterior elevations" } },
            { label = "Project", source = { source = literal, text = "Two-story house, 40 x 30 ft" } },
            { label = "Drawing", source = { source = literal, text = "A-201" } },
            { label = "Scale", source = { source = scale } },
            { label = "Sheet", source = { source = sheet_number } },
            { label = "Rev", source = { source = revision } },
        ]
    }

    sheet "1" = { format = d, scale = [1, 48], projection = third_angle }

    view south = standard(orientation = front, sheet = "1", model = house, at = [250, 290], title = "SOUTH ELEVATION", display = visible_lines, exclude = [[{ name = mep }]])
    view east = projected(from = south, direction = right, sheet = "1", model = house, at = [620, 290], title = "EAST ELEVATION", display = visible_lines, exclude = [[{ name = mep }]])

    // Level marks beside the south elevation, at the skeleton's level datums: the first-floor plate
    // and grade on the east side, clear of the second floor and the slab.
    annotation lv_ridge = level(label = "RIDGE", datum = ridge, occurrence = [{ name = skeleton }], view = south)
    annotation lv_plate2 = level(label = "T.O. PLATE (2ND)", datum = top_plate, occurrence = [{ name = skeleton }], view = south)
    annotation lv_floor2 = level(label = "2ND FLOOR", datum = second_floor, occurrence = [{ name = skeleton }], view = south)
    annotation lv_plate1 = level(label = "T.O. PLATE (1ST)", datum = top_plate_l1, occurrence = [{ name = skeleton }], view = south, at = [392, 300])
    annotation lv_slab = level(label = "T.O. SLAB", datum = top_of_slab, occurrence = [{ name = skeleton }], view = south)
    annotation lv_grade = level(label = "GRADE", datum = grade, occurrence = [{ name = skeleton }], view = south, at = [392, 300])
    annotation lv_footing = level(label = "T.O. FOOTING", datum = top_of_footing, occurrence = [{ name = skeleton }], view = south)

    // Overall sizes (outside of framing), floor to floor and the roof pitch.
    annotation w_south = dimension(style = linear, references = [feature.top1.face.side(top1_s.e0), feature.top1.face.side(top1_s.e2)], occurrences = [[{ name = framing }, { name = wall_a_l1 }], [{ name = framing }, { name = wall_a_l1 }]], view = south)
    annotation w_east = dimension(style = linear, references = [feature.top1.face.start, feature.top1.face.start], occurrences = [[{ name = framing }, { name = wall_a_l1 }], [{ name = framing }, { name = wall_d_l1 }]], view = east)
    annotation ftf = note(text = "FLOOR TO FLOOR 10'-1 3/4\"", view = east, at = [730, 249.1])
    annotation ftp = note(text = "2ND FLOOR TO T.O. PLATE 8'-1 1/8\"", view = east, at = [730, 307.0])
    annotation pitch = note(text = "ROOF PITCH 6:12", view = east, at = [598, 400.0])

    table notes = notes(
        rows = [
            "OVERALL: 40'-0\" (GRIDS 1-5) x 30'-0\" (GRIDS A-D), OUTSIDE OF FRAMING. RIDGE 26'-4 5/16\" ABOVE THE SLAB.",
            "LEVELS: T.O. FOOTING -1'-10\". GRADE -0'-8\". T.O. SLAB 0'-0\". T.O. PLATE (1ST) 9'-1 1/8\". 2ND FLOOR 10'-1 3/4\". T.O. PLATE (2ND) 18'-2 7/8\".",
            "FLOOR TO FLOOR: 10'-1 3/4\" (1ST TO 2ND). 2ND FLOOR TO T.O. PLATE 8'-1 1/8\".",
            "ROOF: 6:12 GABLE, RIDGE EAST-WEST. 7/8\" THREE-COAT STUCCO WALLS.",
            "ELECTRICAL ONE-LINE AND PANEL SCHEDULE: MEP/ELECTRICAL/SERVICE.CIRCUIT.",
        ],
        sheet = "1",
        at = [0, 0],
    )
}
