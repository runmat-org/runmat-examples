// An interior 6x6 post (Douglas fir-larch No. 1) from its base on the slab to the floor beam.

import { douglas_fir_lumber } from "../materials.module"

part post {
    input height : length = 108.125 in
    sketch s on origin.xy {
        e0 = line(start = [-2.75 in, -2.75 in], end = [2.75 in, -2.75 in])
        e1 = line(start = [2.75 in, -2.75 in], end = [2.75 in, 2.75 in])
        e2 = line(start = [2.75 in, 2.75 in], end = [-2.75 in, 2.75 in])
        e3 = line(start = [-2.75 in, 2.75 in], end = [-2.75 in, -2.75 in])
    }
    feature body = extrude(profile = sketch.s, distance = input.height)
    output post = { body = feature.body.body, part_number = "P-66", material = material.douglas_fir_lumber }
}
