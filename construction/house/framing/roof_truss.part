// A common roof truss, Fink (W) web pattern: 30 ft span, 6:12 pitch, 18 in overhangs, 2x4
// chords and webs, galvanized steel plates at the joints. Trusses go at 24 in o.c. along the
// ridge (framing.assembly). The gable_end configuration is the end truss over walls 1 and 5:
// vertical studs at 16 in o.c. in place of the webs, for the gable sheathing. Local axes: y across
// the span from the outside face of wall A, z up from the top of the wall plates, x through the
// 1 1/2 in thickness, centred.

import { douglas_fir_lumber, galvanized_steel } from "../materials.module"

part roof_truss {
    feature mid = plane.offset(base = origin.yz, distance = -0.75 in)
    feature face_pos = plane.offset(base = origin.yz, distance = 0.75 in)
    feature face_neg = plane.offset(base = origin.yz, distance = -0.786 in)
    sketch bottom_chord_s on plane.mid {
        e0 = line(start = [0 in, 0 in], end = [360 in, 0 in])
        e1 = line(start = [360 in, 0 in], end = [360 in, 3.5 in])
        e2 = line(start = [360 in, 3.5 in], end = [0 in, 3.5 in])
        e3 = line(start = [0 in, 3.5 in], end = [0 in, 0 in])
    }
    feature bottom_chord = extrude(profile = sketch.bottom_chord_s, distance = 1.5 in)
    sketch top_chord_l_s on plane.mid {
        e0 = line(start = [-18 in, -5.5 in], end = [180 in, 93.5 in])
        e1 = line(start = [180 in, 93.5 in], end = [180 in, 97.4131 in])
        e2 = line(start = [180 in, 97.4131 in], end = [-18 in, -1.5869 in])
        e3 = line(start = [-18 in, -1.5869 in], end = [-18 in, -5.5 in])
    }
    feature top_chord_l = extrude(profile = sketch.top_chord_l_s, distance = 1.5 in)
    sketch top_chord_r_s on plane.mid {
        e0 = line(start = [378 in, -1.5869 in], end = [180 in, 97.4131 in])
        e1 = line(start = [180 in, 97.4131 in], end = [180 in, 93.5 in])
        e2 = line(start = [180 in, 93.5 in], end = [378 in, -5.5 in])
        e3 = line(start = [378 in, -5.5 in], end = [378 in, -1.5869 in])
    }
    feature top_chord_r = extrude(profile = sketch.top_chord_r_s, distance = 1.5 in)
    sketch web_1_s on plane.mid {
        e0 = line(start = [119.6533 in, 0.8652 in], end = [87.4345 in, 49.1934 in])
        e1 = line(start = [87.4345 in, 49.1934 in], end = [90.3467 in, 51.1348 in])
        e2 = line(start = [90.3467 in, 51.1348 in], end = [122.5655 in, 2.8066 in])
        e3 = line(start = [122.5655 in, 2.8066 in], end = [119.6533 in, 0.8652 in])
    }
    feature web_1 = extrude(profile = sketch.web_1_s, distance = 1.5 in)
    sketch web_2_s on plane.mid {
        e0 = line(start = [117.4345 in, 2.8066 in], end = [179.6533 in, 96.1348 in])
        e1 = line(start = [179.6533 in, 96.1348 in], end = [182.5655 in, 94.1934 in])
        e2 = line(start = [182.5655 in, 94.1934 in], end = [120.3467 in, 0.8652 in])
        e3 = line(start = [120.3467 in, 0.8652 in], end = [117.4345 in, 2.8066 in])
    }
    feature web_2 = extrude(profile = sketch.web_2_s, distance = 1.5 in)
    sketch web_3_s on plane.mid {
        e0 = line(start = [239.6533 in, 0.8652 in], end = [177.4345 in, 94.1934 in])
        e1 = line(start = [177.4345 in, 94.1934 in], end = [180.3467 in, 96.1348 in])
        e2 = line(start = [180.3467 in, 96.1348 in], end = [242.5655 in, 2.8066 in])
        e3 = line(start = [242.5655 in, 2.8066 in], end = [239.6533 in, 0.8652 in])
    }
    feature web_3 = extrude(profile = sketch.web_3_s, distance = 1.5 in)
    sketch web_4_s on plane.mid {
        e0 = line(start = [237.4345 in, 2.8066 in], end = [269.6533 in, 51.1348 in])
        e1 = line(start = [269.6533 in, 51.1348 in], end = [272.5655 in, 49.1934 in])
        e2 = line(start = [272.5655 in, 49.1934 in], end = [240.3467 in, 0.8652 in])
        e3 = line(start = [240.3467 in, 0.8652 in], end = [237.4345 in, 2.8066 in])
    }
    feature web_4 = extrude(profile = sketch.web_4_s, distance = 1.5 in)
    feature web_1_fit = boolean.subtract(
        target = feature.web_1.body,
        tools = [feature.bottom_chord.body, feature.top_chord_l.body, feature.top_chord_r.body],
        keep_tools = true,
    )
    feature web_2_fit = boolean.subtract(
        target = feature.web_2.body,
        tools = [feature.bottom_chord.body, feature.top_chord_l.body, feature.top_chord_r.body],
        keep_tools = true,
    )
    feature web_3_fit = boolean.subtract(
        target = feature.web_3.body,
        tools = [feature.bottom_chord.body, feature.top_chord_l.body, feature.top_chord_r.body],
        keep_tools = true,
    )
    feature web_4_fit = boolean.subtract(
        target = feature.web_4.body,
        tools = [feature.bottom_chord.body, feature.top_chord_l.body, feature.top_chord_r.body],
        keep_tools = true,
    )
    feature web_2_cope = boolean.subtract(target = feature.web_2.body, tools = [feature.web_1.body], keep_tools = true)
    feature web_3_cope = boolean.subtract(
        target = feature.web_3.body,
        tools = [feature.web_2.body, feature.web_4.body],
        keep_tools = true,
    )
    sketch gable_studs_s on plane.mid {
        g1_0 = line(start = [15.25 in, 3.5 in], end = [16.75 in, 3.5 in])
        g1_1 = line(start = [16.75 in, 3.5 in], end = [16.75 in, 11.875 in])
        g1_2 = line(start = [16.75 in, 11.875 in], end = [15.25 in, 11.125 in])
        g1_3 = line(start = [15.25 in, 11.125 in], end = [15.25 in, 3.5 in])
        g2_0 = line(start = [31.25 in, 3.5 in], end = [32.75 in, 3.5 in])
        g2_1 = line(start = [32.75 in, 3.5 in], end = [32.75 in, 19.875 in])
        g2_2 = line(start = [32.75 in, 19.875 in], end = [31.25 in, 19.125 in])
        g2_3 = line(start = [31.25 in, 19.125 in], end = [31.25 in, 3.5 in])
        g3_0 = line(start = [47.25 in, 3.5 in], end = [48.75 in, 3.5 in])
        g3_1 = line(start = [48.75 in, 3.5 in], end = [48.75 in, 27.875 in])
        g3_2 = line(start = [48.75 in, 27.875 in], end = [47.25 in, 27.125 in])
        g3_3 = line(start = [47.25 in, 27.125 in], end = [47.25 in, 3.5 in])
        g4_0 = line(start = [63.25 in, 3.5 in], end = [64.75 in, 3.5 in])
        g4_1 = line(start = [64.75 in, 3.5 in], end = [64.75 in, 35.875 in])
        g4_2 = line(start = [64.75 in, 35.875 in], end = [63.25 in, 35.125 in])
        g4_3 = line(start = [63.25 in, 35.125 in], end = [63.25 in, 3.5 in])
        g5_0 = line(start = [79.25 in, 3.5 in], end = [80.75 in, 3.5 in])
        g5_1 = line(start = [80.75 in, 3.5 in], end = [80.75 in, 43.875 in])
        g5_2 = line(start = [80.75 in, 43.875 in], end = [79.25 in, 43.125 in])
        g5_3 = line(start = [79.25 in, 43.125 in], end = [79.25 in, 3.5 in])
        g6_0 = line(start = [95.25 in, 3.5 in], end = [96.75 in, 3.5 in])
        g6_1 = line(start = [96.75 in, 3.5 in], end = [96.75 in, 51.875 in])
        g6_2 = line(start = [96.75 in, 51.875 in], end = [95.25 in, 51.125 in])
        g6_3 = line(start = [95.25 in, 51.125 in], end = [95.25 in, 3.5 in])
        g7_0 = line(start = [111.25 in, 3.5 in], end = [112.75 in, 3.5 in])
        g7_1 = line(start = [112.75 in, 3.5 in], end = [112.75 in, 59.875 in])
        g7_2 = line(start = [112.75 in, 59.875 in], end = [111.25 in, 59.125 in])
        g7_3 = line(start = [111.25 in, 59.125 in], end = [111.25 in, 3.5 in])
        g8_0 = line(start = [127.25 in, 3.5 in], end = [128.75 in, 3.5 in])
        g8_1 = line(start = [128.75 in, 3.5 in], end = [128.75 in, 67.875 in])
        g8_2 = line(start = [128.75 in, 67.875 in], end = [127.25 in, 67.125 in])
        g8_3 = line(start = [127.25 in, 67.125 in], end = [127.25 in, 3.5 in])
        g9_0 = line(start = [143.25 in, 3.5 in], end = [144.75 in, 3.5 in])
        g9_1 = line(start = [144.75 in, 3.5 in], end = [144.75 in, 75.875 in])
        g9_2 = line(start = [144.75 in, 75.875 in], end = [143.25 in, 75.125 in])
        g9_3 = line(start = [143.25 in, 75.125 in], end = [143.25 in, 3.5 in])
        g10_0 = line(start = [159.25 in, 3.5 in], end = [160.75 in, 3.5 in])
        g10_1 = line(start = [160.75 in, 3.5 in], end = [160.75 in, 83.875 in])
        g10_2 = line(start = [160.75 in, 83.875 in], end = [159.25 in, 83.125 in])
        g10_3 = line(start = [159.25 in, 83.125 in], end = [159.25 in, 3.5 in])
        g11_0 = line(start = [175.25 in, 3.5 in], end = [176.75 in, 3.5 in])
        g11_1 = line(start = [176.75 in, 3.5 in], end = [176.75 in, 91.875 in])
        g11_2 = line(start = [176.75 in, 91.875 in], end = [175.25 in, 91.125 in])
        g11_3 = line(start = [175.25 in, 91.125 in], end = [175.25 in, 3.5 in])
        g12_0 = line(start = [191.25 in, 3.5 in], end = [192.75 in, 3.5 in])
        g12_1 = line(start = [192.75 in, 3.5 in], end = [192.75 in, 87.125 in])
        g12_2 = line(start = [192.75 in, 87.125 in], end = [191.25 in, 87.875 in])
        g12_3 = line(start = [191.25 in, 87.875 in], end = [191.25 in, 3.5 in])
        g13_0 = line(start = [207.25 in, 3.5 in], end = [208.75 in, 3.5 in])
        g13_1 = line(start = [208.75 in, 3.5 in], end = [208.75 in, 79.125 in])
        g13_2 = line(start = [208.75 in, 79.125 in], end = [207.25 in, 79.875 in])
        g13_3 = line(start = [207.25 in, 79.875 in], end = [207.25 in, 3.5 in])
        g14_0 = line(start = [223.25 in, 3.5 in], end = [224.75 in, 3.5 in])
        g14_1 = line(start = [224.75 in, 3.5 in], end = [224.75 in, 71.125 in])
        g14_2 = line(start = [224.75 in, 71.125 in], end = [223.25 in, 71.875 in])
        g14_3 = line(start = [223.25 in, 71.875 in], end = [223.25 in, 3.5 in])
        g15_0 = line(start = [239.25 in, 3.5 in], end = [240.75 in, 3.5 in])
        g15_1 = line(start = [240.75 in, 3.5 in], end = [240.75 in, 63.125 in])
        g15_2 = line(start = [240.75 in, 63.125 in], end = [239.25 in, 63.875 in])
        g15_3 = line(start = [239.25 in, 63.875 in], end = [239.25 in, 3.5 in])
        g16_0 = line(start = [255.25 in, 3.5 in], end = [256.75 in, 3.5 in])
        g16_1 = line(start = [256.75 in, 3.5 in], end = [256.75 in, 55.125 in])
        g16_2 = line(start = [256.75 in, 55.125 in], end = [255.25 in, 55.875 in])
        g16_3 = line(start = [255.25 in, 55.875 in], end = [255.25 in, 3.5 in])
        g17_0 = line(start = [271.25 in, 3.5 in], end = [272.75 in, 3.5 in])
        g17_1 = line(start = [272.75 in, 3.5 in], end = [272.75 in, 47.125 in])
        g17_2 = line(start = [272.75 in, 47.125 in], end = [271.25 in, 47.875 in])
        g17_3 = line(start = [271.25 in, 47.875 in], end = [271.25 in, 3.5 in])
        g18_0 = line(start = [287.25 in, 3.5 in], end = [288.75 in, 3.5 in])
        g18_1 = line(start = [288.75 in, 3.5 in], end = [288.75 in, 39.125 in])
        g18_2 = line(start = [288.75 in, 39.125 in], end = [287.25 in, 39.875 in])
        g18_3 = line(start = [287.25 in, 39.875 in], end = [287.25 in, 3.5 in])
        g19_0 = line(start = [303.25 in, 3.5 in], end = [304.75 in, 3.5 in])
        g19_1 = line(start = [304.75 in, 3.5 in], end = [304.75 in, 31.125 in])
        g19_2 = line(start = [304.75 in, 31.125 in], end = [303.25 in, 31.875 in])
        g19_3 = line(start = [303.25 in, 31.875 in], end = [303.25 in, 3.5 in])
        g20_0 = line(start = [319.25 in, 3.5 in], end = [320.75 in, 3.5 in])
        g20_1 = line(start = [320.75 in, 3.5 in], end = [320.75 in, 23.125 in])
        g20_2 = line(start = [320.75 in, 23.125 in], end = [319.25 in, 23.875 in])
        g20_3 = line(start = [319.25 in, 23.875 in], end = [319.25 in, 3.5 in])
        g21_0 = line(start = [335.25 in, 3.5 in], end = [336.75 in, 3.5 in])
        g21_1 = line(start = [336.75 in, 3.5 in], end = [336.75 in, 15.125 in])
        g21_2 = line(start = [336.75 in, 15.125 in], end = [335.25 in, 15.875 in])
        g21_3 = line(start = [335.25 in, 15.875 in], end = [335.25 in, 3.5 in])
        g22_0 = line(start = [351.25 in, 3.5 in], end = [352.75 in, 3.5 in])
        g22_1 = line(start = [352.75 in, 3.5 in], end = [352.75 in, 7.125 in])
        g22_2 = line(start = [352.75 in, 7.125 in], end = [351.25 in, 7.875 in])
        g22_3 = line(start = [351.25 in, 7.875 in], end = [351.25 in, 3.5 in])
    }
    feature gable_studs = extrude(profile = sketch.gable_studs_s, distance = 1.5 in, suppressed = true)
    sketch plates_pos_s on plane.face_pos {
        p0_0 = line(start = [0 in, 0.5 in], end = [8 in, 0.5 in])
        p0_1 = line(start = [8 in, 0.5 in], end = [8 in, 7.5 in])
        p0_2 = line(start = [8 in, 7.5 in], end = [0.2988 in, 7.5 in])
        p0_3 = line(start = [0.2988 in, 7.5 in], end = [0 in, 7.3506 in])
        p0_4 = line(start = [0 in, 7.3506 in], end = [0 in, 0.5 in])
        p1_0 = line(start = [352 in, 0.5 in], end = [360 in, 0.5 in])
        p1_1 = line(start = [360 in, 0.5 in], end = [360 in, 7.3506 in])
        p1_2 = line(start = [360 in, 7.3506 in], end = [359.7012 in, 7.5 in])
        p1_3 = line(start = [359.7012 in, 7.5 in], end = [352 in, 7.5 in])
        p1_4 = line(start = [352 in, 7.5 in], end = [352 in, 0.5 in])
        p2_0 = line(start = [174 in, 88.5 in], end = [186 in, 88.5 in])
        p2_1 = line(start = [186 in, 88.5 in], end = [186 in, 94.3506 in])
        p2_2 = line(start = [186 in, 94.3506 in], end = [180.7012 in, 97 in])
        p2_3 = line(start = [180.7012 in, 97 in], end = [179.2988 in, 97 in])
        p2_4 = line(start = [179.2988 in, 97 in], end = [174 in, 94.3506 in])
        p2_5 = line(start = [174 in, 94.3506 in], end = [174 in, 88.5 in])
        p3_0 = line(start = [112 in, 0.5 in], end = [128 in, 0.5 in])
        p3_1 = line(start = [128 in, 0.5 in], end = [128 in, 6 in])
        p3_2 = line(start = [128 in, 6 in], end = [112 in, 6 in])
        p3_3 = line(start = [112 in, 6 in], end = [112 in, 0.5 in])
        p4_0 = line(start = [232 in, 0.5 in], end = [248 in, 0.5 in])
        p4_1 = line(start = [248 in, 0.5 in], end = [248 in, 6 in])
        p4_2 = line(start = [248 in, 6 in], end = [232 in, 6 in])
        p4_3 = line(start = [232 in, 6 in], end = [232 in, 0.5 in])
        p5_0 = line(start = [85 in, 44.5 in], end = [95 in, 44.5 in])
        p5_1 = line(start = [95 in, 44.5 in], end = [95 in, 51.5 in])
        p5_2 = line(start = [95 in, 51.5 in], end = [88.2988 in, 51.5 in])
        p5_3 = line(start = [88.2988 in, 51.5 in], end = [85 in, 49.8506 in])
        p5_4 = line(start = [85 in, 49.8506 in], end = [85 in, 44.5 in])
        p6_0 = line(start = [265 in, 44.5 in], end = [275 in, 44.5 in])
        p6_1 = line(start = [275 in, 44.5 in], end = [275 in, 49.8506 in])
        p6_2 = line(start = [275 in, 49.8506 in], end = [271.7012 in, 51.5 in])
        p6_3 = line(start = [271.7012 in, 51.5 in], end = [265 in, 51.5 in])
        p6_4 = line(start = [265 in, 51.5 in], end = [265 in, 44.5 in])
    }
    feature plates_pos = extrude(profile = sketch.plates_pos_s, distance = 0.036 in)
    sketch plates_neg_s on plane.face_neg {
        p0_0 = line(start = [0 in, 0.5 in], end = [8 in, 0.5 in])
        p0_1 = line(start = [8 in, 0.5 in], end = [8 in, 7.5 in])
        p0_2 = line(start = [8 in, 7.5 in], end = [0.2988 in, 7.5 in])
        p0_3 = line(start = [0.2988 in, 7.5 in], end = [0 in, 7.3506 in])
        p0_4 = line(start = [0 in, 7.3506 in], end = [0 in, 0.5 in])
        p1_0 = line(start = [352 in, 0.5 in], end = [360 in, 0.5 in])
        p1_1 = line(start = [360 in, 0.5 in], end = [360 in, 7.3506 in])
        p1_2 = line(start = [360 in, 7.3506 in], end = [359.7012 in, 7.5 in])
        p1_3 = line(start = [359.7012 in, 7.5 in], end = [352 in, 7.5 in])
        p1_4 = line(start = [352 in, 7.5 in], end = [352 in, 0.5 in])
        p2_0 = line(start = [174 in, 88.5 in], end = [186 in, 88.5 in])
