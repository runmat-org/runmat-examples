    }
    feature plates_neg = extrude(profile = sketch.plates_neg_s, distance = 0.036 in)

    output roof_truss = {
        body = feature.bottom_chord.body
        part_number = "TR-30C"
        material = material.douglas_fir_lumber
    }
    assign material.galvanized_steel to feature.plates_pos.body
    assign material.galvanized_steel to feature.plates_neg.body
    region bearing : face = {
        select = [feature.bottom_chord.face.side(bottom_chord_s.e0)]
        expect = exactly_one
        label = "Bottom chord bearing"
    }
    configuration common = { part_number = "TR-30C", description = "Common truss, Fink, 30 ft span, 6:12" }
    configuration gable_end = {
        suppress = [
            feature.plates_neg,
            feature.plates_pos,
            feature.web_1,
            feature.web_1_fit,
            feature.web_2,
            feature.web_2_cope,
            feature.web_2_fit,
            feature.web_3,
            feature.web_3_cope,
            feature.web_3_fit,
            feature.web_4,
            feature.web_4_fit,
        ]
        features = { gable_studs = { suppressed = false } }
        part_number = "TR-30G"
        description = "Gable-end truss, studs at 16 in o.c."
    }
}
