// The shear-wall sheathing of one exterior wall: 7/16 in OSB on the outside face of the studs,
// panels at most 4 ft wide with 1/8 in gaps at the joints, every joint on a full-height stud,
// cut at the rough openings. The second-floor panels run down over the rim board to tie the
// floors. Nailing (DESIGN-NOTES, "Shear walls"): 8d common (0.131 x 2 1/2 in) at 6 in o.c. at
// panel edges and 12 in o.c. in the field; the regions name the faces each schedule applies to.
// Local axes as wall_framing: x along the wall, y inward (the panel is at y < 0), z up.
part shear_wall {
    input x0 : length = -0.4375 in
    input x1 : length = 480.4375 in
    input z0 : length = 0 in
    input z1 : length = 109.125 in
    input j1 : length = 32 in
    input j2 : length = 80 in
    input j3 : length = 128 in
    input j4 : length = 176 in
    input j5 : length = 224 in
    input j6 : length = 272 in
    input j7 : length = 320 in
    input j8 : length = 368 in
    input j9 : length = 416 in
    input j10 : length = 464 in
    input o1_l : length = 53.75 in
    input o1_r : length = 114.25 in
    input o1_b : length = 22 in
    input o1_t : length = 82.5 in
    input o2_l : length = 202.75 in
    input o2_r : length = 240.75 in
    input o2_b : length = 0 in
    input o2_t : length = 82.5 in
    input o3_l : length = 311.75 in
    input o3_r : length = 348.25 in
    input o3_b : length = 22 in
    input o3_t : length = 82.5 in
    input o4_l : length = 391.75 in
    input o4_r : length = 428.25 in
    input o4_b : length = 22 in
    input o4_t : length = 82.5 in
    feature face = plane.offset(base = origin.zx, distance = -0.4375 in)
    sketch osb_s on plane.face {
        e0 = line(start = [input.z0, input.x0], end = [input.z1, input.x0])
        e1 = line(start = [input.z1, input.x0], end = [input.z1, input.j1 - 0.0625 in])
        e2 = line(start = [input.z1, input.j1 - 0.0625 in], end = [input.z0, input.j1 - 0.0625 in])
        e3 = line(start = [input.z0, input.j1 - 0.0625 in], end = [input.z0, input.x0])
    }
    feature osb = extrude(profile = sketch.osb_s, distance = 0.4375 in, mode = new)
    sketch rest_s on plane.face {
        e0 = line(start = [input.z0, input.j1 + 0.0625 in], end = [input.z1, input.j1 + 0.0625 in])
        e1 = line(start = [input.z1, input.j1 + 0.0625 in], end = [input.z1, input.x1])
        e2 = line(start = [input.z1, input.x1], end = [input.z0, input.x1])
        e3 = line(start = [input.z0, input.x1], end = [input.z0, input.j1 + 0.0625 in])
    }
    feature rest = extrude(profile = sketch.rest_s, distance = 0.4375 in, mode = new)
    sketch j2_s on plane.face {
        e0 = line(start = [input.z0, input.j2 - 0.0625 in], end = [input.z1, input.j2 - 0.0625 in])
        e1 = line(start = [input.z1, input.j2 - 0.0625 in], end = [input.z1, input.j2 + 0.0625 in])
        e2 = line(start = [input.z1, input.j2 + 0.0625 in], end = [input.z0, input.j2 + 0.0625 in])
        e3 = line(start = [input.z0, input.j2 + 0.0625 in], end = [input.z0, input.j2 - 0.0625 in])
    }
    feature j2 = extrude(profile = sketch.j2_s, distance = 0.4375 in, mode = cut)
    sketch j3_s on plane.face {
        e0 = line(start = [input.z0, input.j3 - 0.0625 in], end = [input.z1, input.j3 - 0.0625 in])
        e1 = line(start = [input.z1, input.j3 - 0.0625 in], end = [input.z1, input.j3 + 0.0625 in])
        e2 = line(start = [input.z1, input.j3 + 0.0625 in], end = [input.z0, input.j3 + 0.0625 in])
        e3 = line(start = [input.z0, input.j3 + 0.0625 in], end = [input.z0, input.j3 - 0.0625 in])
    }
    feature j3 = extrude(profile = sketch.j3_s, distance = 0.4375 in, mode = cut)
    sketch j4_s on plane.face {
        e0 = line(start = [input.z0, input.j4 - 0.0625 in], end = [input.z1, input.j4 - 0.0625 in])
        e1 = line(start = [input.z1, input.j4 - 0.0625 in], end = [input.z1, input.j4 + 0.0625 in])
        e2 = line(start = [input.z1, input.j4 + 0.0625 in], end = [input.z0, input.j4 + 0.0625 in])
        e3 = line(start = [input.z0, input.j4 + 0.0625 in], end = [input.z0, input.j4 - 0.0625 in])
    }
    feature j4 = extrude(profile = sketch.j4_s, distance = 0.4375 in, mode = cut)
    sketch j5_s on plane.face {
        e0 = line(start = [input.z0, input.j5 - 0.0625 in], end = [input.z1, input.j5 - 0.0625 in])
        e1 = line(start = [input.z1, input.j5 - 0.0625 in], end = [input.z1, input.j5 + 0.0625 in])
        e2 = line(start = [input.z1, input.j5 + 0.0625 in], end = [input.z0, input.j5 + 0.0625 in])
        e3 = line(start = [input.z0, input.j5 + 0.0625 in], end = [input.z0, input.j5 - 0.0625 in])
    }
    feature j5 = extrude(profile = sketch.j5_s, distance = 0.4375 in, mode = cut)
    sketch j6_s on plane.face {
        e0 = line(start = [input.z0, input.j6 - 0.0625 in], end = [input.z1, input.j6 - 0.0625 in])
        e1 = line(start = [input.z1, input.j6 - 0.0625 in], end = [input.z1, input.j6 + 0.0625 in])
        e2 = line(start = [input.z1, input.j6 + 0.0625 in], end = [input.z0, input.j6 + 0.0625 in])
        e3 = line(start = [input.z0, input.j6 + 0.0625 in], end = [input.z0, input.j6 - 0.0625 in])
    }
    feature j6 = extrude(profile = sketch.j6_s, distance = 0.4375 in, mode = cut)
    sketch j7_s on plane.face {
        e0 = line(start = [input.z0, input.j7 - 0.0625 in], end = [input.z1, input.j7 - 0.0625 in])
        e1 = line(start = [input.z1, input.j7 - 0.0625 in], end = [input.z1, input.j7 + 0.0625 in])
        e2 = line(start = [input.z1, input.j7 + 0.0625 in], end = [input.z0, input.j7 + 0.0625 in])
        e3 = line(start = [input.z0, input.j7 + 0.0625 in], end = [input.z0, input.j7 - 0.0625 in])
    }
    feature j7 = extrude(profile = sketch.j7_s, distance = 0.4375 in, mode = cut)
    sketch j8_s on plane.face {
        e0 = line(start = [input.z0, input.j8 - 0.0625 in], end = [input.z1, input.j8 - 0.0625 in])
        e1 = line(start = [input.z1, input.j8 - 0.0625 in], end = [input.z1, input.j8 + 0.0625 in])
        e2 = line(start = [input.z1, input.j8 + 0.0625 in], end = [input.z0, input.j8 + 0.0625 in])
        e3 = line(start = [input.z0, input.j8 + 0.0625 in], end = [input.z0, input.j8 - 0.0625 in])
    }
    feature j8 = extrude(profile = sketch.j8_s, distance = 0.4375 in, mode = cut)
    sketch j9_s on plane.face {
        e0 = line(start = [input.z0, input.j9 - 0.0625 in], end = [input.z1, input.j9 - 0.0625 in])
        e1 = line(start = [input.z1, input.j9 - 0.0625 in], end = [input.z1, input.j9 + 0.0625 in])
        e2 = line(start = [input.z1, input.j9 + 0.0625 in], end = [input.z0, input.j9 + 0.0625 in])
        e3 = line(start = [input.z0, input.j9 + 0.0625 in], end = [input.z0, input.j9 - 0.0625 in])
    }
    feature j9 = extrude(profile = sketch.j9_s, distance = 0.4375 in, mode = cut)
    sketch j10_s on plane.face {
        e0 = line(start = [input.z0, input.j10 - 0.0625 in], end = [input.z1, input.j10 - 0.0625 in])
        e1 = line(start = [input.z1, input.j10 - 0.0625 in], end = [input.z1, input.j10 + 0.0625 in])
        e2 = line(start = [input.z1, input.j10 + 0.0625 in], end = [input.z0, input.j10 + 0.0625 in])
        e3 = line(start = [input.z0, input.j10 + 0.0625 in], end = [input.z0, input.j10 - 0.0625 in])
    }
    feature j10 = extrude(profile = sketch.j10_s, distance = 0.4375 in, mode = cut)
    sketch o1_s on plane.face {
        e0 = line(start = [input.o1_b, input.o1_l], end = [input.o1_t, input.o1_l])
        e1 = line(start = [input.o1_t, input.o1_l], end = [input.o1_t, input.o1_r])
        e2 = line(start = [input.o1_t, input.o1_r], end = [input.o1_b, input.o1_r])
        e3 = line(start = [input.o1_b, input.o1_r], end = [input.o1_b, input.o1_l])
    }
    feature o1 = extrude(profile = sketch.o1_s, distance = 0.4375 in, mode = cut)
    sketch o2_s on plane.face {
        e0 = line(start = [input.o2_b, input.o2_l], end = [input.o2_t, input.o2_l])
        e1 = line(start = [input.o2_t, input.o2_l], end = [input.o2_t, input.o2_r])
        e2 = line(start = [input.o2_t, input.o2_r], end = [input.o2_b, input.o2_r])
        e3 = line(start = [input.o2_b, input.o2_r], end = [input.o2_b, input.o2_l])
    }
    feature o2 = extrude(profile = sketch.o2_s, distance = 0.4375 in, mode = cut)
    sketch o3_s on plane.face {
        e0 = line(start = [input.o3_b, input.o3_l], end = [input.o3_t, input.o3_l])
        e1 = line(start = [input.o3_t, input.o3_l], end = [input.o3_t, input.o3_r])
        e2 = line(start = [input.o3_t, input.o3_r], end = [input.o3_b, input.o3_r])
        e3 = line(start = [input.o3_b, input.o3_r], end = [input.o3_b, input.o3_l])
    }
    feature o3 = extrude(profile = sketch.o3_s, distance = 0.4375 in, mode = cut)
    sketch o4_s on plane.face {
        e0 = line(start = [input.o4_b, input.o4_l], end = [input.o4_t, input.o4_l])
        e1 = line(start = [input.o4_t, input.o4_l], end = [input.o4_t, input.o4_r])
        e2 = line(start = [input.o4_t, input.o4_r], end = [input.o4_b, input.o4_r])
        e3 = line(start = [input.o4_b, input.o4_r], end = [input.o4_b, input.o4_l])
    }
    feature o4 = extrude(profile = sketch.o4_s, distance = 0.4375 in, mode = cut)

    // MEP penetrations for wall_5_l1: bored holes and box cut-outs where the runs pass
    feature mep_wall_5_l1_p_xy_1 = plane.offset(base = origin.xy, distance = 11.125 in)
    feature mep_wall_5_l1_p_zx_0 = plane.offset(base = origin.zx, distance = -8 in)
    sketch mep_wall_5_l1_0_s on plane.mep_wall_5_l1_p_zx_0 {
        c = circle(center = [12 in, 172.5 in], radius = 1 in)
    }
    feature mep_wall_5_l1_0 = extrude(profile = sketch.mep_wall_5_l1_0_s, distance = 11.625 in, mode = cut, suppressed = true)
    sketch mep_wall_5_l1_1_s on plane.mep_wall_5_l1_p_xy_1 {
        c = circle(center = [172.5 in, 2.75 in], radius = 1 in)
    }
    feature mep_wall_5_l1_1 = extrude(profile = sketch.mep_wall_5_l1_1_s, distance = 105.75 in, mode = cut, suppressed = true)
    // end MEP penetrations wall_5_l1
    // MEP penetrations for wall_a_l1: bored holes and box cut-outs where the runs pass
    feature mep_wall_a_l1_p_zx_0 = plane.offset(base = origin.zx, distance = -1.375 in)
    sketch mep_wall_a_l1_0_s on plane.mep_wall_a_l1_p_zx_0 {
        c = circle(center = [60 in, 358 in], radius = 1.25 in)
    }
    feature mep_wall_a_l1_0 = extrude(profile = sketch.mep_wall_a_l1_0_s, distance = 15.375 in, mode = cut, suppressed = true)
    // end MEP penetrations wall_a_l1
    // MEP penetrations for wall_d_l2: bored holes and box cut-outs where the runs pass
    feature mep_wall_d_l2_p_xy_0 = plane.offset(base = origin.xy, distance = -6.4198 in)
    sketch mep_wall_d_l2_0_s on plane.mep_wall_d_l2_p_xy_0 {
        c = circle(center = [346.5 in, 4 in], radius = 1.05 in)
    }
    feature mep_wall_d_l2_0 = extrude(profile = sketch.mep_wall_d_l2_0_s, distance = 109.6198 in, mode = cut, suppressed = true)
    // end MEP penetrations wall_d_l2
    output shear_wall = { body = feature.osb.body, part_number = "SW-A1", material = material.osb }
    region field_nailing : face = { select = [feature.osb.face.start, feature.rest.face.start], expect = one_or_more, label = "Field nailing, 8d common at 12 in o.c." }
    region edge_nailing : face = { select = [feature.osb.face.side(osb_s.e0), feature.osb.face.side(osb_s.e1), feature.osb.face.side(osb_s.e2), feature.osb.face.side(osb_s.e3), feature.rest.face.side(rest_s.e0), feature.rest.face.side(rest_s.e1), feature.rest.face.side(rest_s.e2), feature.rest.face.side(rest_s.e3)], expect = one_or_more, label = "Edge nailing, 8d common at 6 in o.c., 3/8 in from panel edges" }

    configuration wall_a_l1 = {
        x0 = -0.4375 in, x1 = 480.4375 in, z0 = 0 in, z1 = 109.125 in, j1 = 32 in, j2 = 80 in, j3 = 128 in, j4 = 176 in, j5 = 224 in, j6 = 272 in, j7 = 320 in, j8 = 368 in, j9 = 416 in, j10 = 464 in
        o1_l = 53.75 in, o1_r = 114.25 in, o1_b = 22 in, o1_t = 82.5 in, o2_l = 202.75 in, o2_r = 240.75 in, o2_b = 0 in, o2_t = 82.5 in, o3_l = 311.75 in, o3_r = 348.25 in, o3_b = 22 in, o3_t = 82.5 in, o4_l = 391.75 in, o4_r = 428.25 in, o4_b = 22 in, o4_t = 82.5 in
        features = { mep_wall_a_l1_0 = { suppressed = false } }
        part_number = "SW-A1", description = "South (grid A) shear wall, first floor"
    }
    configuration wall_d_l1 = {
        x0 = -0.4375 in, x1 = 480.4375 in, z0 = 0 in, z1 = 109.125 in, j1 = 32 in, j2 = 80 in, j3 = 128 in, j4 = 176 in, j5 = 224 in, j6 = 272 in, j7 = 320 in, j8 = 368 in, j9 = 416 in, j10 = 464 in
        o1_l = 75.75 in, o1_r = 124.25 in, o1_b = 46 in, o1_t = 82.5 in, o2_l = 223.25 in, o2_r = 297.25 in, o2_b = 0 in, o2_t = 82.5 in, o3_l = 381.75 in, o3_r = 418.25 in, o3_b = 22 in, o3_t = 82.5 in, o4_l = 100 in, o4_r = 136 in, o4_b = 22 in, o4_t = 82.5 in
        suppress = [feature.o4]
        part_number = "SW-D1", description = "North (grid D) shear wall, first floor"
    }
    configuration wall_1_l1 = {
        x0 = -5.5 in, x1 = 354.5 in, z0 = 0 in, z1 = 109.125 in, j1 = 26.5 in, j2 = 74.5 in, j3 = 122.5 in, j4 = 170.5 in, j5 = 218.5 in, j6 = 266.5 in, j7 = 314.5 in, j8 = 360 in, j9 = 408 in, j10 = 456 in
        o1_l = 71.75 in, o1_r = 108.25 in, o1_b = 22 in, o1_t = 82.5 in, o2_l = 249.75 in, o2_r = 286.25 in, o2_b = 22 in, o2_t = 82.5 in, o3_l = 100 in, o3_r = 136 in, o3_b = 22 in, o3_t = 82.5 in, o4_l = 100 in, o4_r = 136 in, o4_b = 22 in, o4_t = 82.5 in
        suppress = [feature.j8, feature.j9, feature.j10, feature.o3, feature.o4]
        part_number = "SW-11", description = "West (grid 1) shear wall, first floor"
    }
    configuration wall_5_l1 = {
        x0 = -5.5 in, x1 = 354.5 in, z0 = 0 in, z1 = 109.125 in, j1 = 34.5 in, j2 = 82.5 in, j3 = 130.5 in, j4 = 178.5 in, j5 = 226.5 in, j6 = 274.5 in, j7 = 322.5 in, j8 = 360 in, j9 = 408 in, j10 = 456 in
        o1_l = 62.75 in, o1_r = 99.25 in, o1_b = 22 in, o1_t = 82.5 in, o2_l = 271.75 in, o2_r = 308.25 in, o2_b = 22 in, o2_t = 82.5 in, o3_l = 100 in, o3_r = 136 in, o3_b = 22 in, o3_t = 82.5 in, o4_l = 100 in, o4_r = 136 in, o4_b = 22 in, o4_t = 82.5 in
        suppress = [feature.j8, feature.j9, feature.j10, feature.o3, feature.o4]
        features = { mep_wall_5_l1_0 = { suppressed = false }, mep_wall_5_l1_1 = { suppressed = false } }
        part_number = "SW-51", description = "East (grid 5) shear wall, first floor"
    }
    configuration wall_a_l2 = {
        x0 = -0.4375 in, x1 = 480.4375 in, z0 = -12.625 in, z1 = 97.125 in, j1 = 32 in, j2 = 80 in, j3 = 128 in, j4 = 176 in, j5 = 224 in, j6 = 272 in, j7 = 320 in, j8 = 368 in, j9 = 416 in, j10 = 464 in
        o1_l = 51.75 in, o1_r = 88.25 in, o1_b = 34.375 in, o1_t = 82.875 in, o2_l = 151.75 in, o2_r = 188.25 in, o2_b = 34.375 in, o2_t = 82.875 in, o3_l = 291.75 in, o3_r = 328.25 in, o3_b = 34.375 in, o3_t = 82.875 in, o4_l = 391.75 in, o4_r = 428.25 in, o4_b = 34.375 in, o4_t = 82.875 in
        part_number = "SW-A2", description = "South (grid A) shear wall, second floor"
    }
    configuration wall_d_l2 = {
        x0 = -0.4375 in, x1 = 480.4375 in, z0 = -12.625 in, z1 = 97.125 in, j1 = 32 in, j2 = 80 in, j3 = 128 in, j4 = 176 in, j5 = 224 in, j6 = 272 in, j7 = 320 in, j8 = 368 in, j9 = 416 in, j10 = 464 in
        o1_l = 51.75 in, o1_r = 88.25 in, o1_b = 34.375 in, o1_t = 82.875 in, o2_l = 157.75 in, o2_r = 182.25 in, o2_b = 46.375 in, o2_t = 82.875 in, o3_l = 297.75 in, o3_r = 322.25 in, o3_b = 46.375 in, o3_t = 82.875 in, o4_l = 391.75 in, o4_r = 428.25 in, o4_b = 34.375 in, o4_t = 82.875 in
        features = { mep_wall_d_l2_0 = { suppressed = false } }
        part_number = "SW-D2", description = "North (grid D) shear wall, second floor"
    }
    configuration wall_1_l2 = {
        x0 = -5.5 in, x1 = 354.5 in, z0 = -12.625 in, z1 = 97.125 in, j1 = 26.5 in, j2 = 74.5 in, j3 = 122.5 in, j4 = 170.5 in, j5 = 218.5 in, j6 = 266.5 in, j7 = 314.5 in, j8 = 360 in, j9 = 408 in, j10 = 456 in
        o1_l = 71.75 in, o1_r = 108.25 in, o1_b = 34.375 in, o1_t = 82.875 in, o2_l = 249.75 in, o2_r = 286.25 in, o2_b = 34.375 in, o2_t = 82.875 in, o3_l = 100 in, o3_r = 136 in, o3_b = 22 in, o3_t = 82.5 in, o4_l = 100 in, o4_r = 136 in, o4_b = 22 in, o4_t = 82.5 in
        suppress = [feature.j8, feature.j9, feature.j10, feature.o3, feature.o4]
        part_number = "SW-12", description = "West (grid 1) shear wall, second floor"
    }
    configuration wall_5_l2 = {
        x0 = -5.5 in, x1 = 354.5 in, z0 = -12.625 in, z1 = 97.125 in, j1 = 34.5 in, j2 = 82.5 in, j3 = 130.5 in, j4 = 178.5 in, j5 = 226.5 in, j6 = 274.5 in, j7 = 322.5 in, j8 = 360 in, j9 = 408 in, j10 = 456 in
        o1_l = 62.75 in, o1_r = 99.25 in, o1_b = 34.375 in, o1_t = 82.875 in, o2_l = 271.75 in, o2_r = 308.25 in, o2_b = 34.375 in, o2_t = 82.875 in, o3_l = 100 in, o3_r = 136 in, o3_b = 22 in, o3_t = 82.5 in, o4_l = 100 in, o4_r = 136 in, o4_b = 22 in, o4_t = 82.5 in
        suppress = [feature.j8, feature.j9, feature.j10, feature.o3, feature.o4]
        part_number = "SW-52", description = "East (grid 5) shear wall, second floor"
    }
}
