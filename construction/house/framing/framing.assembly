    }
    pattern ties_south = linear(seeds = [tie_south], direction = [1, 0, 0], spacing = 24 in, count = 19)
    pattern ties_north = linear(seeds = [tie_north], direction = [1, 0, 0], spacing = 24 in, count = 19)
    // Joist hangers on the beams, the stair header and the trimmers
