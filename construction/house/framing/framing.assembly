    use part post_base from hardware as post_base_b4 {
        placement = { placement = attach, own = { anchor = origin }, to = { frame = interface, part = house_skeleton, from = "..", name = post_b4 } }
    }
    use part post as post_b4 {
        placement = { placement = offset, offset = { translation = [360 in, 144 in, 1 in] } }
    }
    use part post_base from hardware as post_base_c2 {
        placement = { placement = attach, own = { anchor = origin }, to = { frame = interface, part = house_skeleton, from = "..", name = post_c2 } }
    }
    use part post as post_c2 {
        placement = { placement = offset, offset = { translation = [120 in, 224 in, 1 in] } }
    }
    use part post_base from hardware as post_base_c3 {
        placement = { placement = attach, own = { anchor = origin }, to = { frame = interface, part = house_skeleton, from = "..", name = post_c3 } }
