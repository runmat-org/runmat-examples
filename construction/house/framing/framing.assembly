// The structure above the foundation: the exterior walls of both floors with their shear-wall
// sheathing, the second-floor framing on its beams and posts, the roof trusses at 24 in o.c., and
// the connectors of the load path (anchor bolts, hold-downs, joist hangers, truss ties). Walls,
// floor, roof and posts attach to the skeleton frames; hardware is placed at its stations.
import { wall_framing } from "./wall_framing.part"
import { shear_wall } from "./shear_wall.part"
import { floor_system } from "./floor_system.part"
import { post_base } from "../+hardware/post_base.part"
import { post } from "./post.part"
import { roof_truss } from "./roof_truss.part"
import { truss_tie } from "../+hardware/truss_tie.part"
import { joist_hanger } from "../+hardware/joist_hanger.part"
import { anchor_bolt } from "../+hardware/anchor_bolt.part"
import { hold_down } from "../+hardware/hold_down.part"
import { house_skeleton } from "../house_skeleton.part"

assembly framing {
