        placement = { placement = attach, own = { anchor = origin }, to = { frame = interface, part = house_skeleton, from = "..", name = post_b3 } }
    }
    use part post as post_b3 {
        placement = { placement = offset, offset = { translation = [232 in, 144 in, 1 in] } }
