runmat 0.7
std 1

// The structure above the foundation: the exterior walls of both floors with their shear-wall
// sheathing, the second-floor framing on its beams and posts, the roof trusses at 24 in o.c., and
// the connectors of the load path (anchor bolts, hold-downs, joist hangers, truss ties). Walls,
// floor, roof and posts attach to the skeleton frames; hardware is placed at its stations.
assembly framing {
    // Walls and shear walls, one configuration per wall line and level
    use part wall_framing as wall_a_l1 {
        configuration = { select = named, name = wall_a_l1 }
        placement = { placement = attach, own = { anchor = origin }, to = { frame = interface, part = house_skeleton, from = "..", name = wall_a_l1 } }
    }
    use part shear_wall as sheathing_a_l1 {
        configuration = { select = named, name = wall_a_l1 }
        placement = { placement = attach, own = { anchor = origin }, to = { frame = interface, part = house_skeleton, from = "..", name = wall_a_l1 } }
    }
    use part wall_framing as wall_d_l1 {
        configuration = { select = named, name = wall_d_l1 }
        placement = { placement = attach, own = { anchor = origin }, to = { frame = interface, part = house_skeleton, from = "..", name = wall_d_l1 } }
    }
    use part shear_wall as sheathing_d_l1 {
        configuration = { select = named, name = wall_d_l1 }
        placement = { placement = attach, own = { anchor = origin }, to = { frame = interface, part = house_skeleton, from = "..", name = wall_d_l1 } }
    }
    use part wall_framing as wall_1_l1 {
        configuration = { select = named, name = wall_1_l1 }
        placement = { placement = attach, own = { anchor = origin }, to = { frame = interface, part = house_skeleton, from = "..", name = wall_1_l1 } }
    }
    use part shear_wall as sheathing_1_l1 {
        configuration = { select = named, name = wall_1_l1 }
        placement = { placement = attach, own = { anchor = origin }, to = { frame = interface, part = house_skeleton, from = "..", name = wall_1_l1 } }
    }
    use part wall_framing as wall_5_l1 {
        configuration = { select = named, name = wall_5_l1 }
        placement = { placement = attach, own = { anchor = origin }, to = { frame = interface, part = house_skeleton, from = "..", name = wall_5_l1 } }
    }
    use part shear_wall as sheathing_5_l1 {
        configuration = { select = named, name = wall_5_l1 }
        placement = { placement = attach, own = { anchor = origin }, to = { frame = interface, part = house_skeleton, from = "..", name = wall_5_l1 } }
    }
    use part wall_framing as wall_a_l2 {
        configuration = { select = named, name = wall_a_l2 }
        placement = { placement = attach, own = { anchor = origin }, to = { frame = interface, part = house_skeleton, from = "..", name = wall_a_l2 } }
    }
    use part shear_wall as sheathing_a_l2 {
        configuration = { select = named, name = wall_a_l2 }
        placement = { placement = attach, own = { anchor = origin }, to = { frame = interface, part = house_skeleton, from = "..", name = wall_a_l2 } }
    }
    use part wall_framing as wall_d_l2 {
        configuration = { select = named, name = wall_d_l2 }
        placement = { placement = attach, own = { anchor = origin }, to = { frame = interface, part = house_skeleton, from = "..", name = wall_d_l2 } }
    }
    use part shear_wall as sheathing_d_l2 {
        configuration = { select = named, name = wall_d_l2 }
        placement = { placement = attach, own = { anchor = origin }, to = { frame = interface, part = house_skeleton, from = "..", name = wall_d_l2 } }
    }
    use part wall_framing as wall_1_l2 {
        configuration = { select = named, name = wall_1_l2 }
        placement = { placement = attach, own = { anchor = origin }, to = { frame = interface, part = house_skeleton, from = "..", name = wall_1_l2 } }
    }
    use part shear_wall as sheathing_1_l2 {
        configuration = { select = named, name = wall_1_l2 }
        placement = { placement = attach, own = { anchor = origin }, to = { frame = interface, part = house_skeleton, from = "..", name = wall_1_l2 } }
    }
    use part wall_framing as wall_5_l2 {
        configuration = { select = named, name = wall_5_l2 }
        placement = { placement = attach, own = { anchor = origin }, to = { frame = interface, part = house_skeleton, from = "..", name = wall_5_l2 } }
    }
    use part shear_wall as sheathing_5_l2 {
        configuration = { select = named, name = wall_5_l2 }
        placement = { placement = attach, own = { anchor = origin }, to = { frame = interface, part = house_skeleton, from = "..", name = wall_5_l2 } }
    }
    // Second floor, posts and roof
    use part floor_system as floor_l2 {
        placement = { placement = attach, own = { anchor = origin }, to = { frame = interface, part = house_skeleton, from = "..", name = floor_l2 } }
    }
    use part post_base from hardware as post_base_b2 {
        placement = { placement = attach, own = { anchor = origin }, to = { frame = interface, part = house_skeleton, from = "..", name = post_b2 } }
