        placement = { placement = offset, offset = { translation = [16 in, 145.75 in, 109.125 in] } }
    }
    pattern hangers_b = linear(seeds = [hangers_b_0], direction = [1, 0, 0], spacing = 16 in, count = 29, skip = [{ instance = linear, step = 9 }])
    use part joist_hanger from hardware as hangers_c_0 {
        configuration = { select = named, name = single }
        placement = { placement = offset, offset = { translation = [16 in, 222.25 in, 109.125 in], rotation = { rotation = axis_angle, axis = [0, 0, 1], angle = 180 deg } } }
    }
    pattern hangers_c = linear(seeds = [hangers_c_0], direction = [1, 0, 0], spacing = 16 in, count = 29, skip = [{ instance = linear, step = 9 }, { instance = linear, step = 10 }, { instance = linear, step = 11 }, { instance = linear, step = 12 }, { instance = linear, step = 13 }, { instance = linear, step = 14 }, { instance = linear, step = 15 }, { instance = linear, step = 16 }, { instance = linear, step = 17 }])
    use part joist_hanger from hardware as hangers_cd_0 {
        configuration = { select = named, name = single }
        placement = { placement = offset, offset = { translation = [16 in, 225.75 in, 109.125 in] } }
