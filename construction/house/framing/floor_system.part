// The second-floor framing, from the top of the first-floor top plates: 11 7/8 in I-joists at
// 16 in o.c. spanning north-south, a 1 1/8 in rim board all round, two flush 3 1/2 x 11 7/8 in
// LVL beams on grids B and C (on posts at grids 2, 3 and 4 and on the end walls), the stair
// opening between them with doubled trimmers, an LVL header and tail joists, and 3/4 in
// tongue-and-groove subfloor. Joists hang from the beams on face-mount hangers (framing.assembly).
part floor_system {
    input spacing : length = 16 in
    feature y_ab = plane.offset(base = origin.zx, distance = 1.125 in)
    feature y_bc = plane.offset(base = origin.zx, distance = 145.8125 in)
    feature y_cd = plane.offset(base = origin.zx, distance = 225.8125 in)
    feature y_tail = plane.offset(base = origin.zx, distance = 145.8125 in)
    feature y_hdr = plane.offset(base = origin.zx, distance = 178.5 in)
    // Rim boards
    sketch rim_s_s on origin.xy {
        e0 = line(start = [0 in, 0 in], end = [480 in, 0 in])
        e1 = line(start = [480 in, 0 in], end = [480 in, 1.125 in])
        e2 = line(start = [480 in, 1.125 in], end = [0 in, 1.125 in])
        e3 = line(start = [0 in, 1.125 in], end = [0 in, 0 in])
    }
    feature rim_s = extrude(profile = sketch.rim_s_s, distance = 11.875 in, mode = new)
    sketch rim_n_s on origin.xy {
        e0 = line(start = [0 in, 358.875 in], end = [480 in, 358.875 in])
        e1 = line(start = [480 in, 358.875 in], end = [480 in, 360 in])
        e2 = line(start = [480 in, 360 in], end = [0 in, 360 in])
        e3 = line(start = [0 in, 360 in], end = [0 in, 358.875 in])
    }
    feature rim_n = extrude(profile = sketch.rim_n_s, distance = 11.875 in, mode = new)
    sketch rim_w_s on origin.xy {
        e0 = line(start = [0 in, 1.125 in], end = [1.125 in, 1.125 in])
        e1 = line(start = [1.125 in, 1.125 in], end = [1.125 in, 358.875 in])
        e2 = line(start = [1.125 in, 358.875 in], end = [0 in, 358.875 in])
        e3 = line(start = [0 in, 358.875 in], end = [0 in, 1.125 in])
    }
    feature rim_w = extrude(profile = sketch.rim_w_s, distance = 11.875 in, mode = new)
    sketch rim_e_s on origin.xy {
        e0 = line(start = [478.875 in, 1.125 in], end = [480 in, 1.125 in])
        e1 = line(start = [480 in, 1.125 in], end = [480 in, 358.875 in])
        e2 = line(start = [480 in, 358.875 in], end = [478.875 in, 358.875 in])
        e3 = line(start = [478.875 in, 358.875 in], end = [478.875 in, 1.125 in])
    }
    feature rim_e = extrude(profile = sketch.rim_e_s, distance = 11.875 in, mode = new)
    // Flush beams on grids B and C
    sketch beam_b_s on origin.xy {
        e0 = line(start = [1.125 in, 142.25 in], end = [478.875 in, 142.25 in])
        e1 = line(start = [478.875 in, 142.25 in], end = [478.875 in, 145.75 in])
        e2 = line(start = [478.875 in, 145.75 in], end = [1.125 in, 145.75 in])
        e3 = line(start = [1.125 in, 145.75 in], end = [1.125 in, 142.25 in])
    }
    feature beam_b = extrude(profile = sketch.beam_b_s, distance = 11.875 in, mode = new)
    sketch beam_c_s on origin.xy {
        e0 = line(start = [1.125 in, 222.25 in], end = [478.875 in, 222.25 in])
        e1 = line(start = [478.875 in, 222.25 in], end = [478.875 in, 225.75 in])
        e2 = line(start = [478.875 in, 225.75 in], end = [1.125 in, 225.75 in])
        e3 = line(start = [1.125 in, 225.75 in], end = [1.125 in, 222.25 in])
    }
    feature beam_c = extrude(profile = sketch.beam_c_s, distance = 11.875 in, mode = new)
    // I-joists, one bay at a time: the first joist at 16 in, then the pattern
    sketch joist_ab_s on plane.y_ab {
        e0 = line(start = [0 in, 14.8438 in], end = [0 in, 17.1562 in])
        e1 = line(start = [0 in, 17.1562 in], end = [1.5 in, 17.1562 in])
        e2 = line(start = [1.5 in, 17.1562 in], end = [1.5 in, 16.1875 in])
        e3 = line(start = [1.5 in, 16.1875 in], end = [10.375 in, 16.1875 in])
        e4 = line(start = [10.375 in, 16.1875 in], end = [10.375 in, 17.1562 in])
        e5 = line(start = [10.375 in, 17.1562 in], end = [11.875 in, 17.1562 in])
        e6 = line(start = [11.875 in, 17.1562 in], end = [11.875 in, 14.8438 in])
        e7 = line(start = [11.875 in, 14.8438 in], end = [10.375 in, 14.8438 in])
        e8 = line(start = [10.375 in, 14.8438 in], end = [10.375 in, 15.8125 in])
        e9 = line(start = [10.375 in, 15.8125 in], end = [1.5 in, 15.8125 in])
        e10 = line(start = [1.5 in, 15.8125 in], end = [1.5 in, 14.8438 in])
        e11 = line(start = [1.5 in, 14.8438 in], end = [0 in, 14.8438 in])
    }
    feature joist_ab = extrude(profile = sketch.joist_ab_s, distance = 141.0625 in, mode = new)
    feature joists_ab = pattern(bodies = [feature.joist_ab.body], layout = linear(direction = origin.x, spacing = input.spacing, count = 29))
    sketch joist_bc_s on plane.y_bc {
        e0 = line(start = [0 in, 14.8438 in], end = [0 in, 17.1562 in])
        e1 = line(start = [0 in, 17.1562 in], end = [1.5 in, 17.1562 in])
        e2 = line(start = [1.5 in, 17.1562 in], end = [1.5 in, 16.1875 in])
        e3 = line(start = [1.5 in, 16.1875 in], end = [10.375 in, 16.1875 in])
        e4 = line(start = [10.375 in, 16.1875 in], end = [10.375 in, 17.1562 in])
        e5 = line(start = [10.375 in, 17.1562 in], end = [11.875 in, 17.1562 in])
        e6 = line(start = [11.875 in, 17.1562 in], end = [11.875 in, 14.8438 in])
        e7 = line(start = [11.875 in, 14.8438 in], end = [10.375 in, 14.8438 in])
        e8 = line(start = [10.375 in, 14.8438 in], end = [10.375 in, 15.8125 in])
        e9 = line(start = [10.375 in, 15.8125 in], end = [1.5 in, 15.8125 in])
        e10 = line(start = [1.5 in, 15.8125 in], end = [1.5 in, 14.8438 in])
        e11 = line(start = [1.5 in, 14.8438 in], end = [0 in, 14.8438 in])
    }
    feature joist_bc = extrude(profile = sketch.joist_bc_s, distance = 76.375 in, mode = new)
    feature joists_bc = pattern(bodies = [feature.joist_bc.body], layout = linear(direction = origin.x, spacing = input.spacing, count = 29), skip = [{ instance = linear, step = 9 }, { instance = linear, step = 10 }, { instance = linear, step = 11 }, { instance = linear, step = 12 }, { instance = linear, step = 13 }, { instance = linear, step = 14 }, { instance = linear, step = 15 }, { instance = linear, step = 16 }, { instance = linear, step = 17 }])
    sketch joist_cd_s on plane.y_cd {
        e0 = line(start = [0 in, 14.8438 in], end = [0 in, 17.1562 in])
        e1 = line(start = [0 in, 17.1562 in], end = [1.5 in, 17.1562 in])
        e2 = line(start = [1.5 in, 17.1562 in], end = [1.5 in, 16.1875 in])
        e3 = line(start = [1.5 in, 16.1875 in], end = [10.375 in, 16.1875 in])
        e4 = line(start = [10.375 in, 16.1875 in], end = [10.375 in, 17.1562 in])
        e5 = line(start = [10.375 in, 17.1562 in], end = [11.875 in, 17.1562 in])
        e6 = line(start = [11.875 in, 17.1562 in], end = [11.875 in, 14.8438 in])
        e7 = line(start = [11.875 in, 14.8438 in], end = [10.375 in, 14.8438 in])
        e8 = line(start = [10.375 in, 14.8438 in], end = [10.375 in, 15.8125 in])
        e9 = line(start = [10.375 in, 15.8125 in], end = [1.5 in, 15.8125 in])
        e10 = line(start = [1.5 in, 15.8125 in], end = [1.5 in, 14.8438 in])
        e11 = line(start = [1.5 in, 14.8438 in], end = [0 in, 14.8438 in])
    }
    feature joist_cd = extrude(profile = sketch.joist_cd_s, distance = 133.0625 in, mode = new)
    feature joists_cd = pattern(bodies = [feature.joist_cd.body], layout = linear(direction = origin.x, spacing = input.spacing, count = 29))
    // Stair opening: doubled trimmers, the LVL header and the tail joists
    sketch trimmer_0_s on plane.y_bc {
        e0 = line(start = [0 in, 159.375 in], end = [0 in, 161.6875 in])
        e1 = line(start = [0 in, 161.6875 in], end = [1.5 in, 161.6875 in])
        e2 = line(start = [1.5 in, 161.6875 in], end = [1.5 in, 160.7188 in])
        e3 = line(start = [1.5 in, 160.7188 in], end = [10.375 in, 160.7188 in])
        e4 = line(start = [10.375 in, 160.7188 in], end = [10.375 in, 161.6875 in])
        e5 = line(start = [10.375 in, 161.6875 in], end = [11.875 in, 161.6875 in])
        e6 = line(start = [11.875 in, 161.6875 in], end = [11.875 in, 159.375 in])
        e7 = line(start = [11.875 in, 159.375 in], end = [10.375 in, 159.375 in])
        e8 = line(start = [10.375 in, 159.375 in], end = [10.375 in, 160.3438 in])
        e9 = line(start = [10.375 in, 160.3438 in], end = [1.5 in, 160.3438 in])
        e10 = line(start = [1.5 in, 160.3438 in], end = [1.5 in, 159.375 in])
        e11 = line(start = [1.5 in, 159.375 in], end = [0 in, 159.375 in])
    }
    feature trimmer_0 = extrude(profile = sketch.trimmer_0_s, distance = 76.375 in, mode = new)
    sketch trimmer_1_s on plane.y_bc {
        e0 = line(start = [0 in, 161.6875 in], end = [0 in, 164 in])
        e1 = line(start = [0 in, 164 in], end = [1.5 in, 164 in])
        e2 = line(start = [1.5 in, 164 in], end = [1.5 in, 163.0312 in])
        e3 = line(start = [1.5 in, 163.0312 in], end = [10.375 in, 163.0312 in])
        e4 = line(start = [10.375 in, 163.0312 in], end = [10.375 in, 164 in])
        e5 = line(start = [10.375 in, 164 in], end = [11.875 in, 164 in])
        e6 = line(start = [11.875 in, 164 in], end = [11.875 in, 161.6875 in])
        e7 = line(start = [11.875 in, 161.6875 in], end = [10.375 in, 161.6875 in])
        e8 = line(start = [10.375 in, 161.6875 in], end = [10.375 in, 162.6562 in])
        e9 = line(start = [10.375 in, 162.6562 in], end = [1.5 in, 162.6562 in])
        e10 = line(start = [1.5 in, 162.6562 in], end = [1.5 in, 161.6875 in])
        e11 = line(start = [1.5 in, 161.6875 in], end = [0 in, 161.6875 in])
    }
    feature trimmer_1 = extrude(profile = sketch.trimmer_1_s, distance = 76.375 in, mode = new)
    sketch trimmer_2_s on plane.y_bc {
        e0 = line(start = [0 in, 296 in], end = [0 in, 298.3125 in])
        e1 = line(start = [0 in, 298.3125 in], end = [1.5 in, 298.3125 in])
        e2 = line(start = [1.5 in, 298.3125 in], end = [1.5 in, 297.3438 in])
        e3 = line(start = [1.5 in, 297.3438 in], end = [10.375 in, 297.3438 in])
        e4 = line(start = [10.375 in, 297.3438 in], end = [10.375 in, 298.3125 in])
        e5 = line(start = [10.375 in, 298.3125 in], end = [11.875 in, 298.3125 in])
        e6 = line(start = [11.875 in, 298.3125 in], end = [11.875 in, 296 in])
        e7 = line(start = [11.875 in, 296 in], end = [10.375 in, 296 in])
        e8 = line(start = [10.375 in, 296 in], end = [10.375 in, 296.9688 in])
        e9 = line(start = [10.375 in, 296.9688 in], end = [1.5 in, 296.9688 in])
        e10 = line(start = [1.5 in, 296.9688 in], end = [1.5 in, 296 in])
        e11 = line(start = [1.5 in, 296 in], end = [0 in, 296 in])
    }
    feature trimmer_2 = extrude(profile = sketch.trimmer_2_s, distance = 76.375 in, mode = new)
    sketch trimmer_3_s on plane.y_bc {
        e0 = line(start = [0 in, 298.3125 in], end = [0 in, 300.625 in])
        e1 = line(start = [0 in, 300.625 in], end = [1.5 in, 300.625 in])
        e2 = line(start = [1.5 in, 300.625 in], end = [1.5 in, 299.6562 in])
        e3 = line(start = [1.5 in, 299.6562 in], end = [10.375 in, 299.6562 in])
        e4 = line(start = [10.375 in, 299.6562 in], end = [10.375 in, 300.625 in])
        e5 = line(start = [10.375 in, 300.625 in], end = [11.875 in, 300.625 in])
        e6 = line(start = [11.875 in, 300.625 in], end = [11.875 in, 298.3125 in])
        e7 = line(start = [11.875 in, 298.3125 in], end = [10.375 in, 298.3125 in])
        e8 = line(start = [10.375 in, 298.3125 in], end = [10.375 in, 299.2812 in])
        e9 = line(start = [10.375 in, 299.2812 in], end = [1.5 in, 299.2812 in])
        e10 = line(start = [1.5 in, 299.2812 in], end = [1.5 in, 298.3125 in])
        e11 = line(start = [1.5 in, 298.3125 in], end = [0 in, 298.3125 in])
    }
    feature trimmer_3 = extrude(profile = sketch.trimmer_3_s, distance = 76.375 in, mode = new)
    sketch stair_header_s on plane.y_hdr {
        e0 = line(start = [0 in, 164.0625 in], end = [11.875 in, 164.0625 in])
        e1 = line(start = [11.875 in, 164.0625 in], end = [11.875 in, 295.9375 in])
        e2 = line(start = [11.875 in, 295.9375 in], end = [0 in, 295.9375 in])
        e3 = line(start = [0 in, 295.9375 in], end = [0 in, 164.0625 in])
