        e1 = line(start = [0 in, 177.1562 in], end = [1.5 in, 177.1562 in])
        e2 = line(start = [1.5 in, 177.1562 in], end = [1.5 in, 176.1875 in])
        e3 = line(start = [1.5 in, 176.1875 in], end = [10.375 in, 176.1875 in])
        e4 = line(start = [10.375 in, 176.1875 in], end = [10.375 in, 177.1562 in])
        e5 = line(start = [10.375 in, 177.1562 in], end = [11.875 in, 177.1562 in])
        e6 = line(start = [11.875 in, 177.1562 in], end = [11.875 in, 174.8438 in])
        e7 = line(start = [11.875 in, 174.8438 in], end = [10.375 in, 174.8438 in])
        e8 = line(start = [10.375 in, 174.8438 in], end = [10.375 in, 175.8125 in])
        e9 = line(start = [10.375 in, 175.8125 in], end = [1.5 in, 175.8125 in])
        e10 = line(start = [1.5 in, 175.8125 in], end = [1.5 in, 174.8438 in])
        e11 = line(start = [1.5 in, 174.8438 in], end = [0 in, 174.8438 in])
    }
    feature tail = extrude(profile = sketch.tail_s, distance = 32.625 in, mode = new)
    feature tails = pattern(bodies = [feature.tail.body], layout = linear(direction = origin.x, spacing = input.spacing, count = 8))
    // Subfloor, with the stair opening cut out
    feature deck = plane.offset(base = origin.xy, distance = 11.875 in)
    sketch subfloor_s on plane.deck {
