        e1 = line(start = [296 in, 180.25 in], end = [296 in, 222.25 in])
        e2 = line(start = [296 in, 222.25 in], end = [164 in, 222.25 in])
        e3 = line(start = [164 in, 222.25 in], end = [164 in, 180.25 in])
    }
    feature opening = extrude(profile = sketch.opening_s, distance = 0.75 in, mode = cut)

    // Connector holes for all: bored holes, cast-in voids and seat reliefs
    feature hw_pl0 = plane.offset(base = origin.xy, distance = 0 in)
    sketch hw_0_s on plane.hw_pl0 {
        c = circle(center = [4.25 in, 2.75 in], radius = 0.3438 in)
