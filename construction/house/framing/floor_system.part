    feature hw_6 = extrude(profile = sketch.hw_6_s, distance = 12.625 in, mode = cut)
    sketch hw_7_s on plane.hw_pl0 {
        c = circle(center = [477.25 in, 350.25 in], radius = 0.3438 in)
    }
    feature hw_7 = extrude(profile = sketch.hw_7_s, distance = 12.625 in, mode = cut)
    // end connector holes all
