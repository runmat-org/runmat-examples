// The framing of one exterior wall: 2x6 studs at 16 in o.c. on a sill plate (pressure-treated
// on the slab, untreated on the floor), a double top plate lapped at the corners, end posts for
// the hold-downs, and at each opening king and jack studs, an insulated 2-ply header sized to its
// span (DESIGN-NOTES, "Headers") and a rough sill. Studs under a window or over a header stay on
// layout as cripples. Each wall line and level is a configuration; the opening sizes follow the
// opening schedule in DESIGN-NOTES.md. Local axes: x along the wall, y inward from the outside face
// of the studs, z up from the bottom of the sill.
part wall_framing {
    input len : length = 480 in
    input zt : length = 106.125 in
    input first : length = 16 in
    input n : count = 29
    input top2_x0 : length = 5.5 in
    input top2_x1 : length = 474.5 in
    input p1 : length = 60 in
    input p2 : length = 120 in
    input o1_l : length = 53.75 in
    input o1_r : length = 114.25 in
    input o1_h : length = 82.5 in
    input o1_t : length = 91.75 in
    input o1_s : length = 20.5 in
    input o1_k : length = 3 in
    input o2_l : length = 202.75 in
    input o2_r : length = 240.75 in
    input o2_h : length = 82.5 in
    input o2_t : length = 89.75 in
    input o2_s : length = 1.5 in
    input o2_k : length = 3 in
    input o3_l : length = 311.75 in
    input o3_r : length = 348.25 in
    input o3_h : length = 82.5 in
    input o3_t : length = 89.75 in
    input o3_s : length = 20.5 in
    input o3_k : length = 3 in
    input o4_l : length = 391.75 in
    input o4_r : length = 428.25 in
    input o4_h : length = 82.5 in
    input o4_t : length = 89.75 in
    input o4_s : length = 20.5 in
    input o4_k : length = 3 in
    let zt2 = input.zt + 1.5 in
    let ztop = input.zt + 3 in

    feature y15 = plane.offset(base = origin.zx, distance = 1.5 in)
    feature y40 = plane.offset(base = origin.zx, distance = 4 in)
    // Plates
    sketch sill_s on origin.zx {
        e0 = line(start = [0 in, 0 in], end = [1.5 in, 0 in])
        e1 = line(start = [1.5 in, 0 in], end = [1.5 in, input.len])
        e2 = line(start = [1.5 in, input.len], end = [0 in, input.len])
        e3 = line(start = [0 in, input.len], end = [0 in, 0 in])
    }
    feature sill = extrude(profile = sketch.sill_s, distance = 5.5 in, mode = new)
    sketch bottom_s on origin.zx {
        e0 = line(start = [0 in, 0 in], end = [1.5 in, 0 in])
        e1 = line(start = [1.5 in, 0 in], end = [1.5 in, input.len])
        e2 = line(start = [1.5 in, input.len], end = [0 in, input.len])
        e3 = line(start = [0 in, input.len], end = [0 in, 0 in])
    }
    feature bottom = extrude(profile = sketch.bottom_s, distance = 5.5 in, mode = new, suppressed = true)
    sketch top1_s on origin.zx {
        e0 = line(start = [input.zt, 0 in], end = [let.zt2, 0 in])
        e1 = line(start = [let.zt2, 0 in], end = [let.zt2, input.len])
        e2 = line(start = [let.zt2, input.len], end = [input.zt, input.len])
        e3 = line(start = [input.zt, input.len], end = [input.zt, 0 in])
    }
    feature top1 = extrude(profile = sketch.top1_s, distance = 5.5 in, mode = new)
    sketch top2_s on origin.zx {
        e0 = line(start = [let.zt2, input.top2_x0], end = [let.ztop, input.top2_x0])
        e1 = line(start = [let.ztop, input.top2_x0], end = [let.ztop, input.top2_x1])
        e2 = line(start = [let.ztop, input.top2_x1], end = [let.zt2, input.top2_x1])
        e3 = line(start = [let.zt2, input.top2_x1], end = [let.zt2, input.top2_x0])
    }
    feature top2 = extrude(profile = sketch.top2_s, distance = 5.5 in, mode = new)
    // End posts (2 plies, the hold-down post) and the corner backing stud of the long walls
    sketch e0_s on origin.zx {
        e0 = line(start = [1.5 in, 0 in], end = [input.zt, 0 in])
        e1 = line(start = [input.zt, 0 in], end = [input.zt, 1.5 in])
        e2 = line(start = [input.zt, 1.5 in], end = [1.5 in, 1.5 in])
        e3 = line(start = [1.5 in, 1.5 in], end = [1.5 in, 0 in])
    }
    feature e0 = extrude(profile = sketch.e0_s, distance = 5.5 in, mode = new)
    sketch e1_s on origin.zx {
        e0 = line(start = [1.5 in, 1.5 in], end = [input.zt, 1.5 in])
        e1 = line(start = [input.zt, 1.5 in], end = [input.zt, 3 in])
        e2 = line(start = [input.zt, 3 in], end = [1.5 in, 3 in])
        e3 = line(start = [1.5 in, 3 in], end = [1.5 in, 1.5 in])
    }
    feature e1 = extrude(profile = sketch.e1_s, distance = 5.5 in, mode = new)
    sketch e2_s on origin.zx {
        e0 = line(start = [1.5 in, 5.5 in], end = [input.zt, 5.5 in])
        e1 = line(start = [input.zt, 5.5 in], end = [input.zt, 7 in])
        e2 = line(start = [input.zt, 7 in], end = [1.5 in, 7 in])
        e3 = line(start = [1.5 in, 7 in], end = [1.5 in, 5.5 in])
    }
    feature e2 = extrude(profile = sketch.e2_s, distance = 5.5 in, mode = new)
    sketch e3_s on origin.zx {
        e0 = line(start = [1.5 in, input.len - 1.5 in], end = [input.zt, input.len - 1.5 in])
        e1 = line(start = [input.zt, input.len - 1.5 in], end = [input.zt, input.len])
        e2 = line(start = [input.zt, input.len], end = [1.5 in, input.len])
        e3 = line(start = [1.5 in, input.len], end = [1.5 in, input.len - 1.5 in])
    }
    feature e3 = extrude(profile = sketch.e3_s, distance = 5.5 in, mode = new)
    sketch e4_s on origin.zx {
        e0 = line(start = [1.5 in, input.len - 3 in], end = [input.zt, input.len - 3 in])
        e1 = line(start = [input.zt, input.len - 3 in], end = [input.zt, input.len - 1.5 in])
        e2 = line(start = [input.zt, input.len - 1.5 in], end = [1.5 in, input.len - 1.5 in])
        e3 = line(start = [1.5 in, input.len - 1.5 in], end = [1.5 in, input.len - 3 in])
    }
    feature e4 = extrude(profile = sketch.e4_s, distance = 5.5 in, mode = new)
    sketch e5_s on origin.zx {
        e0 = line(start = [1.5 in, input.len - 7 in], end = [input.zt, input.len - 7 in])
        e1 = line(start = [input.zt, input.len - 7 in], end = [input.zt, input.len - 5.5 in])
        e2 = line(start = [input.zt, input.len - 5.5 in], end = [1.5 in, input.len - 5.5 in])
        e3 = line(start = [1.5 in, input.len - 5.5 in], end = [1.5 in, input.len - 7 in])
    }
    feature e5 = extrude(profile = sketch.e5_s, distance = 5.5 in, mode = new)
    // Studs at 16 in o.c. from the first layout mark
    sketch stud_s on origin.zx {
        e0 = line(start = [1.5 in, input.first - 0.75 in], end = [input.zt, input.first - 0.75 in])
        e1 = line(start = [input.zt, input.first - 0.75 in], end = [input.zt, input.first + 0.75 in])
        e2 = line(start = [input.zt, input.first + 0.75 in], end = [1.5 in, input.first + 0.75 in])
        e3 = line(start = [1.5 in, input.first + 0.75 in], end = [1.5 in, input.first - 0.75 in])
    }
    feature stud = extrude(profile = sketch.stud_s, distance = 5.5 in, mode = new)
    feature studs = pattern(bodies = [feature.stud.body], layout = linear(direction = origin.x, spacing = 16 in, count = input.n))
    // 3-ply posts under the floor beams (walls 1 and 5, first floor)
    sketch p1_0_s on origin.zx {
        e0 = line(start = [1.5 in, input.p1 + -2.25 in], end = [input.zt, input.p1 + -2.25 in])
        e1 = line(start = [input.zt, input.p1 + -2.25 in], end = [input.zt, input.p1 + -0.75 in])
        e2 = line(start = [input.zt, input.p1 + -0.75 in], end = [1.5 in, input.p1 + -0.75 in])
        e3 = line(start = [1.5 in, input.p1 + -0.75 in], end = [1.5 in, input.p1 + -2.25 in])
    }
    feature p1_0 = extrude(profile = sketch.p1_0_s, distance = 5.5 in, mode = new, suppressed = true)
    sketch p1_1_s on origin.zx {
        e0 = line(start = [1.5 in, input.p1 + -0.75 in], end = [input.zt, input.p1 + -0.75 in])
        e1 = line(start = [input.zt, input.p1 + -0.75 in], end = [input.zt, input.p1 + 0.75 in])
        e2 = line(start = [input.zt, input.p1 + 0.75 in], end = [1.5 in, input.p1 + 0.75 in])
        e3 = line(start = [1.5 in, input.p1 + 0.75 in], end = [1.5 in, input.p1 + -0.75 in])
    }
    feature p1_1 = extrude(profile = sketch.p1_1_s, distance = 5.5 in, mode = new, suppressed = true)
    sketch p1_2_s on origin.zx {
        e0 = line(start = [1.5 in, input.p1 + 0.75 in], end = [input.zt, input.p1 + 0.75 in])
        e1 = line(start = [input.zt, input.p1 + 0.75 in], end = [input.zt, input.p1 + 2.25 in])
        e2 = line(start = [input.zt, input.p1 + 2.25 in], end = [1.5 in, input.p1 + 2.25 in])
        e3 = line(start = [1.5 in, input.p1 + 2.25 in], end = [1.5 in, input.p1 + 0.75 in])
    }
    feature p1_2 = extrude(profile = sketch.p1_2_s, distance = 5.5 in, mode = new, suppressed = true)
    sketch p2_0_s on origin.zx {
        e0 = line(start = [1.5 in, input.p2 + -2.25 in], end = [input.zt, input.p2 + -2.25 in])
        e1 = line(start = [input.zt, input.p2 + -2.25 in], end = [input.zt, input.p2 + -0.75 in])
        e2 = line(start = [input.zt, input.p2 + -0.75 in], end = [1.5 in, input.p2 + -0.75 in])
        e3 = line(start = [1.5 in, input.p2 + -0.75 in], end = [1.5 in, input.p2 + -2.25 in])
    }
    feature p2_0 = extrude(profile = sketch.p2_0_s, distance = 5.5 in, mode = new, suppressed = true)
    sketch p2_1_s on origin.zx {
        e0 = line(start = [1.5 in, input.p2 + -0.75 in], end = [input.zt, input.p2 + -0.75 in])
        e1 = line(start = [input.zt, input.p2 + -0.75 in], end = [input.zt, input.p2 + 0.75 in])
        e2 = line(start = [input.zt, input.p2 + 0.75 in], end = [1.5 in, input.p2 + 0.75 in])
        e3 = line(start = [1.5 in, input.p2 + 0.75 in], end = [1.5 in, input.p2 + -0.75 in])
    }
    feature p2_1 = extrude(profile = sketch.p2_1_s, distance = 5.5 in, mode = new, suppressed = true)
    sketch p2_2_s on origin.zx {
        e0 = line(start = [1.5 in, input.p2 + 0.75 in], end = [input.zt, input.p2 + 0.75 in])
        e1 = line(start = [input.zt, input.p2 + 0.75 in], end = [input.zt, input.p2 + 2.25 in])
        e2 = line(start = [input.zt, input.p2 + 2.25 in], end = [1.5 in, input.p2 + 2.25 in])
        e3 = line(start = [1.5 in, input.p2 + 2.25 in], end = [1.5 in, input.p2 + 0.75 in])
    }
    feature p2_2 = extrude(profile = sketch.p2_2_s, distance = 5.5 in, mode = new, suppressed = true)
    // Opening 1: rough opening o1_l to o1_r, head o1_h; king and jack zone o1_k each side
    sketch o1_cut_s on origin.zx {
        e0 = line(start = [input.o1_s, input.o1_l - input.o1_k], end = [input.o1_t, input.o1_l - input.o1_k])
        e1 = line(start = [input.o1_t, input.o1_l - input.o1_k], end = [input.o1_t, input.o1_r + input.o1_k])
        e2 = line(start = [input.o1_t, input.o1_r + input.o1_k], end = [input.o1_s, input.o1_r + input.o1_k])
        e3 = line(start = [input.o1_s, input.o1_r + input.o1_k], end = [input.o1_s, input.o1_l - input.o1_k])
    }
    feature o1_cut = extrude(profile = sketch.o1_cut_s, distance = 5.5 in, mode = cut)
    sketch o1_plate_cut_s on origin.zx {
        e0 = line(start = [0 in, input.o1_l], end = [1.5 in, input.o1_l])
        e1 = line(start = [1.5 in, input.o1_l], end = [1.5 in, input.o1_r])
        e2 = line(start = [1.5 in, input.o1_r], end = [0 in, input.o1_r])
        e3 = line(start = [0 in, input.o1_r], end = [0 in, input.o1_l])
    }
    feature o1_plate_cut = extrude(profile = sketch.o1_plate_cut_s, distance = 5.5 in, mode = cut, suppressed = true)
    sketch o1_king_l_s on origin.zx {
        e0 = line(start = [1.5 in, input.o1_l - input.o1_k], end = [input.zt, input.o1_l - input.o1_k])
        e1 = line(start = [input.zt, input.o1_l - input.o1_k], end = [input.zt, input.o1_l - input.o1_k + 1.5 in])
        e2 = line(start = [input.zt, input.o1_l - input.o1_k + 1.5 in], end = [1.5 in, input.o1_l - input.o1_k + 1.5 in])
        e3 = line(start = [1.5 in, input.o1_l - input.o1_k + 1.5 in], end = [1.5 in, input.o1_l - input.o1_k])
    }
    feature o1_king_l = extrude(profile = sketch.o1_king_l_s, distance = 5.5 in, mode = new)
    sketch o1_king_r_s on origin.zx {
        e0 = line(start = [1.5 in, input.o1_r + input.o1_k - 1.5 in], end = [input.zt, input.o1_r + input.o1_k - 1.5 in])
        e1 = line(start = [input.zt, input.o1_r + input.o1_k - 1.5 in], end = [input.zt, input.o1_r + input.o1_k])
        e2 = line(start = [input.zt, input.o1_r + input.o1_k], end = [1.5 in, input.o1_r + input.o1_k])
        e3 = line(start = [1.5 in, input.o1_r + input.o1_k], end = [1.5 in, input.o1_r + input.o1_k - 1.5 in])
    }
    feature o1_king_r = extrude(profile = sketch.o1_king_r_s, distance = 5.5 in, mode = new)
    sketch o1_jack_l_s on origin.zx {
        e0 = line(start = [1.5 in, input.o1_l - 1.5 in], end = [input.o1_h, input.o1_l - 1.5 in])
        e1 = line(start = [input.o1_h, input.o1_l - 1.5 in], end = [input.o1_h, input.o1_l])
        e2 = line(start = [input.o1_h, input.o1_l], end = [1.5 in, input.o1_l])
        e3 = line(start = [1.5 in, input.o1_l], end = [1.5 in, input.o1_l - 1.5 in])
    }
    feature o1_jack_l = extrude(profile = sketch.o1_jack_l_s, distance = 5.5 in, mode = new)
    sketch o1_jack_r_s on origin.zx {
        e0 = line(start = [1.5 in, input.o1_r], end = [input.o1_h, input.o1_r])
        e1 = line(start = [input.o1_h, input.o1_r], end = [input.o1_h, input.o1_r + 1.5 in])
        e2 = line(start = [input.o1_h, input.o1_r + 1.5 in], end = [1.5 in, input.o1_r + 1.5 in])
        e3 = line(start = [1.5 in, input.o1_r + 1.5 in], end = [1.5 in, input.o1_r])
    }
    feature o1_jack_r = extrude(profile = sketch.o1_jack_r_s, distance = 5.5 in, mode = new)
    sketch o1_jack_l2_s on origin.zx {
        e0 = line(start = [1.5 in, input.o1_l - 3 in], end = [input.o1_h, input.o1_l - 3 in])
        e1 = line(start = [input.o1_h, input.o1_l - 3 in], end = [input.o1_h, input.o1_l - 1.5 in])
        e2 = line(start = [input.o1_h, input.o1_l - 1.5 in], end = [1.5 in, input.o1_l - 1.5 in])
        e3 = line(start = [1.5 in, input.o1_l - 1.5 in], end = [1.5 in, input.o1_l - 3 in])
    }
    feature o1_jack_l2 = extrude(profile = sketch.o1_jack_l2_s, distance = 5.5 in, mode = new, suppressed = true)
    sketch o1_jack_r2_s on origin.zx {
        e0 = line(start = [1.5 in, input.o1_r + 1.5 in], end = [input.o1_h, input.o1_r + 1.5 in])
        e1 = line(start = [input.o1_h, input.o1_r + 1.5 in], end = [input.o1_h, input.o1_r + 3 in])
        e2 = line(start = [input.o1_h, input.o1_r + 3 in], end = [1.5 in, input.o1_r + 3 in])
        e3 = line(start = [1.5 in, input.o1_r + 3 in], end = [1.5 in, input.o1_r + 1.5 in])
    }
    feature o1_jack_r2 = extrude(profile = sketch.o1_jack_r2_s, distance = 5.5 in, mode = new, suppressed = true)
    sketch o1_hdr_out_s on origin.zx {
        e0 = line(start = [input.o1_h, input.o1_l - input.o1_k + 1.5 in], end = [input.o1_t, input.o1_l - input.o1_k + 1.5 in])
        e1 = line(start = [input.o1_t, input.o1_l - input.o1_k + 1.5 in], end = [input.o1_t, input.o1_r + input.o1_k - 1.5 in])
        e2 = line(start = [input.o1_t, input.o1_r + input.o1_k - 1.5 in], end = [input.o1_h, input.o1_r + input.o1_k - 1.5 in])
        e3 = line(start = [input.o1_h, input.o1_r + input.o1_k - 1.5 in], end = [input.o1_h, input.o1_l - input.o1_k + 1.5 in])
    }
    feature o1_hdr_out = extrude(profile = sketch.o1_hdr_out_s, distance = 1.5 in, mode = new)
    sketch o1_hdr_foam_s on plane.y15 {
        e0 = line(start = [input.o1_h, input.o1_l - input.o1_k + 1.5 in], end = [input.o1_t, input.o1_l - input.o1_k + 1.5 in])
        e1 = line(start = [input.o1_t, input.o1_l - input.o1_k + 1.5 in], end = [input.o1_t, input.o1_r + input.o1_k - 1.5 in])
        e2 = line(start = [input.o1_t, input.o1_r + input.o1_k - 1.5 in], end = [input.o1_h, input.o1_r + input.o1_k - 1.5 in])
        e3 = line(start = [input.o1_h, input.o1_r + input.o1_k - 1.5 in], end = [input.o1_h, input.o1_l - input.o1_k + 1.5 in])
    }
    feature o1_hdr_foam = extrude(profile = sketch.o1_hdr_foam_s, distance = 2.5 in, mode = new)
    sketch o1_hdr_in_s on plane.y40 {
        e0 = line(start = [input.o1_h, input.o1_l - input.o1_k + 1.5 in], end = [input.o1_t, input.o1_l - input.o1_k + 1.5 in])
        e1 = line(start = [input.o1_t, input.o1_l - input.o1_k + 1.5 in], end = [input.o1_t, input.o1_r + input.o1_k - 1.5 in])
        e2 = line(start = [input.o1_t, input.o1_r + input.o1_k - 1.5 in], end = [input.o1_h, input.o1_r + input.o1_k - 1.5 in])
        e3 = line(start = [input.o1_h, input.o1_r + input.o1_k - 1.5 in], end = [input.o1_h, input.o1_l - input.o1_k + 1.5 in])
    }
    feature o1_hdr_in = extrude(profile = sketch.o1_hdr_in_s, distance = 1.5 in, mode = new)
    sketch o1_rough_sill_s on origin.zx {
        e0 = line(start = [input.o1_s, input.o1_l], end = [input.o1_s + 1.5 in, input.o1_l])
        e1 = line(start = [input.o1_s + 1.5 in, input.o1_l], end = [input.o1_s + 1.5 in, input.o1_r])
        e2 = line(start = [input.o1_s + 1.5 in, input.o1_r], end = [input.o1_s, input.o1_r])
        e3 = line(start = [input.o1_s, input.o1_r], end = [input.o1_s, input.o1_l])
    }
    feature o1_rough_sill = extrude(profile = sketch.o1_rough_sill_s, distance = 5.5 in, mode = new)
    // Opening 2: rough opening o2_l to o2_r, head o2_h; king and jack zone o2_k each side
    sketch o2_cut_s on origin.zx {
        e0 = line(start = [input.o2_s, input.o2_l - input.o2_k], end = [input.o2_t, input.o2_l - input.o2_k])
        e1 = line(start = [input.o2_t, input.o2_l - input.o2_k], end = [input.o2_t, input.o2_r + input.o2_k])
        e2 = line(start = [input.o2_t, input.o2_r + input.o2_k], end = [input.o2_s, input.o2_r + input.o2_k])
        e3 = line(start = [input.o2_s, input.o2_r + input.o2_k], end = [input.o2_s, input.o2_l - input.o2_k])
    }
    feature o2_cut = extrude(profile = sketch.o2_cut_s, distance = 5.5 in, mode = cut)
    sketch o2_plate_cut_s on origin.zx {
        e0 = line(start = [0 in, input.o2_l], end = [1.5 in, input.o2_l])
        e1 = line(start = [1.5 in, input.o2_l], end = [1.5 in, input.o2_r])
        e2 = line(start = [1.5 in, input.o2_r], end = [0 in, input.o2_r])
        e3 = line(start = [0 in, input.o2_r], end = [0 in, input.o2_l])
    }
    feature o2_plate_cut = extrude(profile = sketch.o2_plate_cut_s, distance = 5.5 in, mode = cut)
    sketch o2_king_l_s on origin.zx {
        e0 = line(start = [1.5 in, input.o2_l - input.o2_k], end = [input.zt, input.o2_l - input.o2_k])
