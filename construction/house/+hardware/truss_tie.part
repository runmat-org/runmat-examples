runmat 0.7
std 1

// A truss-to-wall tie, 18 gauge galvanized steel: a leg nailed to the side of the bottom chord,
// a tab over the top plate and a leg down the inside face of the top plates. Origin at the
// truss face on the top of the plates over the outside face of the wall; +x away from the
// truss, +y into the building, z up.
part truss_tie {
    let t = 0.048 in
    sketch leg_s on origin.yz {
        e0 = line(start = [1 in, 0 in], end = [4.5 in, 0 in])
        e1 = line(start = [4.5 in, 0 in], end = [4.5 in, 3 in])
        e2 = line(start = [4.5 in, 3 in], end = [1 in, 3 in])
        e3 = line(start = [1 in, 3 in], end = [1 in, 0 in])
    }
    feature leg = extrude(profile = sketch.leg_s, distance = 0.048 in, mode = new)
    sketch tab_s on origin.xy {
        e0 = line(start = [0.048 in, 1 in], end = [1.5 in, 1 in])
        e1 = line(start = [1.5 in, 1 in], end = [1.5 in, 4.5 in])
        e2 = line(start = [1.5 in, 4.5 in], end = [0.048 in, 4.5 in])
        e3 = line(start = [0.048 in, 4.5 in], end = [0.048 in, 1 in])
    }
    feature tab = extrude(profile = sketch.tab_s, distance = 0.048 in, mode = new)
    feature inside = plane.offset(base = origin.zx, distance = 5.5 in)
    sketch drop_s on plane.inside {
        e0 = line(start = [-3 in, 0.048 in], end = [0.048 in, 0.048 in])
        e1 = line(start = [0.048 in, 0.048 in], end = [0.048 in, 1.5 in])
        e2 = line(start = [0.048 in, 1.5 in], end = [-3 in, 1.5 in])
        e3 = line(start = [-3 in, 1.5 in], end = [-3 in, 0.048 in])
    }
    feature drop = extrude(profile = sketch.drop_s, distance = 0.048 in, mode = new)
    output truss_tie = { body = feature.leg.body, part_number = "TT-18", material = "material.galvanized_steel" }
}
