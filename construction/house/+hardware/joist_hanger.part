// A face-mount joist hanger, 18 gauge galvanized steel: a seat under the joist, sides up the
// joist and flanges nailed to the beam face. Origin on the beam face at the bottom of the joist;
// +y along the joist. Configurations for a single I-joist, a doubled I-joist and an LVL header.
part joist_hanger {
    input width : length = 2.3125 in
    let t = 0.048 in
    let half = input.width / 2
    feature under = plane.offset(base = origin.xy, distance = -0.048 in)
    sketch seat_s on plane.under {
        e0 = line(start = [-let.half - let.t, 0 in], end = [let.half + let.t, 0 in])
        e1 = line(start = [let.half + let.t, 0 in], end = [let.half + let.t, 2.5 in])
        e2 = line(start = [let.half + let.t, 2.5 in], end = [-let.half - let.t, 2.5 in])
        e3 = line(start = [-let.half - let.t, 2.5 in], end = [-let.half - let.t, 0 in])
    }
    feature seat = extrude(profile = sketch.seat_s, distance = 0.048 in, mode = new)
    sketch side_r_s on origin.xy {
        e0 = line(start = [let.half, 0 in], end = [let.half + let.t, 0 in])
        e1 = line(start = [let.half + let.t, 0 in], end = [let.half + let.t, 2.5 in])
        e2 = line(start = [let.half + let.t, 2.5 in], end = [let.half, 2.5 in])
        e3 = line(start = [let.half, 2.5 in], end = [let.half, 0 in])
    }
    feature side_r = extrude(profile = sketch.side_r_s, distance = 9 in, mode = new)
    sketch flange_r_s on origin.xy {
        e0 = line(start = [let.half + let.t, 0 in], end = [let.half + 1 in, 0 in])
        e1 = line(start = [let.half + 1 in, 0 in], end = [let.half + 1 in, let.t])
        e2 = line(start = [let.half + 1 in, let.t], end = [let.half + let.t, let.t])
        e3 = line(start = [let.half + let.t, let.t], end = [let.half + let.t, 0 in])
    }
    feature flange_r = extrude(profile = sketch.flange_r_s, distance = 9 in, mode = new)
    sketch side_l_s on origin.xy {
        e0 = line(start = [-let.half - let.t, 0 in], end = [-let.half, 0 in])
        e1 = line(start = [-let.half, 0 in], end = [-let.half, 2.5 in])
        e2 = line(start = [-let.half, 2.5 in], end = [-let.half - let.t, 2.5 in])
        e3 = line(start = [-let.half - let.t, 2.5 in], end = [-let.half - let.t, 0 in])
    }
    feature side_l = extrude(profile = sketch.side_l_s, distance = 9 in, mode = new)
    sketch flange_l_s on origin.xy {
        e0 = line(start = [-let.half - 1 in, 0 in], end = [-let.half - let.t, 0 in])
        e1 = line(start = [-let.half - let.t, 0 in], end = [-let.half - let.t, let.t])
        e2 = line(start = [-let.half - let.t, let.t], end = [-let.half - 1 in, let.t])
        e3 = line(start = [-let.half - 1 in, let.t], end = [-let.half - 1 in, 0 in])
    }
    feature flange_l = extrude(profile = sketch.flange_l_s, distance = 9 in, mode = new)
    output joist_hanger = { body = feature.seat.body, part_number = "JH-2516", material = material.galvanized_steel }
    configuration single = { part_number = "JH-2516", description = "Hanger, single 2 5/16 x 11 7/8 I-joist" }
    configuration double = { width = 4.625 in, part_number = "JH-4616", description = "Hanger, doubled I-joist" }
    configuration lvl = { width = 1.75 in, part_number = "JH-1716", description = "Hanger, 1 3/4 in LVL" }
}
