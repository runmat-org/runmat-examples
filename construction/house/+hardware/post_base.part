runmat 0.7
std 1

// A standoff post base: a 1 in steel standoff under a 6x6 post, with straps up two faces,
// anchored into the slab over the pad footing. Origin on the top of the slab at the post axis.
part post_base {
    sketch plate_s on origin.xy {
        e0 = line(start = [-2.75 in, -2.75 in], end = [2.75 in, -2.75 in])
        e1 = line(start = [2.75 in, -2.75 in], end = [2.75 in, 2.75 in])
        e2 = line(start = [2.75 in, 2.75 in], end = [-2.75 in, 2.75 in])
        e3 = line(start = [-2.75 in, 2.75 in], end = [-2.75 in, -2.75 in])
    }
    feature plate = extrude(profile = sketch.plate_s, distance = 1 in, mode = new)
    feature anchor_plane = plane.offset(base = origin.xy, distance = -3.5 in)
    sketch anchor_s on plane.anchor_plane {
        c = circle(center = [0 in, 0 in], radius = 0.3125 in)
    }
    feature anchor = extrude(profile = sketch.anchor_s, distance = 3.5 in, mode = new)
    sketch strap_a_s on origin.xy {
        e0 = line(start = [2.75 in, -1.5 in], end = [2.87 in, -1.5 in])
        e1 = line(start = [2.87 in, -1.5 in], end = [2.87 in, 1.5 in])
        e2 = line(start = [2.87 in, 1.5 in], end = [2.75 in, 1.5 in])
        e3 = line(start = [2.75 in, 1.5 in], end = [2.75 in, -1.5 in])
    }
    feature strap_a = extrude(profile = sketch.strap_a_s, distance = 6 in, mode = new)
    sketch strap_b_s on origin.xy {
        e0 = line(start = [-2.87 in, -1.5 in], end = [-2.75 in, -1.5 in])
        e1 = line(start = [-2.75 in, -1.5 in], end = [-2.75 in, 1.5 in])
        e2 = line(start = [-2.75 in, 1.5 in], end = [-2.87 in, 1.5 in])
        e3 = line(start = [-2.87 in, 1.5 in], end = [-2.87 in, -1.5 in])
    }
    feature strap_b = extrude(profile = sketch.strap_b_s, distance = 6 in, mode = new)
    output post_base = { body = feature.plate.body, part_number = "PB-66", material = "material.galvanized_steel" }
}
