// A two-story wood-framed house, 40 x 30 ft with a 6:12 gable roof: the entry assembly. The
// skeleton sets the grids, levels and frames; the foundation, framing, envelope and interior
// attach to it, and the MEP systems place in building coordinates. The studies join here as they
// are built.
import { house_skeleton } from "./house_skeleton.part"
import { foundation } from "./foundation/foundation.assembly"
import { framing } from "./framing/framing.assembly"
import { envelope } from "./envelope/envelope.assembly"
import { interior } from "./interior/interior.assembly"
import { mep } from "./mep/mep.assembly"

assembly house {
    instance skeleton : house_skeleton
    instance foundation : foundation = {
        placement = attach(
            own = { anchor = origin },
            to = { frame = interface, part = house_skeleton, name = building },
        )
    }
    instance framing : framing = {
        placement = attach(
            own = { anchor = origin },
            to = { frame = interface, part = house_skeleton, name = building },
        )
    }
    instance envelope : envelope = {
        placement = attach(
            own = { anchor = origin },
            to = { frame = interface, part = house_skeleton, name = building },
        )
    }
    instance interior : interior = {
        placement = attach(
            own = { anchor = origin },
            to = { frame = interface, part = house_skeleton, name = building },
        )
    }
    instance mep : mep = {
        placement = attach(
            own = { anchor = origin },
            to = { frame = interface, part = house_skeleton, name = building },
        )
    }

    camera hero = { from = [-0.62, -0.7, 0.36], default = true }
    camera back = { from = [0.6, 0.72, 0.34] }
}
