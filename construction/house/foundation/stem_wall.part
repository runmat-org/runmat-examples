runmat 0.7
std 1

// The perimeter stem wall: 8 in cast-in-place concrete from the top of the footing to the top
// of the slab, its outside face on the building line. One #4 continuous bar 3 in below the top
// carries the anchor-bolt line; the #4 dowels from the footing lap into it (footing.part).
part stem_wall {
    feature base = plane.offset(base = origin.xy, distance = -22 in)
    sketch wall_s on plane.base {
        ro0 = line(start = [0 in, 0 in], end = [480 in, 0 in])
        ro1 = line(start = [480 in, 0 in], end = [480 in, 360 in])
        ro2 = line(start = [480 in, 360 in], end = [0 in, 360 in])
        ro3 = line(start = [0 in, 360 in], end = [0 in, 0 in])
        ri0 = line(start = [8 in, 8 in], end = [472 in, 8 in])
        ri1 = line(start = [472 in, 8 in], end = [472 in, 352 in])
        ri2 = line(start = [472 in, 352 in], end = [8 in, 352 in])
        ri3 = line(start = [8 in, 352 in], end = [8 in, 8 in])
    }
    feature wall = extrude(profile = sketch.wall_s, distance = 22 in, mode = new)
    feature bar_x0 = plane.offset(base = origin.yz, distance = 1.5 in)
    sketch bars_x_s on plane.bar_x0 {
        c0 = circle(center = [4.5 in, -3.25 in], radius = 0.25 in)
        c1 = circle(center = [355.5 in, -3.25 in], radius = 0.25 in)
    }
    feature bars_x = extrude(profile = sketch.bars_x_s, distance = 477 in, mode = new)
    feature bar_y0 = plane.offset(base = origin.zx, distance = 1.5 in)
    sketch bars_y_s on plane.bar_y0 {
        c0 = circle(center = [-2.75 in, 4.5 in], radius = 0.25 in)
        c1 = circle(center = [-2.75 in, 475.5 in], radius = 0.25 in)
    }
    feature bars_y = extrude(profile = sketch.bars_y_s, distance = 357 in, mode = new)

    // Connector holes (lane H4) for all: bored holes, cast-in voids and seat reliefs
    feature hw_pl2 = plane.offset(base = origin.xy, distance = -3.5 in)
