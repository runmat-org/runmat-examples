    }
    feature w5_left_lite1 = extrude(profile = sketch.w5_left_lite1_s, distance = 0.125 in, mode = new, suppressed = true)
    sketch w5_right_s on plane.zx_m0_5 {
        l0_0 = line(start = [1.5 in, 24.25 in], end = [35 in, 24.25 in])
        l0_1 = line(start = [35 in, 24.25 in], end = [35 in, 47 in])
        l0_2 = line(start = [35 in, 47 in], end = [1.5 in, 47 in])
        l0_3 = line(start = [1.5 in, 47 in], end = [1.5 in, 24.25 in])
        l1_0 = line(start = [3.25 in, 26 in], end = [33.25 in, 26 in])
        l1_1 = line(start = [33.25 in, 26 in], end = [33.25 in, 45.25 in])
        l1_2 = line(start = [33.25 in, 45.25 in], end = [3.25 in, 45.25 in])
        l1_3 = line(start = [3.25 in, 45.25 in], end = [3.25 in, 26 in])
    }
    feature w5_right = extrude(profile = sketch.w5_right_s, distance = 2.25 in, mode = new, suppressed = true)
    sketch w5_right_lite0_s on plane.zx_p0_375 {
