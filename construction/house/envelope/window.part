    configuration W1 = { w = 60 in, h = 60 in, features = { w1_fix_lite0 = { suppressed = false }, w1_fix_lite1 = { suppressed = false } }, part_number = "W1", description = "Living-room window, fixed, 60 x 60 in, vinyl, double-pane low-E argon, U-0.25, SHGC 0.25" }
    configuration W2 = { w = 36 in, h = 60 in, features = { w2_lower = { suppressed = false }, w2_lower_lite0 = { suppressed = false }, w2_lower_lite1 = { suppressed = false }, w2_upper = { suppressed = false }, w2_upper_lite0 = { suppressed = false }, w2_upper_lite1 = { suppressed = false } }, part_number = "W2", description = "Window, single hung, 36 x 60 in, vinyl, double-pane low-E argon, U-0.28, SHGC 0.25" }
