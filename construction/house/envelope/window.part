runmat 0.7
std 1

// A vinyl window unit for the opening schedule (DESIGN-NOTES, "Opening schedule"): a 1 1/4 in
// frame 3 1/4 in deep, sashes 1 3/4 in wide, and an insulating glass unit of two 1/8 in low-E
// lites around a 1/2 in argon-filled space. The configurations are the schedule's types W1-W5:
// fixed, single hung (two sashes), casement and slider. Origin at the bottom corner of the rough
// opening on the outside face of the studs (the skeleton's opening frames): x along the wall,
// y inward, z up. The unit sits on 1/4 in shims over the sill pan.
part window {
    input w : length = 36 in
    input h : length = 60 in
    feature zx_m1_25 = plane.offset(base = origin.zx, distance = -1.25 in)
    feature zx_p0_25 = plane.offset(base = origin.zx, distance = 0.25 in)
    feature zx_p0_875 = plane.offset(base = origin.zx, distance = 0.875 in)
    feature zx_m0_5 = plane.offset(base = origin.zx, distance = -0.5 in)
    feature zx_p0_375 = plane.offset(base = origin.zx, distance = 0.375 in)
    feature zx_p1 = plane.offset(base = origin.zx, distance = 1 in)
    // The frame: 1 1/4 in vinyl members, 3 1/4 in deep, set 1/4 in inside the rough opening
    sketch frame_s on plane.zx_m1_25 {
        l0_0 = line(start = [0.25 in, 0.25 in], end = [input.h + 0.25 in, 0.25 in])
        l0_1 = line(start = [input.h + 0.25 in, 0.25 in], end = [input.h + 0.25 in, input.w + 0.25 in])
        l0_2 = line(start = [input.h + 0.25 in, input.w + 0.25 in], end = [0.25 in, input.w + 0.25 in])
        l0_3 = line(start = [0.25 in, input.w + 0.25 in], end = [0.25 in, 0.25 in])
        l1_0 = line(start = [1.5 in, 1.5 in], end = [input.h - 1 in, 1.5 in])
        l1_1 = line(start = [input.h - 1 in, 1.5 in], end = [input.h - 1 in, input.w - 1 in])
        l1_2 = line(start = [input.h - 1 in, input.w - 1 in], end = [1.5 in, input.w - 1 in])
        l1_3 = line(start = [1.5 in, input.w - 1 in], end = [1.5 in, 1.5 in])
    }
    feature frame = extrude(profile = sketch.frame_s, distance = 3.25 in, mode = new)
    sketch w1_fix_lite0_s on plane.zx_p0_25 {
        l0_0 = line(start = [1.5 in, 1.5 in], end = [59 in, 1.5 in])
        l0_1 = line(start = [59 in, 1.5 in], end = [59 in, 59 in])
        l0_2 = line(start = [59 in, 59 in], end = [1.5 in, 59 in])
        l0_3 = line(start = [1.5 in, 59 in], end = [1.5 in, 1.5 in])
    }
    feature w1_fix_lite0 = extrude(profile = sketch.w1_fix_lite0_s, distance = 0.125 in, mode = new, suppressed = true)
    sketch w1_fix_lite1_s on plane.zx_p0_875 {
        l0_0 = line(start = [1.5 in, 1.5 in], end = [59 in, 1.5 in])
        l0_1 = line(start = [59 in, 1.5 in], end = [59 in, 59 in])
        l0_2 = line(start = [59 in, 59 in], end = [1.5 in, 59 in])
        l0_3 = line(start = [1.5 in, 59 in], end = [1.5 in, 1.5 in])
    }
    feature w1_fix_lite1 = extrude(profile = sketch.w1_fix_lite1_s, distance = 0.125 in, mode = new, suppressed = true)
    sketch w2_lower_s on plane.zx_m0_5 {
        l0_0 = line(start = [1.5 in, 1.5 in], end = [30.25 in, 1.5 in])
        l0_1 = line(start = [30.25 in, 1.5 in], end = [30.25 in, 35 in])
        l0_2 = line(start = [30.25 in, 35 in], end = [1.5 in, 35 in])
        l0_3 = line(start = [1.5 in, 35 in], end = [1.5 in, 1.5 in])
        l1_0 = line(start = [3.25 in, 3.25 in], end = [28.5 in, 3.25 in])
        l1_1 = line(start = [28.5 in, 3.25 in], end = [28.5 in, 33.25 in])
        l1_2 = line(start = [28.5 in, 33.25 in], end = [3.25 in, 33.25 in])
        l1_3 = line(start = [3.25 in, 33.25 in], end = [3.25 in, 3.25 in])
    }
    feature w2_lower = extrude(profile = sketch.w2_lower_s, distance = 2.25 in, mode = new, suppressed = true)
    sketch w2_lower_lite0_s on plane.zx_p0_375 {
        l0_0 = line(start = [3.25 in, 3.25 in], end = [28.5 in, 3.25 in])
        l0_1 = line(start = [28.5 in, 3.25 in], end = [28.5 in, 33.25 in])
        l0_2 = line(start = [28.5 in, 33.25 in], end = [3.25 in, 33.25 in])
        l0_3 = line(start = [3.25 in, 33.25 in], end = [3.25 in, 3.25 in])
    }
    feature w2_lower_lite0 = extrude(profile = sketch.w2_lower_lite0_s, distance = 0.125 in, mode = new, suppressed = true)
    sketch w2_lower_lite1_s on plane.zx_p1 {
        l0_0 = line(start = [3.25 in, 3.25 in], end = [28.5 in, 3.25 in])
        l0_1 = line(start = [28.5 in, 3.25 in], end = [28.5 in, 33.25 in])
        l0_2 = line(start = [28.5 in, 33.25 in], end = [3.25 in, 33.25 in])
        l0_3 = line(start = [3.25 in, 33.25 in], end = [3.25 in, 3.25 in])
    }
    feature w2_lower_lite1 = extrude(profile = sketch.w2_lower_lite1_s, distance = 0.125 in, mode = new, suppressed = true)
    sketch w2_upper_s on plane.zx_m0_5 {
        l0_0 = line(start = [30.25 in, 1.5 in], end = [59 in, 1.5 in])
        l0_1 = line(start = [59 in, 1.5 in], end = [59 in, 35 in])
        l0_2 = line(start = [59 in, 35 in], end = [30.25 in, 35 in])
        l0_3 = line(start = [30.25 in, 35 in], end = [30.25 in, 1.5 in])
        l1_0 = line(start = [32 in, 3.25 in], end = [57.25 in, 3.25 in])
        l1_1 = line(start = [57.25 in, 3.25 in], end = [57.25 in, 33.25 in])
        l1_2 = line(start = [57.25 in, 33.25 in], end = [32 in, 33.25 in])
        l1_3 = line(start = [32 in, 33.25 in], end = [32 in, 3.25 in])
    }
    feature w2_upper = extrude(profile = sketch.w2_upper_s, distance = 2.25 in, mode = new, suppressed = true)
    sketch w2_upper_lite0_s on plane.zx_p0_375 {
        l0_0 = line(start = [32 in, 3.25 in], end = [57.25 in, 3.25 in])
        l0_1 = line(start = [57.25 in, 3.25 in], end = [57.25 in, 33.25 in])
        l0_2 = line(start = [57.25 in, 33.25 in], end = [32 in, 33.25 in])
        l0_3 = line(start = [32 in, 33.25 in], end = [32 in, 3.25 in])
    }
    feature w2_upper_lite0 = extrude(profile = sketch.w2_upper_lite0_s, distance = 0.125 in, mode = new, suppressed = true)
    sketch w2_upper_lite1_s on plane.zx_p1 {
        l0_0 = line(start = [32 in, 3.25 in], end = [57.25 in, 3.25 in])
        l0_1 = line(start = [57.25 in, 3.25 in], end = [57.25 in, 33.25 in])
        l0_2 = line(start = [57.25 in, 33.25 in], end = [32 in, 33.25 in])
        l0_3 = line(start = [32 in, 33.25 in], end = [32 in, 3.25 in])
    }
    feature w2_upper_lite1 = extrude(profile = sketch.w2_upper_lite1_s, distance = 0.125 in, mode = new, suppressed = true)
    sketch w3_sash_s on plane.zx_m0_5 {
        l0_0 = line(start = [1.5 in, 1.5 in], end = [47 in, 1.5 in])
        l0_1 = line(start = [47 in, 1.5 in], end = [47 in, 35 in])
        l0_2 = line(start = [47 in, 35 in], end = [1.5 in, 35 in])
        l0_3 = line(start = [1.5 in, 35 in], end = [1.5 in, 1.5 in])
        l1_0 = line(start = [3.25 in, 3.25 in], end = [45.25 in, 3.25 in])
        l1_1 = line(start = [45.25 in, 3.25 in], end = [45.25 in, 33.25 in])
        l1_2 = line(start = [45.25 in, 33.25 in], end = [3.25 in, 33.25 in])
        l1_3 = line(start = [3.25 in, 33.25 in], end = [3.25 in, 3.25 in])
    }
    feature w3_sash = extrude(profile = sketch.w3_sash_s, distance = 2.25 in, mode = new, suppressed = true)
    sketch w3_sash_lite0_s on plane.zx_p0_375 {
        l0_0 = line(start = [3.25 in, 3.25 in], end = [45.25 in, 3.25 in])
        l0_1 = line(start = [45.25 in, 3.25 in], end = [45.25 in, 33.25 in])
        l0_2 = line(start = [45.25 in, 33.25 in], end = [3.25 in, 33.25 in])
        l0_3 = line(start = [3.25 in, 33.25 in], end = [3.25 in, 3.25 in])
    }
    feature w3_sash_lite0 = extrude(profile = sketch.w3_sash_lite0_s, distance = 0.125 in, mode = new, suppressed = true)
    sketch w3_sash_lite1_s on plane.zx_p1 {
        l0_0 = line(start = [3.25 in, 3.25 in], end = [45.25 in, 3.25 in])
        l0_1 = line(start = [45.25 in, 3.25 in], end = [45.25 in, 33.25 in])
        l0_2 = line(start = [45.25 in, 33.25 in], end = [3.25 in, 33.25 in])
        l0_3 = line(start = [3.25 in, 33.25 in], end = [3.25 in, 3.25 in])
    }
    feature w3_sash_lite1 = extrude(profile = sketch.w3_sash_lite1_s, distance = 0.125 in, mode = new, suppressed = true)
    sketch w4_sash_s on plane.zx_m0_5 {
        l0_0 = line(start = [1.5 in, 1.5 in], end = [35 in, 1.5 in])
        l0_1 = line(start = [35 in, 1.5 in], end = [35 in, 23 in])
        l0_2 = line(start = [35 in, 23 in], end = [1.5 in, 23 in])
        l0_3 = line(start = [1.5 in, 23 in], end = [1.5 in, 1.5 in])
        l1_0 = line(start = [3.25 in, 3.25 in], end = [33.25 in, 3.25 in])
        l1_1 = line(start = [33.25 in, 3.25 in], end = [33.25 in, 21.25 in])
        l1_2 = line(start = [33.25 in, 21.25 in], end = [3.25 in, 21.25 in])
        l1_3 = line(start = [3.25 in, 21.25 in], end = [3.25 in, 3.25 in])
    }
    feature w4_sash = extrude(profile = sketch.w4_sash_s, distance = 2.25 in, mode = new, suppressed = true)
    sketch w4_sash_lite0_s on plane.zx_p0_375 {
        l0_0 = line(start = [3.25 in, 3.25 in], end = [33.25 in, 3.25 in])
        l0_1 = line(start = [33.25 in, 3.25 in], end = [33.25 in, 21.25 in])
        l0_2 = line(start = [33.25 in, 21.25 in], end = [3.25 in, 21.25 in])
        l0_3 = line(start = [3.25 in, 21.25 in], end = [3.25 in, 3.25 in])
    }
    feature w4_sash_lite0 = extrude(profile = sketch.w4_sash_lite0_s, distance = 0.125 in, mode = new, suppressed = true)
    sketch w4_sash_lite1_s on plane.zx_p1 {
        l0_0 = line(start = [3.25 in, 3.25 in], end = [33.25 in, 3.25 in])
        l0_1 = line(start = [33.25 in, 3.25 in], end = [33.25 in, 21.25 in])
        l0_2 = line(start = [33.25 in, 21.25 in], end = [3.25 in, 21.25 in])
        l0_3 = line(start = [3.25 in, 21.25 in], end = [3.25 in, 3.25 in])
    }
    feature w4_sash_lite1 = extrude(profile = sketch.w4_sash_lite1_s, distance = 0.125 in, mode = new, suppressed = true)
    sketch w5_left_s on plane.zx_m0_5 {
        l0_0 = line(start = [1.5 in, 1.5 in], end = [35 in, 1.5 in])
        l0_1 = line(start = [35 in, 1.5 in], end = [35 in, 24.25 in])
        l0_2 = line(start = [35 in, 24.25 in], end = [1.5 in, 24.25 in])
        l0_3 = line(start = [1.5 in, 24.25 in], end = [1.5 in, 1.5 in])
        l1_0 = line(start = [3.25 in, 3.25 in], end = [33.25 in, 3.25 in])
        l1_1 = line(start = [33.25 in, 3.25 in], end = [33.25 in, 22.5 in])
        l1_2 = line(start = [33.25 in, 22.5 in], end = [3.25 in, 22.5 in])
        l1_3 = line(start = [3.25 in, 22.5 in], end = [3.25 in, 3.25 in])
    }
    feature w5_left = extrude(profile = sketch.w5_left_s, distance = 2.25 in, mode = new, suppressed = true)
    sketch w5_left_lite0_s on plane.zx_p0_375 {
        l0_0 = line(start = [3.25 in, 3.25 in], end = [33.25 in, 3.25 in])
        l0_1 = line(start = [33.25 in, 3.25 in], end = [33.25 in, 22.5 in])
        l0_2 = line(start = [33.25 in, 22.5 in], end = [3.25 in, 22.5 in])
        l0_3 = line(start = [3.25 in, 22.5 in], end = [3.25 in, 3.25 in])
    }
    feature w5_left_lite0 = extrude(profile = sketch.w5_left_lite0_s, distance = 0.125 in, mode = new, suppressed = true)
    sketch w5_left_lite1_s on plane.zx_p1 {
        l0_0 = line(start = [3.25 in, 3.25 in], end = [33.25 in, 3.25 in])
        l0_1 = line(start = [33.25 in, 3.25 in], end = [33.25 in, 22.5 in])
        l0_2 = line(start = [33.25 in, 22.5 in], end = [3.25 in, 22.5 in])
