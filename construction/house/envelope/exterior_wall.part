    feature gypsum = extrude(profile = sketch.gypsum_s, distance = 0.5 in, mode = new)
    sketch screed_ad_s on plane.yz_m1_5 {
        l0_0 = line(start = [-0.4375 in, 1.5 in], end = [-0.4688 in, 1.5 in])
        l0_1 = line(start = [-0.4688 in, 1.5 in], end = [-0.4688 in, -2 in])
        l0_2 = line(start = [-0.4688 in, -2 in], end = [-1.5 in, -2 in])
        l0_3 = line(start = [-1.5 in, -2 in], end = [-1.5 in, -2.5 in])
        l0_4 = line(start = [-1.5 in, -2.5 in], end = [-1.4375 in, -2.5 in])
        l0_5 = line(start = [-1.4375 in, -2.5 in], end = [-1.4375 in, -2.0625 in])
