    }
    feature wrb_inner = extrude(profile = sketch.wrb_inner_s, distance = 0.0312 in, mode = new)
    feature vr_face = plane.offset(base = origin.zx, distance = input.vr_y)
    feature gyp_face = plane.offset(base = origin.zx, distance = input.gyp_y)
    sketch vapor_retarder_s on plane.vr_face {
        l0_0 = line(start = [input.zi0, input.xi0], end = [input.zi1, input.xi0])
