// The layers of one exterior wall, outside to inside, each its own body with its material
// (DESIGN-NOTES, "Envelope"): 7/8 in three-coat stucco (1/8 in finish, 3/8 in brown, 3/8 in
// scratch keyed through self-furring metal lath), two layers of Grade D building paper as the
// water-resistive barrier, then the 7/16 in OSB (framing/shear_wall.part), R-21 fiberglass batts
// in the 2x6 cavities, a variable-permeance vapor retarder and 1/2 in gypsum board. The rough
// openings of the opening schedule cut through every layer; each opening has a sill pan and a
// head drip cap, and a weep screed closes the base of the first-floor stucco 1 1/2 in below the
// sill plate and 6 in above grade. One configuration per wall line and level. Local axes as
// wall_framing: x along the wall, y inward from the outside face of the studs, z up.
// Thin sheets are drawn at their nominal thickness: each paper layer 1/32 in, the retarder 1/64 in.
part exterior_wall {
    input stucco_finish_x0 : length = -1.375 in
    input stucco_finish_x1 : length = 481.375 in
    input stucco_brown_x0 : length = -1.25 in
    input stucco_brown_x1 : length = 481.25 in
    input stucco_scratch_x0 : length = -0.875 in
    input stucco_scratch_x1 : length = 480.875 in
    input lath_x0 : length = -0.625 in
    input lath_x1 : length = 480.625 in
    input wrb_outer_x0 : length = -0.5 in
    input wrb_outer_x1 : length = 480.5 in
    input wrb_inner_x0 : length = -0.4688 in
    input wrb_inner_x1 : length = 480.4688 in
    input zo0 : length = -2 in
    input zo1 : length = 109.125 in
    input zw0 : length = 1.5 in
    input xi0 : length = 6.0156 in
    input xi1 : length = 473.9844 in
    input zi0 : length = 0.5 in
    input zi1 : length = 108.625 in
    input vr_y : length = 5.5 in
    input gyp_y : length = 5.5156 in
    input o1_l : length = 53.75 in
    input o1_r : length = 114.25 in
    input o1_b : length = 22 in
    input o1_t : length = 82.5 in
    input o2_l : length = 202.75 in
    input o2_r : length = 240.75 in
    input o2_b : length = 0 in
    input o2_t : length = 82.5 in
    input o3_l : length = 311.75 in
    input o3_r : length = 348.25 in
    input o3_b : length = 22 in
    input o3_t : length = 82.5 in
    input o4_l : length = 391.75 in
    input o4_r : length = 428.25 in
    input o4_b : length = 22 in
    input o4_t : length = 82.5 in
    feature zx_m1_375 = plane.offset(base = origin.zx, distance = -1.375 in)
    feature zx_m1_25 = plane.offset(base = origin.zx, distance = -1.25 in)
    feature zx_m0_875 = plane.offset(base = origin.zx, distance = -0.875 in)
    feature zx_m0_625 = plane.offset(base = origin.zx, distance = -0.625 in)
    feature zx_m0_5 = plane.offset(base = origin.zx, distance = -0.5 in)
    feature zx_m0_4688 = plane.offset(base = origin.zx, distance = -0.4688 in)
    feature yz_m1_5 = plane.offset(base = origin.yz, distance = -1.5 in)
    feature yz_m5_5 = plane.offset(base = origin.yz, distance = -5.5 in)
    feature zx_m1_625 = plane.offset(base = origin.zx, distance = -1.625 in)
    feature zx_m1_875 = plane.offset(base = origin.zx, distance = -1.875 in)
    sketch stucco_finish_s on plane.zx_m1_375 {
        l0_0 = line(start = [input.zo0, input.stucco_finish_x0], end = [input.zo1, input.stucco_finish_x0])
        l0_1 = line(start = [input.zo1, input.stucco_finish_x0], end = [input.zo1, input.stucco_finish_x1])
        l0_2 = line(start = [input.zo1, input.stucco_finish_x1], end = [input.zo0, input.stucco_finish_x1])
        l0_3 = line(start = [input.zo0, input.stucco_finish_x1], end = [input.zo0, input.stucco_finish_x0])
    }
    feature stucco_finish = extrude(profile = sketch.stucco_finish_s, distance = 0.125 in, mode = new)
    sketch stucco_brown_s on plane.zx_m1_25 {
