// The building envelope: the wall layers outside and inside the framing on all eight wall lines,
// the gable-end cladding, the roof and attic, and the windows and doors of the opening schedule,
// each attached to its frame in the skeleton.
import { exterior_wall } from "./exterior_wall.part"
import { gable_wall } from "./gable_wall.part"
import { roof } from "./roof.part"
import { window } from "./window.part"
import { door } from "./door.part"

assembly envelope {
    // Wall layers, one configuration per wall line and level, on the wall frames
    instance layers_a_l1 : exterior_wall = {
        configuration = { select = named, name = wall_a_l1 }
        placement = attach(
            own = { anchor = origin },
            to = {
                frame = interface
                part = house_skeleton
                from = "../house_skeleton.part"
                name = wall_a_l1
            },
        )
    }
