// Mechanical, electrical and plumbing, in building coordinates (the house places it at the
// skeleton's building frame). DESIGN-NOTES, "MEP", gives the sizing.
import { electrical } from "./electrical/electrical.assembly"
import { supply } from "./plumbing/supply.assembly"
import { dwv } from "./plumbing/dwv.assembly"
import { hvac } from "./hvac/hvac.assembly"

assembly mep {
    instance electrical : electrical = {
        placement = offset(translation = [0 in, 0 in, 0 in])
    }
    instance supply : supply = {
        placement = offset(translation = [0 in, 0 in, 0 in])
    }
    instance dwv : dwv = {
        placement = offset(translation = [0 in, 0 in, 0 in])
    }
    instance hvac : hvac = {
        placement = offset(translation = [0 in, 0 in, 0 in])
    }
}
