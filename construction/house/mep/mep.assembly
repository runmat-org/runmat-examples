// Mechanical, electrical and plumbing, in building coordinates (the house places it at the
// skeleton's building frame). DESIGN-NOTES, "MEP", gives the sizing.
assembly mep {
    use assembly electrical from "./electrical/electrical.assembly" as electrical {
        placement = offset(translation = [0 in, 0 in, 0 in])
    }
    use assembly supply from "./plumbing/supply.assembly" as supply {
        placement = offset(translation = [0 in, 0 in, 0 in])
    }
    use assembly dwv from "./plumbing/dwv.assembly" as dwv {
        placement = offset(translation = [0 in, 0 in, 0 in])
    }
    use assembly hvac from "./hvac/hvac.assembly" as hvac {
        placement = offset(translation = [0 in, 0 in, 0 in])
    }
}
