// The routed cables, in building coordinates: the 2 in PVC service-entrance conduit through wall A,
// and the NM-B home runs from the panel up into the floor joist space, through bored holes in the
// I-joist webs and the LVL beams (middle third of the depth, at least 2 ft from any post) and down
// through bored top plates to their boxes. Cables are drawn 1/2 in round in 3/4 in holes.

import { nm_b_cable, pvc_conduit } from "../../materials.module"

