// The placed electrical equipment, in building coordinates: the meter on wall A, the 200 A panel
// on the utility room's east partition, device boxes recessed in the walls and partitions with
// their devices, the disconnect and the ceiling boxes and luminaires. The circuits are in
// branch_circuits.circuit; DESIGN-NOTES, "Electrical", gives each location.

import { galvanized_steel, pvc_device, pvc_electrical_box } from "../../materials.module"

part electrical_devices {
    feature p_xy_15 = plane.offset(base = origin.xy, distance = 3 in)
    feature p_xy_14 = plane.offset(base = origin.xy, distance = 4 in)
    feature p_xy_13 = plane.offset(base = origin.xy, distance = 106.625 in)
    feature p_xy_12 = plane.offset(base = origin.xy, distance = 108.625 in)
