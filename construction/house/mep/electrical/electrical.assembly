// The electrical installation in building coordinates: the placed devices and the routed cables.
assembly electrical {
    use part electrical_devices as electrical_devices {
        placement = offset(translation = [0 in, 0 in, 0 in])
    }
    use part cable_runs as cable_runs {
        placement = offset(translation = [0 in, 0 in, 0 in])
    }
}
