runmat 0.7
std 1

// The house electrical devices: breakers, the meter, receptacles, switches, luminaires and
// hardwired equipment. They are wired in the field, so each part has `package = none`: it shows
// on the schematics and in the BOM, and no board places it.

symbol breaker_1p = {
    body = [line([-2.54, 0], [1.27, 1.27]), circle([-2.54, 0], 0.4), circle([2.54, 0], 0.4)],
    pins = [
        { name = LINE, at = [-5.08, 0], dir = right },
        { name = LOAD, at = [5.08, 0], dir = left }
    ]
}

symbol breaker_2p = {
    body = [line([-2.54, 1.27], [1.27, 2.54]), line([-2.54, -1.27], [1.27, 0]), line([0, 2.0], [0, -0.6])],
    pins = [
        { name = L1_LINE, at = [-5.08, 1.27], dir = right },
        { name = L2_LINE, at = [-5.08, -1.27], dir = right },
        { name = L1_LOAD, at = [5.08, 1.27], dir = left },
        { name = L2_LOAD, at = [5.08, -1.27], dir = left }
    ]
}

symbol meter = {
    body = [circle([0, 0], 3.81), text([0, 0], "kWh")],
    pins = [
        { name = L1_IN, at = [-7.62, 2.54], dir = right },
        { name = L2_IN, at = [-7.62, -2.54], dir = right },
        { name = N_IN, at = [-7.62, 0], dir = right },
        { name = L1_OUT, at = [7.62, 2.54], dir = left },
        { name = L2_OUT, at = [7.62, -2.54], dir = left },
        { name = N_OUT, at = [7.62, 0], dir = left }
    ]
}

symbol source = {
    body = [circle([0, 0], 3.81), arc([-1.9, 0], [0, 0], [1.9, 0])],
    pins = [
        { name = L1, at = [7.62, 2.54], dir = left },
        { name = L2, at = [7.62, -2.54], dir = left },
        { name = N, at = [7.62, 0], dir = left }
    ]
}

symbol electrode = {
    body = [line([0, 0], [0, -2.54]), line([-2.54, -2.54], [2.54, -2.54]), line([-1.52, -3.3], [1.52, -3.3]), line([-0.5, -4.06], [0.5, -4.06])],
    pins = [
        { name = GEC, at = [0, 5.08], dir = down }
    ]
}

symbol bond = {
    body = [rect([-2.54, -0.76], [2.54, 0.76])],
    pins = [
        { name = N, at = [-5.08, 0], dir = right },
        { name = EG, at = [5.08, 0], dir = left }
    ]
}

symbol receptacle = {
    body = [circle([0, 0], 3.05), line([-1.0, 0.8], [-1.0, -0.8]), line([1.0, 0.8], [1.0, -0.8])],
    pins = [
        { name = HOT, at = [-7.62, 2.54], dir = right },
        { name = NEU, at = [-7.62, 0], dir = right },
        { name = GND, at = [-7.62, -2.54], dir = right }
    ]
}

symbol gfci = {
    body = [rect([-3.81, -3.81], [3.81, 3.81]), text([0, 0], "GFCI")],
    pins = [
        { name = LINE_H, at = [-7.62, 2.54], dir = right },
        { name = LINE_N, at = [-7.62, 0], dir = right },
        { name = GND, at = [-7.62, -2.54], dir = right },
        { name = LOAD_H, at = [7.62, 2.54], dir = left },
        { name = LOAD_N, at = [7.62, 0], dir = left }
    ]
}

symbol receptacle_240 = {
    body = [circle([0, 0], 3.05), text([0, 0], "240")],
    pins = [
        { name = X, at = [-7.62, 2.54], dir = right },
        { name = Y, at = [-7.62, 1.27], dir = right },
        { name = W, at = [-7.62, -1.27], dir = right },
        { name = G, at = [-7.62, -2.54], dir = right }
    ]
}

symbol switch = {
    body = [circle([-2.54, 0], 0.5), line([-2.54, 0], [2.0, 1.8]), circle([2.54, 0], 0.5)],
    pins = [
        { name = LINE, at = [-5.08, 0], dir = right },
        { name = LOAD, at = [5.08, 0], dir = left },
        { name = GND, at = [0, -5.08], dir = up }
    ]
}

symbol fixture = {
    body = [circle([0, 0], 2.54), line([-1.8, 1.8], [1.8, -1.8]), line([-1.8, -1.8], [1.8, 1.8])],
    pins = [
        { name = HOT, at = [-7.62, 2.54], dir = right },
        { name = NEU, at = [-7.62, 0], dir = right },
