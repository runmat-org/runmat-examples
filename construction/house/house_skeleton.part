// The house skeleton: the footprint, grid lines A-D and 1-5, the levels, the roof planes and
// the frames every assembly attaches to. Building x runs east along grid A, y north along grid 1,
// z up from the top of the slab; the origin is the south-west corner of the outside face of the
// wall framing. Every subassembly reads its place from here.
part house_skeleton {
    input width : length = 40 ft
    input depth : length = 30 ft
    input stud_spacing : length = 16 in
    input truss_spacing : length = 24 in
    input pitch : real = 0.5

    feature east = axis.through(a = point(0 in, 0 in, 0 in), b = point(12 in, 0 in, 0 in))
    feature west = axis.through(a = point(12 in, 0 in, 0 in), b = point(0 in, 0 in, 0 in))
    feature north = axis.through(a = point(0 in, 0 in, 0 in), b = point(0 in, 12 in, 0 in))
    feature south = axis.through(a = point(0 in, 12 in, 0 in), b = point(0 in, 0 in, 0 in))
    // Grid lines (vertical planes)
    feature grid_a = plane.offset(base = origin.zx, distance = 0 in)
    feature grid_b = plane.offset(base = origin.zx, distance = 144 in)
    feature grid_c = plane.offset(base = origin.zx, distance = 224 in)
    feature grid_d = plane.offset(base = origin.zx, distance = 360 in)
    feature grid_1 = plane.offset(base = origin.yz, distance = 0 in)
    feature grid_2 = plane.offset(base = origin.yz, distance = 120 in)
    feature grid_3 = plane.offset(base = origin.yz, distance = 232 in)
    feature grid_4 = plane.offset(base = origin.yz, distance = 360 in)
    feature grid_5 = plane.offset(base = origin.yz, distance = 480 in)
    // Levels (horizontal planes)
    feature top_of_footing = plane.offset(base = origin.xy, distance = -22 in)
    feature grade = plane.offset(base = origin.xy, distance = -8 in)
    feature top_of_slab = plane.offset(base = origin.xy, distance = 0 in)
    feature top_plate_l1 = plane.offset(base = origin.xy, distance = 109.125 in)
    feature second_floor = plane.offset(base = origin.xy, distance = 121.75 in)
    feature top_plate = plane.offset(base = origin.xy, distance = 218.875 in)
    feature ridge = plane.offset(base = origin.xy, distance = 316.2881 in)
    // Roof planes: the tops of the top chords, 6:12, meeting at the ridge
    feature roof_south = plane.three_point(
        a = point(0 in, 0 in, 226.2881 in),
        b = point(480 in, 0 in, 226.2881 in),
        c = point(0 in, 180 in, 316.2881 in),
    )
    feature roof_north = plane.three_point(
        a = point(0 in, 360 in, 226.2881 in),
        b = point(0 in, 180 in, 316.2881 in),
        c = point(480 in, 360 in, 226.2881 in),
    )
    // Frames the assemblies attach to
    feature building = frame.at(origin = point(0 in, 0 in, 0 in), z = origin.z, x = axis.east)
    feature wall_a_l1 = frame.at(origin = point(0 in, 0 in, 0 in), z = origin.z, x = axis.east)
    feature wall_d_l1 = frame.at(origin = point(480 in, 360 in, 0 in), z = origin.z, x = axis.west)
    feature wall_1_l1 = frame.at(origin = point(0 in, 354.5 in, 0 in), z = origin.z, x = axis.south)
    feature wall_5_l1 = frame.at(origin = point(480 in, 5.5 in, 0 in), z = origin.z, x = axis.north)
    feature wall_a_l2 = frame.at(origin = point(0 in, 0 in, 121.75 in), z = origin.z, x = axis.east)
    feature wall_d_l2 = frame.at(origin = point(480 in, 360 in, 121.75 in), z = origin.z, x = axis.west)
    feature wall_1_l2 = frame.at(origin = point(0 in, 354.5 in, 121.75 in), z = origin.z, x = axis.south)
    feature wall_5_l2 = frame.at(origin = point(480 in, 5.5 in, 121.75 in), z = origin.z, x = axis.north)
    feature floor_l2 = frame.at(origin = point(0 in, 0 in, 109.125 in), z = origin.z, x = axis.east)
    feature roof = frame.at(origin = point(0 in, 0 in, 218.875 in), z = origin.z, x = axis.east)
    feature post_b2 = frame.at(origin = point(120 in, 144 in, 0 in), z = origin.z, x = axis.east)
    feature post_b3 = frame.at(origin = point(232 in, 144 in, 0 in), z = origin.z, x = axis.east)
    feature post_b4 = frame.at(origin = point(360 in, 144 in, 0 in), z = origin.z, x = axis.east)
    feature post_c2 = frame.at(origin = point(120 in, 224 in, 0 in), z = origin.z, x = axis.east)
    feature post_c3 = frame.at(origin = point(232 in, 224 in, 0 in), z = origin.z, x = axis.east)
    feature post_c4 = frame.at(origin = point(360 in, 224 in, 0 in), z = origin.z, x = axis.east)
    feature opening_a_l1_1 = frame.at(origin = point(53.75 in, 0 in, 22 in), z = origin.z, x = axis.east)
    feature opening_a_l1_2 = frame.at(origin = point(202.75 in, 0 in, 0 in), z = origin.z, x = axis.east)
    feature opening_a_l1_3 = frame.at(origin = point(311.75 in, 0 in, 22 in), z = origin.z, x = axis.east)
    feature opening_a_l1_4 = frame.at(origin = point(391.75 in, 0 in, 22 in), z = origin.z, x = axis.east)
    feature opening_d_l1_1 = frame.at(origin = point(404.25 in, 360 in, 46 in), z = origin.z, x = axis.west)
    feature opening_d_l1_2 = frame.at(origin = point(256.75 in, 360 in, 0 in), z = origin.z, x = axis.west)
    feature opening_d_l1_3 = frame.at(origin = point(98.25 in, 360 in, 22 in), z = origin.z, x = axis.west)
    feature opening_1_l1_1 = frame.at(origin = point(0 in, 282.75 in, 22 in), z = origin.z, x = axis.south)
    feature opening_1_l1_2 = frame.at(origin = point(0 in, 104.75 in, 22 in), z = origin.z, x = axis.south)
    feature opening_5_l1_1 = frame.at(origin = point(480 in, 68.25 in, 22 in), z = origin.z, x = axis.north)
    feature opening_5_l1_2 = frame.at(origin = point(480 in, 277.25 in, 22 in), z = origin.z, x = axis.north)
    feature opening_a_l2_1 = frame.at(origin = point(51.75 in, 0 in, 156.125 in), z = origin.z, x = axis.east)
    feature opening_a_l2_2 = frame.at(origin = point(151.75 in, 0 in, 156.125 in), z = origin.z, x = axis.east)
    feature opening_a_l2_3 = frame.at(origin = point(291.75 in, 0 in, 156.125 in), z = origin.z, x = axis.east)
    feature opening_a_l2_4 = frame.at(origin = point(391.75 in, 0 in, 156.125 in), z = origin.z, x = axis.east)
    feature opening_d_l2_1 = frame.at(origin = point(428.25 in, 360 in, 156.125 in), z = origin.z, x = axis.west)
    feature opening_d_l2_2 = frame.at(origin = point(322.25 in, 360 in, 168.125 in), z = origin.z, x = axis.west)
    feature opening_d_l2_3 = frame.at(origin = point(182.25 in, 360 in, 168.125 in), z = origin.z, x = axis.west)
    feature opening_d_l2_4 = frame.at(origin = point(88.25 in, 360 in, 156.125 in), z = origin.z, x = axis.west)
    feature opening_1_l2_1 = frame.at(origin = point(0 in, 282.75 in, 156.125 in), z = origin.z, x = axis.south)
    feature opening_1_l2_2 = frame.at(origin = point(0 in, 104.75 in, 156.125 in), z = origin.z, x = axis.south)
    feature opening_5_l2_1 = frame.at(origin = point(480 in, 68.25 in, 156.125 in), z = origin.z, x = axis.north)
    feature opening_5_l2_2 = frame.at(origin = point(480 in, 277.25 in, 156.125 in), z = origin.z, x = axis.north)

    export grid_a = datum(datum = feature(feature = grid_a))
    export grid_b = datum(datum = feature(feature = grid_b))
    export grid_c = datum(datum = feature(feature = grid_c))
    export grid_d = datum(datum = feature(feature = grid_d))
    export grid_1 = datum(datum = feature(feature = grid_1))
    export grid_2 = datum(datum = feature(feature = grid_2))
    export grid_3 = datum(datum = feature(feature = grid_3))
    export grid_4 = datum(datum = feature(feature = grid_4))
    export grid_5 = datum(datum = feature(feature = grid_5))
    export top_of_footing = datum(datum = feature(feature = top_of_footing))
    export grade = datum(datum = feature(feature = grade))
    export top_of_slab = datum(datum = feature(feature = top_of_slab))
    export top_plate_l1 = datum(datum = feature(feature = top_plate_l1))
    export second_floor = datum(datum = feature(feature = second_floor))
    export top_plate = datum(datum = feature(feature = top_plate))
    export ridge = datum(datum = feature(feature = ridge))
    export roof_south = datum(datum = feature(feature = roof_south))
    export roof_north = datum(datum = feature(feature = roof_north))
    export building = datum(datum = feature(feature = building))
    export wall_a_l1 = datum(datum = feature(feature = wall_a_l1))
    export wall_d_l1 = datum(datum = feature(feature = wall_d_l1))
    export wall_1_l1 = datum(datum = feature(feature = wall_1_l1))
    export wall_5_l1 = datum(datum = feature(feature = wall_5_l1))
    export wall_a_l2 = datum(datum = feature(feature = wall_a_l2))
    export wall_d_l2 = datum(datum = feature(feature = wall_d_l2))
    export wall_1_l2 = datum(datum = feature(feature = wall_1_l2))
    export wall_5_l2 = datum(datum = feature(feature = wall_5_l2))
    export floor_l2 = datum(datum = feature(feature = floor_l2))
    export roof = datum(datum = feature(feature = roof))
    export post_b2 = datum(datum = feature(feature = post_b2))
    export post_b3 = datum(datum = feature(feature = post_b3))
    export post_b4 = datum(datum = feature(feature = post_b4))
    export post_c2 = datum(datum = feature(feature = post_c2))
    export post_c3 = datum(datum = feature(feature = post_c3))
    export post_c4 = datum(datum = feature(feature = post_c4))
    export opening_a_l1_1 = datum(datum = feature(feature = opening_a_l1_1))
    export opening_a_l1_2 = datum(datum = feature(feature = opening_a_l1_2))
    export opening_a_l1_3 = datum(datum = feature(feature = opening_a_l1_3))
    export opening_a_l1_4 = datum(datum = feature(feature = opening_a_l1_4))
    export opening_d_l1_1 = datum(datum = feature(feature = opening_d_l1_1))
    export opening_d_l1_2 = datum(datum = feature(feature = opening_d_l1_2))
    export opening_d_l1_3 = datum(datum = feature(feature = opening_d_l1_3))
    export opening_1_l1_1 = datum(datum = feature(feature = opening_1_l1_1))
    export opening_1_l1_2 = datum(datum = feature(feature = opening_1_l1_2))
    export opening_5_l1_1 = datum(datum = feature(feature = opening_5_l1_1))
    export opening_5_l1_2 = datum(datum = feature(feature = opening_5_l1_2))
    export opening_a_l2_1 = datum(datum = feature(feature = opening_a_l2_1))
    export opening_a_l2_2 = datum(datum = feature(feature = opening_a_l2_2))
    export opening_a_l2_3 = datum(datum = feature(feature = opening_a_l2_3))
    export opening_a_l2_4 = datum(datum = feature(feature = opening_a_l2_4))
    export opening_d_l2_1 = datum(datum = feature(feature = opening_d_l2_1))
    export opening_d_l2_2 = datum(datum = feature(feature = opening_d_l2_2))
    export opening_d_l2_3 = datum(datum = feature(feature = opening_d_l2_3))
    export opening_d_l2_4 = datum(datum = feature(feature = opening_d_l2_4))
    export opening_1_l2_1 = datum(datum = feature(feature = opening_1_l2_1))
    export opening_1_l2_2 = datum(datum = feature(feature = opening_1_l2_2))
    export opening_5_l2_1 = datum(datum = feature(feature = opening_5_l2_1))
    export opening_5_l2_2 = datum(datum = feature(feature = opening_5_l2_2))
    export width = value(input = width)
    export depth = value(input = depth)
    export stud_spacing = value(input = stud_spacing)
    export truss_spacing = value(input = truss_spacing)
    export pitch = value(input = pitch)
}
