runmat 0.7
std 1

// The house skeleton: the footprint, grid lines A-D and 1-5, the levels, the roof planes and
// the frames every assembly attaches to. Building x runs east along grid A, y north along grid 1,
// z up from the top of the slab; the origin is the south-west corner of the outside face of the
// wall framing. Every subassembly reads its place from here.
part house_skeleton {
    input width : length = 40 ft
    input depth : length = 30 ft
    input stud_spacing : length = 16 in
    input truss_spacing : length = 24 in
    input pitch : real = 0.5

    feature east = axis.through(a = point(0 in, 0 in, 0 in), b = point(12 in, 0 in, 0 in))
    feature west = axis.through(a = point(12 in, 0 in, 0 in), b = point(0 in, 0 in, 0 in))
    feature north = axis.through(a = point(0 in, 0 in, 0 in), b = point(0 in, 12 in, 0 in))
    feature south = axis.through(a = point(0 in, 12 in, 0 in), b = point(0 in, 0 in, 0 in))
    // Grid lines (vertical planes)
    feature grid_a = plane.offset(base = origin.zx, distance = 0 in)
    feature grid_b = plane.offset(base = origin.zx, distance = 144 in)
    feature grid_c = plane.offset(base = origin.zx, distance = 224 in)
    feature grid_d = plane.offset(base = origin.zx, distance = 360 in)
    feature grid_1 = plane.offset(base = origin.yz, distance = 0 in)
    feature grid_2 = plane.offset(base = origin.yz, distance = 120 in)
    feature grid_3 = plane.offset(base = origin.yz, distance = 232 in)
    feature grid_4 = plane.offset(base = origin.yz, distance = 360 in)
    feature grid_5 = plane.offset(base = origin.yz, distance = 480 in)
    // Levels (horizontal planes)
    feature top_of_footing = plane.offset(base = origin.xy, distance = -22 in)
    feature grade = plane.offset(base = origin.xy, distance = -8 in)
    feature top_of_slab = plane.offset(base = origin.xy, distance = 0 in)
    feature top_plate_l1 = plane.offset(base = origin.xy, distance = 109.125 in)
    feature second_floor = plane.offset(base = origin.xy, distance = 121.75 in)
    feature top_plate = plane.offset(base = origin.xy, distance = 218.875 in)
    feature ridge = plane.offset(base = origin.xy, distance = 316.2881 in)
    // Roof planes: the tops of the top chords, 6:12, meeting at the ridge
    feature roof_south = plane.three_point(a = point(0 in, 0 in, 226.2881 in), b = point(480 in, 0 in, 226.2881 in), c = point(0 in, 180 in, 316.2881 in))
    feature roof_north = plane.three_point(a = point(0 in, 360 in, 226.2881 in), b = point(0 in, 180 in, 316.2881 in), c = point(480 in, 360 in, 226.2881 in))
    // Frames the assemblies attach to
    feature building = frame(frame = at, origin = point(0 in, 0 in, 0 in), z = origin.z, x = axis.east)
    feature wall_a_l1 = frame(frame = at, origin = point(0 in, 0 in, 0 in), z = origin.z, x = axis.east)
    feature wall_d_l1 = frame(frame = at, origin = point(480 in, 360 in, 0 in), z = origin.z, x = axis.west)
    feature wall_1_l1 = frame(frame = at, origin = point(0 in, 354.5 in, 0 in), z = origin.z, x = axis.south)
    feature wall_5_l1 = frame(frame = at, origin = point(480 in, 5.5 in, 0 in), z = origin.z, x = axis.north)
    feature wall_a_l2 = frame(frame = at, origin = point(0 in, 0 in, 121.75 in), z = origin.z, x = axis.east)
    feature wall_d_l2 = frame(frame = at, origin = point(480 in, 360 in, 121.75 in), z = origin.z, x = axis.west)
    feature wall_1_l2 = frame(frame = at, origin = point(0 in, 354.5 in, 121.75 in), z = origin.z, x = axis.south)
    feature wall_5_l2 = frame(frame = at, origin = point(480 in, 5.5 in, 121.75 in), z = origin.z, x = axis.north)
    feature floor_l2 = frame(frame = at, origin = point(0 in, 0 in, 109.125 in), z = origin.z, x = axis.east)
    feature roof = frame(frame = at, origin = point(0 in, 0 in, 218.875 in), z = origin.z, x = axis.east)
    feature post_b2 = frame(frame = at, origin = point(120 in, 144 in, 0 in), z = origin.z, x = axis.east)
    feature post_b3 = frame(frame = at, origin = point(232 in, 144 in, 0 in), z = origin.z, x = axis.east)
    feature post_b4 = frame(frame = at, origin = point(360 in, 144 in, 0 in), z = origin.z, x = axis.east)
    feature post_c2 = frame(frame = at, origin = point(120 in, 224 in, 0 in), z = origin.z, x = axis.east)
    feature post_c3 = frame(frame = at, origin = point(232 in, 224 in, 0 in), z = origin.z, x = axis.east)
    feature post_c4 = frame(frame = at, origin = point(360 in, 224 in, 0 in), z = origin.z, x = axis.east)
    feature opening_a_l1_1 = frame(frame = at, origin = point(53.75 in, 0 in, 22 in), z = origin.z, x = axis.east)
    feature opening_a_l1_2 = frame(frame = at, origin = point(202.75 in, 0 in, 0 in), z = origin.z, x = axis.east)
    feature opening_a_l1_3 = frame(frame = at, origin = point(311.75 in, 0 in, 22 in), z = origin.z, x = axis.east)
    feature opening_a_l1_4 = frame(frame = at, origin = point(391.75 in, 0 in, 22 in), z = origin.z, x = axis.east)
    feature opening_d_l1_1 = frame(frame = at, origin = point(404.25 in, 360 in, 46 in), z = origin.z, x = axis.west)
    feature opening_d_l1_2 = frame(frame = at, origin = point(256.75 in, 360 in, 0 in), z = origin.z, x = axis.west)
    feature opening_d_l1_3 = frame(frame = at, origin = point(98.25 in, 360 in, 22 in), z = origin.z, x = axis.west)
    feature opening_1_l1_1 = frame(frame = at, origin = point(0 in, 282.75 in, 22 in), z = origin.z, x = axis.south)
    feature opening_1_l1_2 = frame(frame = at, origin = point(0 in, 104.75 in, 22 in), z = origin.z, x = axis.south)
    feature opening_5_l1_1 = frame(frame = at, origin = point(480 in, 68.25 in, 22 in), z = origin.z, x = axis.north)
    feature opening_5_l1_2 = frame(frame = at, origin = point(480 in, 277.25 in, 22 in), z = origin.z, x = axis.north)
    feature opening_a_l2_1 = frame(frame = at, origin = point(51.75 in, 0 in, 156.125 in), z = origin.z, x = axis.east)
    feature opening_a_l2_2 = frame(frame = at, origin = point(151.75 in, 0 in, 156.125 in), z = origin.z, x = axis.east)
    feature opening_a_l2_3 = frame(frame = at, origin = point(291.75 in, 0 in, 156.125 in), z = origin.z, x = axis.east)
    feature opening_a_l2_4 = frame(frame = at, origin = point(391.75 in, 0 in, 156.125 in), z = origin.z, x = axis.east)
    feature opening_d_l2_1 = frame(frame = at, origin = point(428.25 in, 360 in, 156.125 in), z = origin.z, x = axis.west)
    feature opening_d_l2_2 = frame(frame = at, origin = point(322.25 in, 360 in, 168.125 in), z = origin.z, x = axis.west)
    feature opening_d_l2_3 = frame(frame = at, origin = point(182.25 in, 360 in, 168.125 in), z = origin.z, x = axis.west)
    feature opening_d_l2_4 = frame(frame = at, origin = point(88.25 in, 360 in, 156.125 in), z = origin.z, x = axis.west)
    feature opening_1_l2_1 = frame(frame = at, origin = point(0 in, 282.75 in, 156.125 in), z = origin.z, x = axis.south)
    feature opening_1_l2_2 = frame(frame = at, origin = point(0 in, 104.75 in, 156.125 in), z = origin.z, x = axis.south)
    feature opening_5_l2_1 = frame(frame = at, origin = point(480 in, 68.25 in, 156.125 in), z = origin.z, x = axis.north)
    feature opening_5_l2_2 = frame(frame = at, origin = point(480 in, 277.25 in, 156.125 in), z = origin.z, x = axis.north)

    publish grid_a = datum(datum = { datum = feature, feature = grid_a })
    publish grid_b = datum(datum = { datum = feature, feature = grid_b })
    publish grid_c = datum(datum = { datum = feature, feature = grid_c })
    publish grid_d = datum(datum = { datum = feature, feature = grid_d })
    publish grid_1 = datum(datum = { datum = feature, feature = grid_1 })
    publish grid_2 = datum(datum = { datum = feature, feature = grid_2 })
    publish grid_3 = datum(datum = { datum = feature, feature = grid_3 })
    publish grid_4 = datum(datum = { datum = feature, feature = grid_4 })
    publish grid_5 = datum(datum = { datum = feature, feature = grid_5 })
    publish top_of_footing = datum(datum = { datum = feature, feature = top_of_footing })
    publish grade = datum(datum = { datum = feature, feature = grade })
    publish top_of_slab = datum(datum = { datum = feature, feature = top_of_slab })
    publish top_plate_l1 = datum(datum = { datum = feature, feature = top_plate_l1 })
    publish second_floor = datum(datum = { datum = feature, feature = second_floor })
    publish top_plate = datum(datum = { datum = feature, feature = top_plate })
    publish ridge = datum(datum = { datum = feature, feature = ridge })
    publish roof_south = datum(datum = { datum = feature, feature = roof_south })
    publish roof_north = datum(datum = { datum = feature, feature = roof_north })
    publish building = datum(datum = { datum = feature, feature = building })
    publish wall_a_l1 = datum(datum = { datum = feature, feature = wall_a_l1 })
    publish wall_d_l1 = datum(datum = { datum = feature, feature = wall_d_l1 })
    publish wall_1_l1 = datum(datum = { datum = feature, feature = wall_1_l1 })
    publish wall_5_l1 = datum(datum = { datum = feature, feature = wall_5_l1 })
    publish wall_a_l2 = datum(datum = { datum = feature, feature = wall_a_l2 })
    publish wall_d_l2 = datum(datum = { datum = feature, feature = wall_d_l2 })
    publish wall_1_l2 = datum(datum = { datum = feature, feature = wall_1_l2 })
    publish wall_5_l2 = datum(datum = { datum = feature, feature = wall_5_l2 })
    publish floor_l2 = datum(datum = { datum = feature, feature = floor_l2 })
    publish roof = datum(datum = { datum = feature, feature = roof })
    publish post_b2 = datum(datum = { datum = feature, feature = post_b2 })
    publish post_b3 = datum(datum = { datum = feature, feature = post_b3 })
    publish post_b4 = datum(datum = { datum = feature, feature = post_b4 })
    publish post_c2 = datum(datum = { datum = feature, feature = post_c2 })
    publish post_c3 = datum(datum = { datum = feature, feature = post_c3 })
    publish post_c4 = datum(datum = { datum = feature, feature = post_c4 })
    publish opening_a_l1_1 = datum(datum = { datum = feature, feature = opening_a_l1_1 })
    publish opening_a_l1_2 = datum(datum = { datum = feature, feature = opening_a_l1_2 })
    publish opening_a_l1_3 = datum(datum = { datum = feature, feature = opening_a_l1_3 })
    publish opening_a_l1_4 = datum(datum = { datum = feature, feature = opening_a_l1_4 })
    publish opening_d_l1_1 = datum(datum = { datum = feature, feature = opening_d_l1_1 })
    publish opening_d_l1_2 = datum(datum = { datum = feature, feature = opening_d_l1_2 })
    publish opening_d_l1_3 = datum(datum = { datum = feature, feature = opening_d_l1_3 })
    publish opening_1_l1_1 = datum(datum = { datum = feature, feature = opening_1_l1_1 })
    publish opening_1_l1_2 = datum(datum = { datum = feature, feature = opening_1_l1_2 })
    publish opening_5_l1_1 = datum(datum = { datum = feature, feature = opening_5_l1_1 })
    publish opening_5_l1_2 = datum(datum = { datum = feature, feature = opening_5_l1_2 })
    publish opening_a_l2_1 = datum(datum = { datum = feature, feature = opening_a_l2_1 })
    publish opening_a_l2_2 = datum(datum = { datum = feature, feature = opening_a_l2_2 })
    publish opening_a_l2_3 = datum(datum = { datum = feature, feature = opening_a_l2_3 })
    publish opening_a_l2_4 = datum(datum = { datum = feature, feature = opening_a_l2_4 })
    publish opening_d_l2_1 = datum(datum = { datum = feature, feature = opening_d_l2_1 })
    publish opening_d_l2_2 = datum(datum = { datum = feature, feature = opening_d_l2_2 })
    publish opening_d_l2_3 = datum(datum = { datum = feature, feature = opening_d_l2_3 })
    publish opening_d_l2_4 = datum(datum = { datum = feature, feature = opening_d_l2_4 })
    publish opening_1_l2_1 = datum(datum = { datum = feature, feature = opening_1_l2_1 })
    publish opening_1_l2_2 = datum(datum = { datum = feature, feature = opening_1_l2_2 })
    publish opening_5_l2_1 = datum(datum = { datum = feature, feature = opening_5_l2_1 })
    publish opening_5_l2_2 = datum(datum = { datum = feature, feature = opening_5_l2_2 })
    publish width = value(input = width)
    publish depth = value(input = depth)
    publish stud_spacing = value(input = stud_spacing)
    publish truss_spacing = value(input = truss_spacing)
    publish pitch = value(input = pitch)
}
