// An interior partition: 2x4 studs at 16 in o.c. on a bottom plate, a double top plate, and 1/2 in
// gypsum board on both faces (4 1/2 in overall). Partitions carry no load: they stop under the
// ceiling board, and their doors take a flat 2x4 header over king studs. Each configuration is one
// wall of the floor plan (DESIGN-NOTES, "Floor plan"); the two guard configurations are the
// 36 in half walls at the stair opening. Local axes: x along the wall, y through it (0 to 4 1/2 in),
// z up from the slab or subfloor.
part partitions {
    input len : length = 150 in
    input h : length = 108.625 in
    input n : count = 8
    input d1 : length = 40 in
    input d2 : length = 40 in
    input d3 : length = 40 in
    feature zx_p0_5 = plane.offset(base = origin.zx, distance = 0.5 in)
    feature zx_p4 = plane.offset(base = origin.zx, distance = 4 in)
    // Plates: a 2x4 bottom plate and a double top plate
    sketch bottom_s on plane.zx_p0_5 {
        l0_0 = line(start = [0 in, 0 in], end = [1.5 in, 0 in])
        l0_1 = line(start = [1.5 in, 0 in], end = [1.5 in, input.len])
        l0_2 = line(start = [1.5 in, input.len], end = [0 in, input.len])
        l0_3 = line(start = [0 in, input.len], end = [0 in, 0 in])
    }
    feature bottom = extrude(profile = sketch.bottom_s, distance = 3.5 in, mode = new)
    sketch top1_s on plane.zx_p0_5 {
        l0_0 = line(start = [input.h - 3 in, 0 in], end = [input.h - 1.5 in, 0 in])
        l0_1 = line(start = [input.h - 1.5 in, 0 in], end = [input.h - 1.5 in, input.len])
        l0_2 = line(start = [input.h - 1.5 in, input.len], end = [input.h - 3 in, input.len])
        l0_3 = line(start = [input.h - 3 in, input.len], end = [input.h - 3 in, 0 in])
    }
    feature top1 = extrude(profile = sketch.top1_s, distance = 3.5 in, mode = new)
    sketch top2_s on plane.zx_p0_5 {
        l0_0 = line(start = [input.h - 1.5 in, 0 in], end = [input.h, 0 in])
        l0_1 = line(start = [input.h, 0 in], end = [input.h, input.len])
        l0_2 = line(start = [input.h, input.len], end = [input.h - 1.5 in, input.len])
        l0_3 = line(start = [input.h - 1.5 in, input.len], end = [input.h - 1.5 in, 0 in])
    }
    feature top2 = extrude(profile = sketch.top2_s, distance = 3.5 in, mode = new)
    // Studs: end studs and 2x4s at 16 in o.c.
    sketch end0_s on plane.zx_p0_5 {
        l0_0 = line(start = [1.5 in, 0 in], end = [input.h - 3 in, 0 in])
        l0_1 = line(start = [input.h - 3 in, 0 in], end = [input.h - 3 in, 1.5 in])
        l0_2 = line(start = [input.h - 3 in, 1.5 in], end = [1.5 in, 1.5 in])
        l0_3 = line(start = [1.5 in, 1.5 in], end = [1.5 in, 0 in])
    }
    feature end0 = extrude(profile = sketch.end0_s, distance = 3.5 in, mode = new)
    sketch end1_s on plane.zx_p0_5 {
        l0_0 = line(start = [1.5 in, input.len - 1.5 in], end = [input.h - 3 in, input.len - 1.5 in])
        l0_1 = line(start = [input.h - 3 in, input.len - 1.5 in], end = [input.h - 3 in, input.len])
        l0_2 = line(start = [input.h - 3 in, input.len], end = [1.5 in, input.len])
        l0_3 = line(start = [1.5 in, input.len], end = [1.5 in, input.len - 1.5 in])
    }
    feature end1 = extrude(profile = sketch.end1_s, distance = 3.5 in, mode = new)
    sketch stud_s on plane.zx_p0_5 {
        l0_0 = line(start = [1.5 in, 15.25 in], end = [input.h - 3 in, 15.25 in])
        l0_1 = line(start = [input.h - 3 in, 15.25 in], end = [input.h - 3 in, 16.75 in])
        l0_2 = line(start = [input.h - 3 in, 16.75 in], end = [1.5 in, 16.75 in])
        l0_3 = line(start = [1.5 in, 16.75 in], end = [1.5 in, 15.25 in])
    }
    feature stud = extrude(profile = sketch.stud_s, distance = 3.5 in, mode = new)
    feature studs = pattern(bodies = [feature.stud.body], layout = linear(direction = origin.x, spacing = 16 in, count = input.n))
    // Door openings: 32 x 82 1/2 in rough openings, king studs and a flat 2x4 header
    sketch d1_zone_s on plane.zx_p0_5 {
        l0_0 = line(start = [1.5 in, input.d1 - 1.5 in], end = [84 in, input.d1 - 1.5 in])
        l0_1 = line(start = [84 in, input.d1 - 1.5 in], end = [84 in, input.d1 + 33.5 in])
        l0_2 = line(start = [84 in, input.d1 + 33.5 in], end = [1.5 in, input.d1 + 33.5 in])
        l0_3 = line(start = [1.5 in, input.d1 + 33.5 in], end = [1.5 in, input.d1 - 1.5 in])
    }
    feature d1_zone = extrude(profile = sketch.d1_zone_s, distance = 3.5 in, mode = cut)
    sketch d1_plate_s on plane.zx_p0_5 {
        l0_0 = line(start = [0 in, input.d1], end = [1.5 in, input.d1])
        l0_1 = line(start = [1.5 in, input.d1], end = [1.5 in, input.d1 + 32 in])
        l0_2 = line(start = [1.5 in, input.d1 + 32 in], end = [0 in, input.d1 + 32 in])
        l0_3 = line(start = [0 in, input.d1 + 32 in], end = [0 in, input.d1])
    }
    feature d1_plate = extrude(profile = sketch.d1_plate_s, distance = 3.5 in, mode = cut)
    sketch d1_king_l_s on plane.zx_p0_5 {
        l0_0 = line(start = [1.5 in, input.d1 - 1.5 in], end = [input.h - 3 in, input.d1 - 1.5 in])
        l0_1 = line(start = [input.h - 3 in, input.d1 - 1.5 in], end = [input.h - 3 in, input.d1])
        l0_2 = line(start = [input.h - 3 in, input.d1], end = [1.5 in, input.d1])
        l0_3 = line(start = [1.5 in, input.d1], end = [1.5 in, input.d1 - 1.5 in])
    }
    feature d1_king_l = extrude(profile = sketch.d1_king_l_s, distance = 3.5 in, mode = new)
    sketch d1_king_r_s on plane.zx_p0_5 {
        l0_0 = line(start = [1.5 in, input.d1 + 32 in], end = [input.h - 3 in, input.d1 + 32 in])
        l0_1 = line(start = [input.h - 3 in, input.d1 + 32 in], end = [input.h - 3 in, input.d1 + 33.5 in])
        l0_2 = line(start = [input.h - 3 in, input.d1 + 33.5 in], end = [1.5 in, input.d1 + 33.5 in])
        l0_3 = line(start = [1.5 in, input.d1 + 33.5 in], end = [1.5 in, input.d1 + 32 in])
    }
    feature d1_king_r = extrude(profile = sketch.d1_king_r_s, distance = 3.5 in, mode = new)
    sketch d1_header_s on plane.zx_p0_5 {
        l0_0 = line(start = [82.5 in, input.d1], end = [84 in, input.d1])
        l0_1 = line(start = [84 in, input.d1], end = [84 in, input.d1 + 32 in])
        l0_2 = line(start = [84 in, input.d1 + 32 in], end = [82.5 in, input.d1 + 32 in])
        l0_3 = line(start = [82.5 in, input.d1 + 32 in], end = [82.5 in, input.d1])
    }
    feature d1_header = extrude(profile = sketch.d1_header_s, distance = 3.5 in, mode = new)
    sketch d2_zone_s on plane.zx_p0_5 {
        l0_0 = line(start = [1.5 in, input.d2 - 1.5 in], end = [84 in, input.d2 - 1.5 in])
        l0_1 = line(start = [84 in, input.d2 - 1.5 in], end = [84 in, input.d2 + 33.5 in])
        l0_2 = line(start = [84 in, input.d2 + 33.5 in], end = [1.5 in, input.d2 + 33.5 in])
        l0_3 = line(start = [1.5 in, input.d2 + 33.5 in], end = [1.5 in, input.d2 - 1.5 in])
    }
    feature d2_zone = extrude(profile = sketch.d2_zone_s, distance = 3.5 in, mode = cut)
    sketch d2_plate_s on plane.zx_p0_5 {
        l0_0 = line(start = [0 in, input.d2], end = [1.5 in, input.d2])
        l0_1 = line(start = [1.5 in, input.d2], end = [1.5 in, input.d2 + 32 in])
        l0_2 = line(start = [1.5 in, input.d2 + 32 in], end = [0 in, input.d2 + 32 in])
        l0_3 = line(start = [0 in, input.d2 + 32 in], end = [0 in, input.d2])
    }
    feature d2_plate = extrude(profile = sketch.d2_plate_s, distance = 3.5 in, mode = cut)
    sketch d2_king_l_s on plane.zx_p0_5 {
        l0_0 = line(start = [1.5 in, input.d2 - 1.5 in], end = [input.h - 3 in, input.d2 - 1.5 in])
        l0_1 = line(start = [input.h - 3 in, input.d2 - 1.5 in], end = [input.h - 3 in, input.d2])
        l0_2 = line(start = [input.h - 3 in, input.d2], end = [1.5 in, input.d2])
        l0_3 = line(start = [1.5 in, input.d2], end = [1.5 in, input.d2 - 1.5 in])
    }
    feature d2_king_l = extrude(profile = sketch.d2_king_l_s, distance = 3.5 in, mode = new)
    sketch d2_king_r_s on plane.zx_p0_5 {
        l0_0 = line(start = [1.5 in, input.d2 + 32 in], end = [input.h - 3 in, input.d2 + 32 in])
        l0_1 = line(start = [input.h - 3 in, input.d2 + 32 in], end = [input.h - 3 in, input.d2 + 33.5 in])
        l0_2 = line(start = [input.h - 3 in, input.d2 + 33.5 in], end = [1.5 in, input.d2 + 33.5 in])
        l0_3 = line(start = [1.5 in, input.d2 + 33.5 in], end = [1.5 in, input.d2 + 32 in])
    }
    feature d2_king_r = extrude(profile = sketch.d2_king_r_s, distance = 3.5 in, mode = new)
    sketch d2_header_s on plane.zx_p0_5 {
        l0_0 = line(start = [82.5 in, input.d2], end = [84 in, input.d2])
        l0_1 = line(start = [84 in, input.d2], end = [84 in, input.d2 + 32 in])
        l0_2 = line(start = [84 in, input.d2 + 32 in], end = [82.5 in, input.d2 + 32 in])
        l0_3 = line(start = [82.5 in, input.d2 + 32 in], end = [82.5 in, input.d2])
    }
    feature d2_header = extrude(profile = sketch.d2_header_s, distance = 3.5 in, mode = new)
    sketch d3_zone_s on plane.zx_p0_5 {
        l0_0 = line(start = [1.5 in, input.d3 - 1.5 in], end = [84 in, input.d3 - 1.5 in])
        l0_1 = line(start = [84 in, input.d3 - 1.5 in], end = [84 in, input.d3 + 33.5 in])
        l0_2 = line(start = [84 in, input.d3 + 33.5 in], end = [1.5 in, input.d3 + 33.5 in])
        l0_3 = line(start = [1.5 in, input.d3 + 33.5 in], end = [1.5 in, input.d3 - 1.5 in])
    }
    feature d3_zone = extrude(profile = sketch.d3_zone_s, distance = 3.5 in, mode = cut)
    sketch d3_plate_s on plane.zx_p0_5 {
        l0_0 = line(start = [0 in, input.d3], end = [1.5 in, input.d3])
        l0_1 = line(start = [1.5 in, input.d3], end = [1.5 in, input.d3 + 32 in])
        l0_2 = line(start = [1.5 in, input.d3 + 32 in], end = [0 in, input.d3 + 32 in])
        l0_3 = line(start = [0 in, input.d3 + 32 in], end = [0 in, input.d3])
    }
    feature d3_plate = extrude(profile = sketch.d3_plate_s, distance = 3.5 in, mode = cut)
    sketch d3_king_l_s on plane.zx_p0_5 {
        l0_0 = line(start = [1.5 in, input.d3 - 1.5 in], end = [input.h - 3 in, input.d3 - 1.5 in])
        l0_1 = line(start = [input.h - 3 in, input.d3 - 1.5 in], end = [input.h - 3 in, input.d3])
        l0_2 = line(start = [input.h - 3 in, input.d3], end = [1.5 in, input.d3])
        l0_3 = line(start = [1.5 in, input.d3], end = [1.5 in, input.d3 - 1.5 in])
    }
    feature d3_king_l = extrude(profile = sketch.d3_king_l_s, distance = 3.5 in, mode = new)
    sketch d3_king_r_s on plane.zx_p0_5 {
        l0_0 = line(start = [1.5 in, input.d3 + 32 in], end = [input.h - 3 in, input.d3 + 32 in])
        l0_1 = line(start = [input.h - 3 in, input.d3 + 32 in], end = [input.h - 3 in, input.d3 + 33.5 in])
        l0_2 = line(start = [input.h - 3 in, input.d3 + 33.5 in], end = [1.5 in, input.d3 + 33.5 in])
        l0_3 = line(start = [1.5 in, input.d3 + 33.5 in], end = [1.5 in, input.d3 + 32 in])
    }
    feature d3_king_r = extrude(profile = sketch.d3_king_r_s, distance = 3.5 in, mode = new)
    sketch d3_header_s on plane.zx_p0_5 {
        l0_0 = line(start = [82.5 in, input.d3], end = [84 in, input.d3])
        l0_1 = line(start = [84 in, input.d3], end = [84 in, input.d3 + 32 in])
        l0_2 = line(start = [84 in, input.d3 + 32 in], end = [82.5 in, input.d3 + 32 in])
        l0_3 = line(start = [82.5 in, input.d3 + 32 in], end = [82.5 in, input.d3])
    }
    feature d3_header = extrude(profile = sketch.d3_header_s, distance = 3.5 in, mode = new)
    // Gypsum board both faces, from the finish floor to the ceiling board
    sketch gypsum_a_s on origin.zx {
        l0_0 = line(start = [0.5 in, 0 in], end = [input.h, 0 in])
        l0_1 = line(start = [input.h, 0 in], end = [input.h, input.len])
        l0_2 = line(start = [input.h, input.len], end = [0.5 in, input.len])
        l0_3 = line(start = [0.5 in, input.len], end = [0.5 in, 0 in])
    }
    feature gypsum_a = extrude(profile = sketch.gypsum_a_s, distance = 0.5 in, mode = new)
    sketch gypsum_b_s on plane.zx_p4 {
        l0_0 = line(start = [0.5 in, 0 in], end = [input.h, 0 in])
        l0_1 = line(start = [input.h, 0 in], end = [input.h, input.len])
        l0_2 = line(start = [input.h, input.len], end = [0.5 in, input.len])
        l0_3 = line(start = [0.5 in, input.len], end = [0.5 in, 0 in])
    }
    feature gypsum_b = extrude(profile = sketch.gypsum_b_s, distance = 0.5 in, mode = new)
    sketch d1_board_s on origin.zx {
        l0_0 = line(start = [0 in, input.d1], end = [82.5 in, input.d1])
        l0_1 = line(start = [82.5 in, input.d1], end = [82.5 in, input.d1 + 32 in])
        l0_2 = line(start = [82.5 in, input.d1 + 32 in], end = [0 in, input.d1 + 32 in])
        l0_3 = line(start = [0 in, input.d1 + 32 in], end = [0 in, input.d1])
    }
    feature d1_board = extrude(profile = sketch.d1_board_s, distance = 4.5 in, mode = cut)
    sketch d2_board_s on origin.zx {
        l0_0 = line(start = [0 in, input.d2], end = [82.5 in, input.d2])
        l0_1 = line(start = [82.5 in, input.d2], end = [82.5 in, input.d2 + 32 in])
        l0_2 = line(start = [82.5 in, input.d2 + 32 in], end = [0 in, input.d2 + 32 in])
        l0_3 = line(start = [0 in, input.d2 + 32 in], end = [0 in, input.d2])
    }
    feature d2_board = extrude(profile = sketch.d2_board_s, distance = 4.5 in, mode = cut)
    sketch d3_board_s on origin.zx {
        l0_0 = line(start = [0 in, input.d3], end = [82.5 in, input.d3])
        l0_1 = line(start = [82.5 in, input.d3], end = [82.5 in, input.d3 + 32 in])
        l0_2 = line(start = [82.5 in, input.d3 + 32 in], end = [0 in, input.d3 + 32 in])
        l0_3 = line(start = [0 in, input.d3 + 32 in], end = [0 in, input.d3])
    }
    feature d3_board = extrude(profile = sketch.d3_board_s, distance = 4.5 in, mode = cut)

    // MEP penetrations for p1_den_n: bored holes and box cut-outs where the runs pass
    feature mep_p1_den_n_p_zx_3 = plane.offset(base = origin.zx, distance = 0 in)
    feature mep_p1_den_n_p_xy_2 = plane.offset(base = origin.xy, distance = 59.75 in)
    feature mep_p1_den_n_p_xy_1 = plane.offset(base = origin.xy, distance = 67.5 in)
    feature mep_p1_den_n_p_xy_0 = plane.offset(base = origin.xy, distance = 64.5 in)
    sketch mep_p1_den_n_0_s on plane.mep_p1_den_n_p_xy_0 {
        l0 = line(start = [18 in, 0 in], end = [20 in, 0 in])
        l1 = line(start = [20 in, 0 in], end = [20 in, 2.5 in])
        l2 = line(start = [20 in, 2.5 in], end = [18 in, 2.5 in])
        l3 = line(start = [18 in, 2.5 in], end = [18 in, 0 in])
    }
    feature mep_p1_den_n_0 = extrude(profile = sketch.mep_p1_den_n_0_s, distance = 3 in, mode = cut, suppressed = true)
    sketch mep_p1_den_n_1_s on plane.mep_p1_den_n_p_xy_1 {
        c = circle(center = [19 in, 1.25 in], radius = 0.375 in)
    }
    feature mep_p1_den_n_1 = extrude(profile = sketch.mep_p1_den_n_1_s, distance = 50.35 in, mode = cut, suppressed = true)
    sketch mep_p1_den_n_2_s on plane.mep_p1_den_n_p_xy_2 {
        c = circle(center = [44 in, 1.25 in], radius = 0.375 in)
    }
    feature mep_p1_den_n_2 = extrude(profile = sketch.mep_p1_den_n_2_s, distance = 57.4 in, mode = cut, suppressed = true)
    sketch mep_p1_den_n_3_s on plane.mep_p1_den_n_p_zx_3 {
        c = circle(center = [60 in, 44 in], radius = 0.375 in)
    }
    feature mep_p1_den_n_3 = extrude(profile = sketch.mep_p1_den_n_3_s, distance = 1.5 in, mode = cut, suppressed = true)
    // end MEP penetrations p1_den_n
    // MEP penetrations for p1_utility_den: bored holes and box cut-outs where the runs pass
    feature mep_p1_utility_den_p_xy_0 = plane.offset(base = origin.xy, distance = 96 in)
    sketch mep_p1_utility_den_0_s on plane.mep_p1_utility_den_p_xy_0 {
        l0 = line(start = [103.9844 in, -87.5 in], end = [117.9844 in, -87.5 in])
        l1 = line(start = [117.9844 in, -87.5 in], end = [117.9844 in, 10.5 in])
        l2 = line(start = [117.9844 in, 10.5 in], end = [103.9844 in, 10.5 in])
        l3 = line(start = [103.9844 in, 10.5 in], end = [103.9844 in, -87.5 in])
    }
    feature mep_p1_utility_den_0 = extrude(profile = sketch.mep_p1_utility_den_0_s, distance = 8 in, mode = cut, suppressed = true)
    // end MEP penetrations p1_utility_den
    // MEP penetrations for p1_utility_w: bored holes and box cut-outs where the runs pass
    feature mep_p1_utility_w_p_xy_3 = plane.offset(base = origin.xy, distance = 32 in)
    feature mep_p1_utility_w_p_xy_2 = plane.offset(base = origin.xy, distance = 43.5 in)
    feature mep_p1_utility_w_p_xy_1 = plane.offset(base = origin.xy, distance = 28 in)
    feature mep_p1_utility_w_p_xy_0 = plane.offset(base = origin.xy, distance = 40.5 in)
    sketch mep_p1_utility_w_0_s on plane.mep_p1_utility_w_p_xy_0 {
        l0 = line(start = [102.9844 in, 0 in], end = [104.9844 in, 0 in])
        l1 = line(start = [104.9844 in, 0 in], end = [104.9844 in, 2.5 in])
        l2 = line(start = [104.9844 in, 2.5 in], end = [102.9844 in, 2.5 in])
        l3 = line(start = [102.9844 in, 2.5 in], end = [102.9844 in, 0 in])
    }
    feature mep_p1_utility_w_0 = extrude(profile = sketch.mep_p1_utility_w_0_s, distance = 3 in, mode = cut, suppressed = true)
    sketch mep_p1_utility_w_1_s on plane.mep_p1_utility_w_p_xy_1 {
        l0 = line(start = [117.9844 in, 0 in], end = [121.9844 in, 0 in])
        l1 = line(start = [121.9844 in, 0 in], end = [121.9844 in, 3 in])
        l2 = line(start = [121.9844 in, 3 in], end = [117.9844 in, 3 in])
        l3 = line(start = [117.9844 in, 3 in], end = [117.9844 in, 0 in])
    }
    feature mep_p1_utility_w_1 = extrude(profile = sketch.mep_p1_utility_w_1_s, distance = 4 in, mode = cut, suppressed = true)
    sketch mep_p1_utility_w_2_s on plane.mep_p1_utility_w_p_xy_2 {
        c = circle(center = [103.9844 in, 2.25 in], radius = 0.375 in)
    }
    feature mep_p1_utility_w_2 = extrude(profile = sketch.mep_p1_utility_w_2_s, distance = 68.35 in, mode = cut, suppressed = true)
    sketch mep_p1_utility_w_3_s on plane.mep_p1_utility_w_p_xy_3 {
        c = circle(center = [119.9844 in, 2.25 in], radius = 0.375 in)
    }
    feature mep_p1_utility_w_3 = extrude(profile = sketch.mep_p1_utility_w_3_s, distance = 80.55 in, mode = cut, suppressed = true)
    // end MEP penetrations p1_utility_w
    // MEP penetrations for p2_baths: bored holes and box cut-outs where the runs pass
    feature mep_p2_baths_p_xy_2 = plane.offset(base = origin.xy, distance = -7.6604 in)
    feature mep_p2_baths_p_xy_1 = plane.offset(base = origin.xy, distance = -3.5625 in)
    feature mep_p2_baths_p_xy_0 = plane.offset(base = origin.xy, distance = -4.7625 in)
    sketch mep_p2_baths_0_s on plane.mep_p2_baths_p_xy_0 {
        c = circle(center = [101.5 in, 2.5 in], radius = 0.5 in)
    }
