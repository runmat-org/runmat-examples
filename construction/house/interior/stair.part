        material = material.douglas_fir_lumber
        label = "Notched 2x12 stringer"
    }
    output stair_handrail = {
        body = feature.handrail.body
        part_number = "ST-1"
        material = material.oak
        label = "Oak handrail"
    }
    assign material.oak to feature.treads.body
    assign material.pine_painted_riser to feature.risers.body
}
