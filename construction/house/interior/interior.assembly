// The interior: partitions with their doors, the stair, the floor and first-floor ceiling finishes,
// and the kitchen and bath fixtures, in building coordinates (the assembly attaches at the
// skeleton's building frame). The floor plan is in DESIGN-NOTES, "Floor plan".
import { partitions } from "./partitions.part"
import { interior_door } from "./interior_door.part"
import { stair } from "./stair.part"
import { floor_finishes } from "./floor_finishes.part"
import { kitchen } from "./kitchen.part"
import { baths } from "./baths.part"

assembly interior {
    // Partitions and guards, one configuration each, placed in building coordinates
    instance p1_stair : partitions = {
        configuration = { select = named, name = p1_stair }
        placement = offset(translation = [146 in, 177.5 in, 0 in])
    }
    instance p1_utility_w : partitions = {
        configuration = { select = named, name = p1_utility_w }
