// A copper busbar strip (100 x 40 x 5 mm, 200 mm^2) carrying 400 A when a 25 kA fault flows for
// 0.5 s, cleared by its breaker. The strip starts at 20 C and is cooled by still air (10 W/m^2/K at
// 20 C). Resistivity rises with temperature (0.00393 /K), so the loss grows as the strip heats. The
// run follows the current and temperature together for 1 s and returns the temperature history
// and its peak.
// Check: in 0.5 s almost no heat leaves the strip, so it heats adiabatically:
//     dT/dt = rho_20 (1 + alpha (T - 20 C)) J^2 / (rho_m c),  J = 25 kA / 200 mm^2 = 125 A/mm^2,
// starting at 78.7 K/s. Integrated over the current signal below, the strip rises 42.4 K, to 62.4 C
// (39.2 K if resistivity stayed at its 20 C value).

import { copper } from "./materials.module"

geometry busbar {
    file = "./geometry/busbar-strip.step"
    units = mm
    region body : solid { select name "Busbar"; expect exactly_one }
    region terminal_a : face { select name "Terminal A"; expect exactly_one }
    region terminal_b : face { select name "Terminal B"; expect exactly_one }
    region exterior : face { select name "Exterior"; expect one_or_more }
}

mesh busbar on geometry.busbar {
    tetrahedra {
        order = quadratic
        target_size = 4 mm
        maximum_deviation = 0.1 mm
    }
}

model faulted_busbar {
    thermal { reference_temperature = 20 degC }
    electromagnetic { equation = steady_conduction }
    assign material.copper to geometry.busbar.region.body
    initial room_temperature {
        thermal.temperature {
            target = geometry.busbar.region.body
            uniform = 293.15 K
        }
    }
    constraint return_terminal {
        electrical.potential { target = geometry.busbar.region.terminal_b; value = 0 V }
    }
    // 400 A load current, a 25 kA fault from 0.1 s to 0.6 s with 5 ms edges, then 400 A again.
    signal fault_current : electric_current over time {
        samples = [
            { at = 0 s, value = 400 A },
            { at = 0.1 s, value = 400 A },
            { at = 0.105 s, value = 25000 A },
            { at = 0.6 s, value = 25000 A },
            { at = 0.605 s, value = 400 A },
            { at = 1 s, value = 400 A },
        ]
        interpolation = linear
        extrapolation = reject
    }
    excitation fault {
        electric_current {
            target = geometry.busbar.region.terminal_a
            signal = signal.fault_current
        }
    }
    load still_air {
        thermal.convection {
            target = geometry.busbar.region.exterior
            ambient_temperature = 293.15 K
            coefficient = 10 W/m^2/K
        }
    }
    load_case fault_case { include excitation.fault }
}

study fault_heating {
    geometry = geometry.busbar
    mesh = mesh.busbar
    model = model.faulted_busbar
    analysis pulse {
        electrothermal transient { start_time = 0 s; end_time = 1 s; time_step = 5 ms }
        initial_conditions = [model.initial.room_temperature]
    }
    output temperature = analysis.pulse.field.node.temperature
    output peak_temperature = max(analysis.pulse.field.node.temperature, over = geometry.busbar.region.body)
    output mean_temperature = mean(analysis.pulse.field.node.temperature, over = geometry.busbar.region.body)
}
