// Thermal buckling of a steel rail, 2000 mm long with a 20 x 10 mm section, fixed at both ends at
// 20 C and then warmed 10 K by the sun. The ends stop it growing, so it carries an axial stress of
// E alpha dT = 25.2 MPa. A steady thermal step sets the temperature, a preload step turns it into
// thermal stress and geometric stiffness, and a buckling step returns the load factor on the 10 K
// rise at which the rail buckles, and the buckled shape.
// Check: a rod fixed at both ends buckles when its thermal force E A alpha dT reaches
// 4 pi^2 E I / L^2, so dT_cr = 4 pi^2 I / (alpha A L^2). About the weak axis (I = 20 * 10^3 / 12
// mm^4) dT_cr = 6.85 K: the run's load factor should read 0.685.

import { steel_s275 } from "./materials.module"

geometry rail {
    file = "./geometry/rail.step"
    units = mm
    region body : solid { select name "Rail"; expect exactly_one }
    region end_a : face { select name "End A"; expect exactly_one }
    region end_b : face { select name "End B"; expect exactly_one }
}

mesh rail on geometry.rail {
    tetrahedra {
        order = quadratic
        target_size = 5 mm
        maximum_deviation = 0.1 mm
    }
}

model fixed_rail {
    thermal { reference_temperature = 293.15 K }
    thermomechanical { reference_temperature = 293.15 K }
    assign material.steel_s275 to geometry.rail.region.body
    constraint fixed_a {
        structural.fixed { target = geometry.rail.region.end_a }
    }
    constraint fixed_b {
        structural.fixed { target = geometry.rail.region.end_b }
    }
    // Both ends at 30 C and no other heat path: the whole rail reaches 30 C.
    constraint warm_a {
        thermal.temperature { target = geometry.rail.region.end_a; value = 303.15 K }
    }
    constraint warm_b {
        thermal.temperature { target = geometry.rail.region.end_b; value = 303.15 K }
    }
}

study rail_buckling {
    geometry = geometry.rail
    mesh = mesh.rail
    model = model.fixed_rail
    analysis heat { thermal steady {} retain warmed }
    analysis preload after analysis.heat {
        thermomechanical preload { temperature = analysis.heat.state.warmed }
    }
    analysis buckling after analysis.preload {
        structural buckling {
            prestress = analysis.preload.state.geometric_stiffness
            modes = 1
        }
    }
    output temperature = analysis.heat.field.node.temperature
    output buckled_shape = analysis.buckling.field.node.displacement
}
