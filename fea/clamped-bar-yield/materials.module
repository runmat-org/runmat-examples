// Structural steel S275: E, nu, density and expansion from EN 1993-1-1, 3.2.6; yield strength for
// thicknesses up to 16 mm from EN 10025-2; the E/10000 hardening slope is the nominal plateau that
// EN 1993-1-5, Annex C.6 allows in finite-element models.
material steel_s275 = {
    mass_density = 7850 kg/m^3
    elastic = {
        youngs_modulus = 210 GPa
        poisson_ratio = 0.3
    }
    plastic = {
        law = j2_isotropic_linear_hardening
        yield_stress = 275 MPa
        isotropic_hardening_modulus = 21 MPa
    }
    thermal = {
        reference_temperature = 293.15 K
        modulus_temperature_coefficient = 0 K^-1
        conductivity = 45 W/m/K
        specific_heat = 600 J/kg/K
        expansion_coefficient = 0.000012 K^-1
    }
}
