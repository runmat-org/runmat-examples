// A copper fuse element (10 mm long, 1 x 0.25 mm section) carrying a 120 A overload. Its ends are
// soldered to the fuse terminals, which stay at 20 C; the element is packed in still filler, so its
// surface is taken as insulated. Resistivity rises with temperature (0.00393 /K): the hotter middle
// heats faster, which concentrates the temperature rise there. The run solves the current and the
// temperature together and returns both fields and the peak temperature.
// Check: with resistivity linear in temperature, the steady profile has a closed form,
//     theta(x) = (cos(m (x - L/2)) / cos(m L/2) - 1) / alpha,  m^2 = alpha J^2 rho_20 / k,
// with J = 480 A/mm^2: m = 200.6 1/m, m L/2 = 1.003, so the middle reaches 218.7 K above the ends,
// 238.7 C. At constant resistivity the rise would be rho J^2 L^2 / (8 k) = 128.0 K.
geometry fuse {
    file = "./geometry/fuse-element.step"
    units = mm
    region body : solid { select name "Fuse element"; expect exactly_one }
    region terminal_a : face { select name "Terminal A"; expect exactly_one }
    region terminal_b : face { select name "Terminal B"; expect exactly_one }
}

mesh fuse on geometry.fuse {
    tetrahedra {
        order = quadratic
        target_size = 0.125 mm
        maximum_deviation = 0.02 mm
    }
}

// Copper: electrical values from IEC 60028 (international standard of resistance for copper:
// 1/58 ohm mm^2/m at 20 C, temperature coefficient 0.00393 /K); thermal values for C11000 from the
// ASM Handbook, Vol. 2, properties of wrought coppers.
material copper {
    mass_density = 8890 kg/m^3
    electrical {
        reference_temperature = 20 degC
        conductivity = 58000000 A/V/m
        resistive_heating_coefficient = 0.00393 K^-1
        relative_permittivity = 1
        relative_permeability = 1
    }
    thermal {
        reference_temperature = 20 degC
        modulus_temperature_coefficient = 0 K^-1
        conductivity = 388 W/m/K
        specific_heat = 385 J/kg/K
        expansion_coefficient = 0.000017 K^-1
    }
}

model overloaded_fuse {
    thermal { reference_temperature = 20 degC }
    electromagnetic { equation = steady_conduction }
    assign material.copper to geometry.fuse.region.body
    constraint return_terminal {
        electrical.potential { target = geometry.fuse.region.terminal_b; value = 0 V }
    }
    load overload {
        electric_current on geometry.fuse.region.terminal_a = 120 A
    }
    constraint terminal_a_temperature {
        thermal.temperature { target = geometry.fuse.region.terminal_a; value = 293.15 K }
    }
    constraint terminal_b_temperature {
        thermal.temperature { target = geometry.fuse.region.terminal_b; value = 293.15 K }
    }
}

study fuse_overload {
    geometry = geometry.fuse
    mesh = mesh.fuse
    model = model.overloaded_fuse
    analysis operating_point { electrothermal steady {} }
    output temperature = analysis.operating_point.field.node.temperature
    output peak_temperature = max(analysis.operating_point.field.node.temperature, over = geometry.fuse.region.body)
    output current_density = analysis.operating_point.field.element.electric_current_density
}
