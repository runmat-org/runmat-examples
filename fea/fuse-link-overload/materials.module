// Copper: electrical values from IEC 60028 (international standard of resistance for copper:
// 1/58 ohm mm^2/m at 20 C, temperature coefficient 0.00393 /K); thermal values for C11000 from the
// ASM Handbook, Vol. 2, properties of wrought coppers.
material copper = {
    mass_density = 8890 kg/m^3
    electrical = {
        reference_temperature = 20 degC
        conductivity = 58000000 A/V/m
        resistive_heating_coefficient = 0.00393 K^-1
        relative_permittivity = 1
        relative_permeability = 1
    }
    thermal = {
        reference_temperature = 20 degC
        modulus_temperature_coefficient = 0 K^-1
        conductivity = 388 W/m/K
        specific_heat = 385 J/kg/K
        expansion_coefficient = 0.000017 K^-1
    }
}
