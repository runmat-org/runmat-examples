// Steady heat flow through an aluminum pin fin, 6 mm in diameter and 50 mm long. Its base is held at
// 80 C; its side and tip lose heat to 25 C air at h = 25 W/m^2/K. The run returns the temperature
// along the fin, the heat flowing in through the base and the tip temperature.
// Check: with m = sqrt(h P / (k A)) = 9.990 1/m and a convecting tip, the fin carries
//     q = sqrt(h P k A) theta_b (sinh mL + (h/mk) cosh mL) / (cosh mL + (h/mk) sinh mL) = 1.228 W
// and its tip sits at theta_b / (cosh mL + (h/mk) sinh mL) = 48.45 K above the air, 73.5 C.

import { aluminum_6061_t6 } from "./materials.module"

geometry fin {
    file = "./geometry/pin-fin.step"
    units = mm
    region body : solid { select name "Pin fin"; expect exactly_one }
    region base : face { select name "Base"; expect exactly_one }
    region side : face { select name "Fin side"; expect exactly_one }
    region tip : face { select name "Fin tip"; expect exactly_one }
}

mesh fin on geometry.fin {
    tetrahedra {
        order = quadratic
        target_size = 1.5 mm
        maximum_deviation = 0.1 mm
    }
}

model cooled_fin {
    thermal { reference_temperature = 25 degC }
    assign material.aluminum_6061_t6 to geometry.fin.region.body
    constraint hot_base {
        thermal.temperature { target = geometry.fin.region.base; value = 353.15 K }
    }
    load side_air {
        thermal.convection {
            target = geometry.fin.region.side
            ambient_temperature = 25 degC
            coefficient = 25 W/m^2/K
        }
    }
    load tip_air {
        thermal.convection {
            target = geometry.fin.region.tip
            ambient_temperature = 25 degC
            coefficient = 25 W/m^2/K
        }
    }
}

study fin_heat_rate {
    geometry = geometry.fin
    mesh = mesh.fin
    model = model.cooled_fin
    analysis heat { thermal steady {} }
    output temperature = analysis.heat.field.node.temperature
    output base_heat_flow = flux(analysis.heat.field.element.heat_flux, through = geometry.fin.region.base)
    output tip_temperature = mean(analysis.heat.field.node.temperature, over = geometry.fin.region.tip)
}
