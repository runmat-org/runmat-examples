// Warm-up of an aluminum heat spreader (100 x 100 x 10 mm) after a 20 W component switches on.
// The component sits on a 20 x 20 mm pad on the underside (50 kW/m^2). Every other face loses heat to
// 25 C air at h = 10 W/m^2/K (0.0236 m^2). The plate starts at 25 C and the run follows it for 6000 s,
// about six time constants. It returns the temperature history, the peak temperature and the mean
// temperature of the plate.
// Check: the Biot number is 3e-4, so the plate warms as one lump. Its time constant is
// rho c V / (h A) = 2700 * 896 * 1e-4 / (10 * 0.0236) = 1025 s, and its mean rises toward
// P / (h A) = 20 / 0.236 = 84.7 K, a mean of 109.7 C.
geometry spreader {
    file = "./geometry/heat-spreader.step"
    units = mm
    region body : solid { select name "Spreader"; expect exactly_one }
    region heater_pad : face { select name "Heater pad"; expect exactly_one }
    region cooled_surfaces : face { select name "Cooled surfaces"; expect one_or_more }
}

mesh spreader on geometry.spreader {
    tetrahedra {
        order = quadratic
        target_size = 5 mm
        maximum_deviation = 0.1 mm
    }
}

// Aluminum 6061-T6 (ASM Handbook, Vol. 2, properties of wrought aluminum alloys).
material aluminum_6061_t6 {
    mass_density = 2700 kg/m^3
    thermal {
        reference_temperature = 298.15 K
        modulus_temperature_coefficient = 0 K^-1
        conductivity = 167 W/m/K
        specific_heat = 896 J/kg/K
        expansion_coefficient = 0.0000236 K^-1
    }
}

model warming_spreader {
    thermal { reference_temperature = 25 degC }
    assign material.aluminum_6061_t6 to geometry.spreader.region.body
    initial room_temperature {
        thermal.temperature {
            target = geometry.spreader.region.body
            uniform = 298.15 K
        }
    }
    // 20 W over the 400 mm^2 pad, on from t = 0.
    load component {
        thermal.heat_flux {
            target = geometry.spreader.region.heater_pad
            value = 50000 W/m^2
        }
    }
    load still_air {
        thermal.convection {
            target = geometry.spreader.region.cooled_surfaces
            ambient_temperature = 25 degC
            coefficient = 10 W/m^2/K
        }
    }
}

study spreader_warm_up {
    geometry = geometry.spreader
    mesh = mesh.spreader
    model = model.warming_spreader
    analysis warm_up {
        thermal transient {
            start_time = 0 s
            end_time = 6000 s
            time_step = 30 s
        }
        initial_conditions = [model.initial.room_temperature]
    }
    output temperature = analysis.warm_up.field.node.temperature
    output peak_temperature = max(analysis.warm_up.field.node.temperature, over = geometry.spreader.region.body)
    output mean_temperature = mean(analysis.warm_up.field.node.temperature, over = geometry.spreader.region.body)
}
