// A pressure pulse traveling along a compliant silicone tube full of water. The tube has a 10 mm
// bore, a 1 mm wall and is 200 mm long, held at both ends. A 4 ms half-sine surge of inflow,
// peaking at 0.05 m/s, enters at one end; the far end opens to a reservoir at zero gauge pressure.
// Fluid and wall are solved together. The run returns the pressure on the axis 50 mm and 150 mm
// from the inlet every 0.5 ms through 15 ms, the wall's largest displacement, and the final
// displacement, velocity and pressure fields.
//
// Geometry: ./geometry/compliant-tube.step: the water ("Water") with its inlet, outlet and wall,
// and the tube ("Tube") with its bore, outside and two end faces.
//
// Water at 300 K (Incropera, Table A.6): 997 kg/m^3, 855e-6 Pa s.
// Silicone rubber, 50 Shore A: E = 2.46 MPa from Gent's relation between Shore A hardness and
// Young's modulus, 1150 kg/m^3, Poisson's ratio 0.49 (nearly incompressible).
//
// Hand check, Moens-Korteweg wave speed c = sqrt(E h / (rho d)):
//   sqrt(2.46e6 x 0.001 / (997 x 0.010)) = 15.7 m/s.
// With the mean wall diameter (11 mm) it is 15.0 m/s; the wall's axial restraint raises it by
// 1 / sqrt(1 - nu^2) to about 17 m/s. Take 15 to 17 m/s. The pulse peak leaves the inlet at 2 ms,
// so it passes 50 mm at 4.9 to 5.3 ms and 150 mm at 10.8 to 12.0 ms: 100 mm in 5.9 to 6.7 ms.
// Its pressure is about rho c u = 997 x 15.7 x 0.05 = 0.78 kPa, which swells the bore by
// dp d / (2 E h) = 1.6 % (80 um on the radius). The open end reflects the pulse inverted; its
// peak gets back to 150 mm after 16.7 ms, outside the 15 ms window.

import { water, silicone_50a } from "./materials.module"

geometry tube {
    file = "./geometry/compliant-tube.step"
    units = mm
    interfaces = shared
    region water : cell { select name "Water"; expect exactly_one }
    region tube : solid { select name "Tube"; expect exactly_one }
    region inlet : face { select name "Inlet"; expect exactly_one }
    region outlet : face { select name "Outlet"; expect exactly_one }
    region water_wall : face { select name "Water wall"; expect exactly_one }
    region tube_bore : face { select name "Tube bore"; expect exactly_one }
    region tube_ends : face { select name "Tube ends"; expect one_or_more }
}

// Two elements through the 1 mm wall; the 60 mm pulse spans about 40 cells.
mesh tube on geometry.tube {
    tetrahedra {
        order = linear
        target_size = 1.5 mm
        maximum_deviation = 0.05 mm
        refine wall { on = geometry.tube.region.tube; target_size = 0.5 mm }
    }
}

model pulsed_tube {
    assign material.water to geometry.tube.region.water
    assign material.silicone_50a to geometry.tube.region.tube
    // Half-sine surge, 4 ms long, peak 0.05 m/s.
    signal surge : velocity over time {
        samples = [
            { at = 0 ms, value = 0.00000 m/s },
            { at = 0.25 ms, value = 0.00975 m/s },
            { at = 0.5 ms, value = 0.01913 m/s },
            { at = 0.75 ms, value = 0.02778 m/s },
            { at = 1 ms, value = 0.03536 m/s },
            { at = 1.25 ms, value = 0.04157 m/s },
            { at = 1.5 ms, value = 0.04619 m/s },
            { at = 1.75 ms, value = 0.04904 m/s },
            { at = 2 ms, value = 0.05000 m/s },
            { at = 2.25 ms, value = 0.04904 m/s },
            { at = 2.5 ms, value = 0.04619 m/s },
            { at = 2.75 ms, value = 0.04157 m/s },
            { at = 3 ms, value = 0.03536 m/s },
            { at = 3.25 ms, value = 0.02778 m/s },
            { at = 3.5 ms, value = 0.01913 m/s },
            { at = 3.75 ms, value = 0.00975 m/s },
            { at = 4 ms, value = 0.00000 m/s },
        ]
        interpolation = linear
        extrapolation = zero
    }
    excitation inflow {
        inlet_velocity {
            target = geometry.tube.region.inlet
            signal = signal.surge
            direction = global([1, 0, 0])
        }
    }
    load reservoir { fluid.outlet_pressure { target = geometry.tube.region.outlet; value = 0 Pa } }
    constraint held_ends { structural.fixed { target = geometry.tube.region.tube_ends } }
    interface wetted_wall {
        fluid_structure.no_slip {
            primary = geometry.tube.region.water_wall
            secondary = geometry.tube.region.tube_bore
        }
    }
    load_case pulse { include excitation.inflow }
}

study tube_pulse {
    geometry = geometry.tube
    mesh = mesh.tube
    model = model.pulsed_tube
    analysis response {
        fluid_structure_interaction transient {
            start_time = 0 s
            end_time = 15 ms
            time_step = 0.2 ms
        }
    }
    output displacement = analysis.response.field.node.displacement
    output velocity = analysis.response.field.cell.fluid_velocity
    output pressure = analysis.response.field.cell.fluid_pressure
    output pressure_50 = interpolate(output.pressure, at = [50 mm, 0 mm, 0 mm])
    output pressure_150 = interpolate(output.pressure, at = [150 mm, 0 mm, 0 mm])
    output wall_movement = max(magnitude(output.displacement), over = geometry.tube.region.tube)
    output pressure_50_history {
        value = sample(output.pressure_50, over = time, at = [0.5 ms, 1 ms, 1.5 ms, 2 ms, 2.5 ms, 3 ms, 3.5 ms, 4 ms, 4.5 ms, 5 ms, 5.5 ms, 6 ms, 6.5 ms, 7 ms, 7.5 ms, 8 ms, 8.5 ms, 9 ms, 9.5 ms, 10 ms, 10.5 ms, 11 ms, 11.5 ms, 12 ms, 12.5 ms, 13 ms, 13.5 ms, 14 ms, 14.5 ms, 15 ms])
        retention = explicit_samples
        maximum_samples = 30
    }
    output pressure_150_history {
        value = sample(output.pressure_150, over = time, at = [0.5 ms, 1 ms, 1.5 ms, 2 ms, 2.5 ms, 3 ms, 3.5 ms, 4 ms, 4.5 ms, 5 ms, 5.5 ms, 6 ms, 6.5 ms, 7 ms, 7.5 ms, 8 ms, 8.5 ms, 9 ms, 9.5 ms, 10 ms, 10.5 ms, 11 ms, 11.5 ms, 12 ms, 12.5 ms, 13 ms, 13.5 ms, 14 ms, 14.5 ms, 15 ms])
        retention = explicit_samples
        maximum_samples = 30
    }
    output wall_movement_history {
        value = sample(output.wall_movement, over = time, at = [0.5 ms, 1 ms, 1.5 ms, 2 ms, 2.5 ms, 3 ms, 3.5 ms, 4 ms, 4.5 ms, 5 ms, 5.5 ms, 6 ms, 6.5 ms, 7 ms, 7.5 ms, 8 ms, 8.5 ms, 9 ms, 9.5 ms, 10 ms, 10.5 ms, 11 ms, 11.5 ms, 12 ms, 12.5 ms, 13 ms, 13.5 ms, 14 ms, 14.5 ms, 15 ms])
        retention = explicit_samples
        maximum_samples = 30
    }
}
