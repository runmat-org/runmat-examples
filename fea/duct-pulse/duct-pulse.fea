// A sound pulse traveling down a 1 m air duct with a 100 x 100 mm square section. A Gaussian
// pressure pulse (1 Pa peak at 1 ms, 0.25 ms standard deviation) drives one end; the far end is
// anechoic, so the pulse leaves without reflecting. The pulse comes from the MATLAB function
// gaussianPulse.m. The run returns the pressure history at the driven end and at the far end
// every 0.1 ms through 6 ms, and the final pressure field.
//
// Geometry: ./geometry/duct-1000x100.step, the duct air ("Air") with its driven end, open end and
// four rigid walls.
//
// Air at 20 degC: 1.204 kg/m^3, 343 m/s. The drive is uniform over the end face, so it launches a
// plane wave; the duct's first cross mode, c / (2 x 0.1 m) = 1715 Hz, is not driven.
//
// Hand check: the pulse crosses the duct in L / c = 1.000 / 343 = 2.92 ms, so its peak reaches
// the far end at 1 + 2.92 = 3.92 ms with the same 1 Pa amplitude and 0.25 ms width.

import function gaussianPulse from "./gaussianPulse.m"

geometry duct {
    file = "./geometry/duct-1000x100.step"
    units = mm
    region air : solid { select name "Air"; expect exactly_one }
    region driven_end : face { select name "Driven end"; expect exactly_one }
    region open_end : face { select name "Open end"; expect exactly_one }
    region walls : face { select name "Walls"; expect one_or_more }
}

// Six quadratic elements per wavelength at 2 kHz: 343 / 2000 / 6 = 28.6 mm.
mesh duct on geometry.duct {
    tetrahedra {
        order = quadratic
        target_size = 25 mm
        maximum_deviation = 0.5 mm
    }
}

material air {
    mass_density = 1.204 kg/m^3
    acoustic {
        speed_of_sound = 343 m/s
        damping_ratio = 0.0
    }
}

model pulsed_duct {
    assign material.air to geometry.duct.region.air
    signal pulse : pressure over time {
        generated by function.gaussianPulse {
            arguments {
                peak = 1 Pa
                center = 1 ms
                width = 0.25 ms
            }
            sample from 0 s to 6 ms at 100 kHz
            interpolation = linear
            extrapolation = reject
            tolerance = 1e-6 Pa
        }
    }
    excitation source {
        acoustic_pressure {
            target = geometry.duct.region.driven_end
            signal = signal.pulse
        }
    }
    load walls { acoustic.rigid_wall { target = geometry.duct.region.walls } }
    load anechoic_end { acoustic.radiation { target = geometry.duct.region.open_end } }
    load_case pulse { include excitation.source }
}

study duct_pulse {
    geometry = geometry.duct
    mesh = mesh.duct
    model = model.pulsed_duct
    // 0.02 ms steps: about twelve per pulse standard deviation.
    analysis sound {
        acoustic transient {
            start_time = 0 s
            end_time = 6 ms
            time_step = 0.02 ms
        }
    }
    output pressure = analysis.sound.field.node.acoustic_pressure
    output driven_end_history {
        value = sample(
            interpolate(output.pressure, at = [0 mm, 0 mm, 0 mm]),
            over = time,
            at = [
            0.1 ms, 0.2 ms, 0.3 ms, 0.4 ms, 0.5 ms, 0.6 ms, 0.7 ms, 0.8 ms, 0.9 ms, 1 ms,
            1.1 ms, 1.2 ms, 1.3 ms, 1.4 ms, 1.5 ms, 1.6 ms, 1.7 ms, 1.8 ms, 1.9 ms, 2 ms,
            2.1 ms, 2.2 ms, 2.3 ms, 2.4 ms, 2.5 ms, 2.6 ms, 2.7 ms, 2.8 ms, 2.9 ms, 3 ms,
            3.1 ms, 3.2 ms, 3.3 ms, 3.4 ms, 3.5 ms, 3.6 ms, 3.7 ms, 3.8 ms, 3.9 ms, 4 ms,
            4.1 ms, 4.2 ms, 4.3 ms, 4.4 ms, 4.5 ms, 4.6 ms, 4.7 ms, 4.8 ms, 4.9 ms, 5 ms,
            5.1 ms, 5.2 ms, 5.3 ms, 5.4 ms, 5.5 ms, 5.6 ms, 5.7 ms, 5.8 ms, 5.9 ms, 6 ms
            ],
        )
        retention = explicit_samples
        maximum_samples = 60
    }
    output far_end_history {
        value = sample(
            interpolate(output.pressure, at = [1000 mm, 0 mm, 0 mm]),
            over = time,
            at = [
            0.1 ms, 0.2 ms, 0.3 ms, 0.4 ms, 0.5 ms, 0.6 ms, 0.7 ms, 0.8 ms, 0.9 ms, 1 ms,
            1.1 ms, 1.2 ms, 1.3 ms, 1.4 ms, 1.5 ms, 1.6 ms, 1.7 ms, 1.8 ms, 1.9 ms, 2 ms,
            2.1 ms, 2.2 ms, 2.3 ms, 2.4 ms, 2.5 ms, 2.6 ms, 2.7 ms, 2.8 ms, 2.9 ms, 3 ms,
            3.1 ms, 3.2 ms, 3.3 ms, 3.4 ms, 3.5 ms, 3.6 ms, 3.7 ms, 3.8 ms, 3.9 ms, 4 ms,
            4.1 ms, 4.2 ms, 4.3 ms, 4.4 ms, 4.5 ms, 4.6 ms, 4.7 ms, 4.8 ms, 4.9 ms, 5 ms,
            5.1 ms, 5.2 ms, 5.3 ms, 5.4 ms, 5.5 ms, 5.6 ms, 5.7 ms, 5.8 ms, 5.9 ms, 6 ms
            ],
        )
        retention = explicit_samples
        maximum_samples = 60
    }
}
