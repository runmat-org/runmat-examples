// Warm-up of a liquid-cooled chip cold plate after a 50 W power step. A 6061-T6 aluminum block,
// 80 x 40 x 12 mm, carries one straight 6 mm drilled channel with water at 0.25 m/s entering at
// 25 degC. At t = 0 a 20 x 20 mm die on the top face switches on at 50 W. The run returns the
// die footprint's peak temperature through the first 150 s, the final temperature, velocity and
// pressure fields, and the mean water temperature on the outlet.
//
// Geometry: ./geometry/chip-cold-plate.step: the block ("Cold plate") with its die footprint
// ("Die footprint") and channel wall ("Plate channel wall"), and the water in the channel
// ("Coolant") with its inlet, outlet and wall. Faces outside the die and channel are insulated.
//
// Water at 300 K (Incropera, Table A.6): 997 kg/m^3, 855e-6 Pa s, 0.613 W/m/K, 4179 J/kg/K,
// Pr = 5.83. 6061-T6 (ASM): 2700 kg/m^3, 167 W/m/K, 896 J/kg/K.
// Flow: 0.25 m/s in the 6 mm bore is 7.05e-3 kg/s (0.42 L/min); Re = 1749, laminar.
//
// Hand checks:
// - Outlet rise at steady state: Q / (m_dot c) = 50 / (7.05e-3 x 4179) = 1.70 K, so the water
//   leaves at 26.7 degC (mixed mean).
// - Film: with a developed velocity profile and a developing temperature profile, Shah's mean
//   Nusselt number for uniform flux is 1.953 Gz^(1/3) with Gz = Re Pr d / L = 765, so Nu = 17.9
//   and h = 17.9 x 0.613 / 0.006 = 1825 W/m^2/K over 1.51e-3 m^2 of channel: 18 K. Fully
//   developed flow (Nu = 4.36) would give 74 K, an upper bound the 80 mm channel never reaches.
// - Conduction through the 4 mm of aluminum under the die adds at most 0.004 / (167 x 4e-4) x 50
//   = 3 K. The die settles near 25 + 0.9 + 18 + 2 = 46 degC.
// - Time constant: the block stores rho c V = 2700 x 896 x 3.61e-5 = 87 J/K behind about
//   0.4 K/W, so tau = 35 s: about 63 % of the final rise by 35 s and 95 % by 105 s.

import { aluminum_6061_t6, water } from "./materials.module"

geometry plate {
    file = "./geometry/chip-cold-plate.step"
    units = mm
    interfaces = shared
    region block : solid { select name "Cold plate"; expect exactly_one }
    region coolant : cell { select name "Coolant"; expect exactly_one }
    region inlet : face { select name "Inlet"; expect exactly_one }
    region outlet : face { select name "Outlet"; expect exactly_one }
    region channel_wall : face { select name "Channel wall"; expect exactly_one }
    region plate_wall : face { select name "Plate channel wall"; expect exactly_one }
    region die : face { select name "Die footprint"; expect exactly_one }
}

mesh plate on geometry.plate {
    tetrahedra {
        order = linear
        target_size = 2.5 mm
        maximum_deviation = 0.05 mm
        refine channel { on = geometry.plate.region.channel_wall; target_size = 0.75 mm }
    }
}

model power_step {
    thermal { reference_temperature = 298.15 K }
    assign material.aluminum_6061_t6 to geometry.plate.region.block
    assign material.water to geometry.plate.region.coolant
    // 50 W over the 400 mm^2 die footprint, on from t = 0.
    load die_power { heat_flux on geometry.plate.region.die = 125000 W/m^2 }
    constraint inlet_flow {
        fluid.velocity { target = geometry.plate.region.inlet; value = [0.25 m/s, 0 m/s, 0 m/s] }
    }
    constraint inlet_temperature {
        thermal.temperature { target = geometry.plate.region.inlet; value = 298.15 K }
    }
    constraint walls { fluid.no_slip_wall { target = geometry.plate.region.channel_wall } }
    load outlet { fluid.outlet_pressure { target = geometry.plate.region.outlet; value = 0 Pa } }
    initial start {
        thermal.temperature { target = whole_model; uniform = 298.15 K }
    }
    interface wetted_wall {
        conjugate_heat_transfer.perfect {
            primary = geometry.plate.region.plate_wall
            secondary = geometry.plate.region.channel_wall
        }
    }
}

study die_warm_up {
    geometry = geometry.plate
    mesh = mesh.plate
    model = model.power_step
    // The block and water start at 25 degC.
    analysis warm_up {
        conjugate_heat_transfer transient {
            start_time = 0 s
            end_time = 150 s
            time_step = 1 s
        }
        initial_conditions = [model.initial.start]
    }
    output temperature = analysis.warm_up.field.node.temperature
    output velocity = analysis.warm_up.field.cell.fluid_velocity
    output pressure = analysis.warm_up.field.cell.fluid_pressure
    output peak_die_temperature = max(output.temperature, over = geometry.plate.region.die)
    output outlet_temperature = mean(output.temperature, over = geometry.plate.region.outlet)
    output die_temperature_history {
        value = sample(
            output.peak_die_temperature,
            over = time,
            at = [5 s, 10 s, 20 s, 35 s, 50 s, 75 s, 105 s, 150 s],
        )
        retention = explicit_samples
        maximum_samples = 8
    }
}
