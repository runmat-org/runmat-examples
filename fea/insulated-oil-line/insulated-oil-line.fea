// Heat loss from an insulated hot-oil line: engine oil at 127 degC (400 K) flows at 0.1 m/s
// through a 1 in schedule 40 carbon-steel pipe lagged with 25 mm of glass-fiber blanket. The
// jacket's outer surface loses heat to 25 degC still air by natural convection and radiation. The
// run returns the jacket's mean and peak surface temperature, the pipe's peak temperature and the
// mean oil outlet temperature, with the temperature, velocity and pressure fields; the energy
// closure in the result evidence gives the heat lost through the jacket.
//
// Geometry: ./geometry/insulated-oil-line.step, a 150 mm length of line: the oil ("Oil", 26.64 mm
// bore), the pipe ("Pipe", 33.40 mm outside) and the jacket ("Jacket", 83.40 mm outside). The cut
// ends of pipe and jacket are insulated, as they are along a long run.
//
// Properties (Incropera, Fundamentals of Heat and Mass Transfer, Tables A.1, A.3, A.5, A.11):
// - Engine oil at 400 K: 825.1 kg/m^3, 0.00874 Pa s, 0.134 W/m/K, 2337 J/kg/K (Pr = 152).
//   Re = 0.1 x 0.02664 / 10.6e-6 = 251, laminar.
// - AISI 1010 steel: 7832 kg/m^3, 63.9 W/m/K, 434 J/kg/K.
// - Glass-fiber blanket (16 kg/m^3): 0.046 W/m/K, 835 J/kg/K.
// - Painted jacket surface (white acrylic paint): emissivity 0.90.
// - Still air at 25 degC around a horizontal 83.4 mm cylinder about 11 K warmer than the air:
//   Churchill-Chu gives Ra = 5.8e5, Nu = 12.5, h = 3.9 W/m^2/K.
//
// Hand check, radial resistance network per meter of line:
// - Oil film, thermally developing over 150 mm (Gz = 6800, Nu = 1.953 Gz^(1/3) = 37,
//   h = 186 W/m^2/K): 1 / (h pi d) = 0.064 m K/W.
// - Pipe wall: ln(16.70 / 13.32) / (2 pi 63.9) = 0.0006 m K/W.
// - Jacket: ln(41.70 / 16.70) / (2 pi 0.046) = 3.166 m K/W.
// - Outer surface: convection 3.9 plus radiation 0.9 sigma (Ts^2 + Ta^2)(Ts + Ta) = 5.7 W/m^2/K,
//   9.6 W/m^2/K over pi x 0.0834 m: 0.396 m K/W.
// Total 3.63 m K/W, so the line loses (126.85 - 25) / 3.63 = 28 W/m (4.2 W over this 150 mm), the
// jacket surface sits at 25 + 28 x 0.396 = 36 degC and the pipe within 2 K of the oil. The oil
// cools by only 4.2 / (825.1 x 0.1 x 5.574e-4 x 2337) = 0.04 K.

import { engine_oil_400k, aisi_1010, glass_fiber_blanket } from "./materials.module"

geometry line {
    file = "./geometry/insulated-oil-line.step"
    units = mm
    interfaces = shared
    region oil : cell { select name "Oil"; expect exactly_one }
    region pipe : solid { select name "Pipe"; expect exactly_one }
    region jacket : solid { select name "Jacket"; expect exactly_one }
    region inlet : face { select name "Inlet"; expect exactly_one }
    region outlet : face { select name "Outlet"; expect exactly_one }
    region oil_wall : face { select name "Oil wall"; expect exactly_one }
    region pipe_bore : face { select name "Pipe bore"; expect exactly_one }
    region jacket_surface : face { select name "Jacket surface"; expect exactly_one }
}

mesh line on geometry.line {
    tetrahedra {
        order = linear
        target_size = 5 mm
        maximum_deviation = 0.1 mm
        refine oil_wall { on = geometry.line.region.oil_wall; target_size = 1.5 mm }
        refine pipe { on = geometry.line.region.pipe; target_size = 1.7 mm }
    }
}

model lagged_line {
    thermal { reference_temperature = 298.15 K }
    assign material.engine_oil_400k to geometry.line.region.oil
    assign material.aisi_1010 to geometry.line.region.pipe
    assign material.glass_fiber_blanket to geometry.line.region.jacket
    constraint inlet_flow {
        fluid.velocity { target = geometry.line.region.inlet; value = [0.1 m/s, 0 m/s, 0 m/s] }
    }
    constraint inlet_temperature {
        thermal.temperature { target = geometry.line.region.inlet; value = 400 K }
    }
    constraint walls { fluid.no_slip_wall { target = geometry.line.region.oil_wall } }
    load outlet { fluid.outlet_pressure { target = geometry.line.region.outlet; value = 0 Pa } }
    interface wetted_bore {
        conjugate_heat_transfer.perfect {
            primary = geometry.line.region.pipe_bore
            secondary = geometry.line.region.oil_wall
        }
    }
    load still_air {
        thermal.convection {
            target = geometry.line.region.jacket_surface
            ambient_temperature = 298.15 K
            coefficient = 3.9 W/m^2/K
        }
    }
    load surroundings {
        thermal.radiation {
            target = geometry.line.region.jacket_surface
            ambient_temperature = 298.15 K
            emissivity = 0.9
        }
    }
}

study line_heat_loss {
    geometry = geometry.line
    mesh = mesh.line
    model = model.lagged_line
    analysis operating_point { conjugate_heat_transfer steady {} }
    output temperature = analysis.operating_point.field.node.temperature
    output velocity = analysis.operating_point.field.cell.fluid_velocity
    output pressure = analysis.operating_point.field.cell.fluid_pressure
    output jacket_surface_temperature = mean(output.temperature, over = geometry.line.region.jacket_surface)
    output peak_jacket_surface_temperature = max(output.temperature, over = geometry.line.region.jacket_surface)
    output peak_pipe_temperature = max(output.temperature, over = geometry.line.region.pipe)
    output oil_outlet_temperature = mean(output.temperature, over = geometry.line.region.outlet)
}
